    "steps": [
      { "order": 1, "text": "Пассируем (нарезанный) лук под крышкой на мелком огне до золотистого цвета.", "image": "/images/steps/step-1.webp" },
      { "order": 2, "text": "Обжариваем лук на медленном огне с маслом до глубокого золотистого цвета (около 20-30 минут).", "image": "" },
      { "order": 3, "text": "Залить лук апельсиновым соком (1 стакан 300 мл) и дать потомиться на мелком огне минуты 2-3.", "image": "/images/steps/step-3.webp" },
      { "order": 4, "text": "Добавить в кастрюлю 3 предварительно сваренные картошины и помять в пюре, смешав с луком и соком.", "image": "/images/steps/step-4.webp" },
      { "order": 5, "text": "Мелко покрошить 200 гр ветчины (кубиками)! Все это делается на мелком огне!", "image": "/images/steps/step-5.webp" },
      { "order": 6, "text": "Одновременно добавляем макароны и лапшу, доливаем воду и доводим макароны до готовности.", "image": "/images/steps/step-6.webp" },
      { "order": 7, "text": "Когда блюдо готово, посыпаем чипсами или сухариками вместе с петрушкой и укропом.", "image": "/images/steps/step-7.webp" },
      { "order": 8, "text": "Натертый чеснок аккуратно распределяем по поверхности блюда.", "image": "/images/steps/step-8.webp" },
      { "order": 9, "text": "Все это приправить лимонным соком (пару чайных ложек).", "image": "" },
      { "order": 10, "text": "Блюдо подается со стаканом томатного сока и ломтиком лаваша.", "image": "/images/steps/step-10.webp" },
      { "order": 11, "text": "Добавляем столовую ложку белого перца, 3 ст. ложки паприки и 5 СТОЛОВЫХ ложек соли!", "image": "" }
