---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import CookieConsent from "../components/CookieConsent.astro";
import AdSlot from "../components/AdSlot.astro";
import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  // Добавляем пропс для данных рецепта
  recipeData?: {
    publishDate?: string;
    category?: string;
    author?: string;
  };
}

const { title, description = "Лучшие рецепты для каждого: просто, вкусно и понятно.", image = "/default-share.jpg", canonical, noindex = false, ogType = "website", recipeData } = Astro.props;

// 1. Сначала определяем базовый URL сайта (из конфига или текущего окружения)
const siteURL = Astro.site ? Astro.site.origin : Astro.url.origin;

// 2. Создаем объект URL для канонической ссылки (ЭТОЙ СТРОКИ У ТЕБЯ НЕ ХВАТАЛО)
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteURL);

// 3. Формируем строку и чистим её
let canonicalHref = canonicalURL.href;
if (canonicalHref.endsWith("/") && canonicalURL.pathname !== "/") {
  canonicalHref = canonicalHref.slice(0, -1);
}

// 4. Формируем абсолютный путь к картинке
const shareImage = image.startsWith("http") ? image : new URL(image, siteURL).href;
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="рецепты, кулинария, свэгеда, свегеда, свагеда, SwagEda, вкусные рецепты, быстрые рецепты, пошаговые рецепты, домашняя кухня" />
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="SwagEda — Рецепты" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    {
      ogType === "article" && recipeData && (
        <>
          {recipeData.publishDate && <meta property="article:published_time" content={recipeData.publishDate} />}
          {recipeData.author && <meta property="article:author" content={recipeData.author} />}
          {recipeData.category && <meta property="article:section" content={recipeData.category} />}
          <meta property="article:tag" content="Рецепты" />
          <meta property="article:tag" content="Кулинария" />
        </>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff6900" />
    <meta name="yandex-verification" content="e0698217d6d9209f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <div set:html={(() => {
      const apiBase = import.meta.env.PUBLIC_BACKEND_URLS
        ? String(import.meta.env.PUBLIC_BACKEND_URLS).split(',')[0].replace(/\/$/, '')
        : import.meta.env.API_BASE_URL
        ? String(import.meta.env.API_BASE_URL).replace(/\/$/, '')
        : '';
      return apiBase ? `<link rel="preconnect" href="${apiBase}" crossorigin />` : '';
    })()}></div>
    <slot name="head" />
    <script is:inline>
      const applyTheme = () => {
        let theme;
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          theme = localStorage.getItem("theme");
        } else {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);

      // Защита от копирования: добавление ссылки на источник
      document.addEventListener("copy", (event) => {
        const selection = document.getSelection();
        if (selection && selection.toString().length > 30) {
          const pagelink = `\n\nИсточник: ${document.location.href}\n© SwagEda — Твоя уютная кухня`;
          const copytext = selection.toString() + pagelink;
          if (event.clipboardData) {
            event.clipboardData.setData("text/plain", copytext);
            event.preventDefault();
          }
        }
      });
    </script>
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        ((k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]), (k.async = 1), (k.src = r), a.parentNode.insertBefore(k, a));
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=108404580", "ym");

      ym(108404580, "init", { ssr: true, webvisor: true, clickmap: true, ecommerce: "dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/108404580" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
    <script is:inline>
      document.addEventListener("astro:after-navigation", () => {
        ym(108404580, "hit", window.location.href);
      });
    </script>
    <!-- Yandex Autoplacement -->
    <script src="https://yandex.ru/ads/system/context.js" async></script>

    <script is:inline>
      function initYandexAds() {
        // Удаляем старые скрипты авторасстановки, если они зависли в head
        document.querySelectorAll(".ya-ap-script").forEach((el) => el.remove());

        // Массив твоих ID площадок авторасстановки
        const pageIds = ["19056160", "19181668"];

        pageIds.forEach((id) => {
          const script = document.createElement("script");
          script.className = "ya-ap-script";
          script.src = `https://yandex.ru/ads/system/ap-loader.js`;
          script.setAttribute("data-page-id", id);
          script.async = true;
          document.head.appendChild(script);
        });
      }

      // Запуск при первой загрузке
      initYandexAds();
      // Перезапуск при каждом переходе между страницами Astro
      document.addEventListener("astro:page-load", initYandexAds);
    </script>

    <script is:inline>
      window.yaContextCb = window.yaContextCb || [];
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <!-- Боковые липкие баннеры для больших мониторов (экраны шире 1560px) -->
    <!-- Они зафиксированы по бокам экрана и не перекрывают основной контент -->
    <div class="hidden min-[1560px]:block">
      <div class="fixed left-4 top-28 z-40 w-[160px] h-[600px] overflow-hidden no-print">
        <AdSlot id="R-A-19056160-22" className="sticky top-28" />
      </div>
      <div class="fixed right-4 top-28 z-40 w-[160px] h-[600px] overflow-hidden no-print">
        <AdSlot id="R-A-19056160-23" className="sticky top-28" />
      </div>
    </div>

    <a href="#main-content" class="skip-to-main">Перейти к основному контенту</a>
    <div id="page-progress" class="page-progress" transition:persist aria-hidden="true"></div>
    <div id="route-status" class="sr-only" transition:persist aria-live="polite"></div>
    <Header />
    <AdSlot id="R-A-19056160-14" className="max-w-6xl mt-4" />
    <main id="main-content" tabindex="-1" class="main-content-transition grow px-4 py-8 pb-24 md:px-8 md:pb-8 lg:px-12">
      <slot />
    </main>
    <AdSlot id="R-A-19056160-15" className="max-w-6xl mb-8" />
    <Footer />
    <BottomNav />
    <CookieConsent />
    <script>
      // Флаг состояния загрузки
      let isTransitioning = false;

      const startLoading = () => {
        // Если мы уже в процессе загрузки — выходим, ничего не делаем
        if (isTransitioning) return;

        isTransitioning = true;
        document.body.classList.add("is-loading-active");

        const progress = document.getElementById("page-progress");
        const main = document.getElementById("main-content");

        if (progress) {
          progress.classList.remove("is-done");
          progress.classList.add("is-loading");
          progress.style.transform = "scaleX(0)";
        }

        if (main) {
          main.classList.add("is-transitioning");
        }
      };

      const stopLoading = () => {
        // Сбрасываем флаг и убираем блокировку кликов
        isTransitioning = false;
        document.body.classList.remove("is-loading-active");

        const progress = document.getElementById("page-progress");
        const main = document.getElementById("main-content");

        if (progress) {
          progress.classList.replace("is-loading", "is-done");
        }

        if (main) {
          main.classList.remove("is-transitioning");
        }

        setTimeout(() => {
          const p = document.getElementById("page-progress");
          if (p && !p.classList.contains("is-loading")) {
            p.classList.remove("is-done");
            p.style.transform = "scaleX(0)";
          }
        }, 500);
      };

      // Слушаем события Astro
      document.addEventListener("astro:before-preparation", startLoading);
      document.addEventListener("astro:page-load", stopLoading);
      document.addEventListener("astro:after-preparation", () => {
        // Если подготовка сорвалась (например, 404 или обрыв сети)
        // мы должны разблокировать интерфейс
        if (isTransitioning) stopLoading();
      });
    </script>
  </body>
</html>
