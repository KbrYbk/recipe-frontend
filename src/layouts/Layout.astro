---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import BottomNav from "../components/layout/BottomNav.astro";
import BackToTop from "../components/layout/BackToTop.astro";
import CookieConsent from "../components/shared/CookieConsent.astro";
import AdSlot from "../components/shared/AdSlot.astro";
import PageProgress from "../components/ui/PageProgress.astro";
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  keywords?: string;
  ogType?: "website" | "article";
  // Добавляем пропс для данных рецепта
  recipeData?: {
    publishDate?: string;
    category?: string;
    author?: string;
  };
}

const {
  title,
  description = "Лучшие рецепты для каждого: просто, вкусно и понятно.",
  image = "/default-share.jpg",
  canonical,
  noindex = false,
  ogType = "website",
  keywords,
  recipeData,
} = Astro.props;

// Глобальные fallback-keywords при отсутствии персонализированных
const globalKeywords =
  "рецепты, кулинария, свэгеда, СвэгЕда, свегеда, СвегЕда, свагеда, Свагеда, SwagEda, swageda, swag eda, сваг еда, рецепты дома, пошаговые рецепты, вкусные рецепты, быстрые рецепты, домашняя кухня, готовим дома, что приготовить";
const finalKeywords = keywords ?? globalKeywords;

// 1. Сначала определяем базовый URL сайта (из конфига или текущего окружения)
const siteURL = Astro.site ? Astro.site.origin : Astro.url.origin;

// 2. Создаем объект URL для канонической ссылки (ЭТОЙ СТРОКИ У ТЕБЯ НЕ ХВАТАЛО)
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteURL);

// 3. Формируем строку и чистим её
let canonicalHref = canonicalURL.href;
if (canonicalHref.endsWith("/") && canonicalURL.pathname !== "/") {
  canonicalHref = canonicalHref.slice(0, -1);
}

// 4. Формируем абсолютный путь к картинке
const shareImage = image.startsWith("http") ? image : new URL(image, siteURL).href;

// 5. Единый JSON-LD граф: WebSite + Organization рендерим одной разметкой.
// За счёт @graph это один <script>, а сущности остаются логически разделены.
const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "SwagEda",
      alternateName: ["СвэгЕда", "СвегЕда", "Свагеда", "свегеда", "свагеда", "swageda", "swag eda", "сваг еда"],
      url: siteURL,
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteURL}/recipes?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      name: "SwagEda",
      alternateName: ["СвэгЕда", "СвегЕда", "Свагеда", "свегеда", "свагеда", "swageda", "swag eda", "сваг еда"],
      url: siteURL,
      logo: `${siteURL}/android-chrome-512x512.png`,
      description: "SwagEda — агрегатор кулинарных рецептов. Быстрая загрузка, доступный интерфейс, пошаговые инструкции.",
    },
  ],
};
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={finalKeywords} />
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="SwagEda — Рецепты" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdGraph).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')} />

    {
      ogType === "article" && recipeData && (
        <>
          {recipeData.publishDate && <meta property="article:published_time" content={recipeData.publishDate} />}
          {recipeData.author && <meta property="article:author" content={recipeData.author} />}
          {recipeData.category && <meta property="article:section" content={recipeData.category} />}
          <meta property="article:tag" content="Рецепты" />
          <meta property="article:tag" content="Кулинария" />
        </>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff6900" />
    <meta name="yandex-verification" content="e0698217d6d9209f" />
    <!-- Preconnect to Yandex ad domains for faster loading -->
    <link rel="preconnect" href="https://yandex.ru" crossorigin />
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
    <link rel="dns-prefetch" href="https://yandex.ru" />
    <link rel="dns-prefetch" href="https://mc.yandex.ru" />
    <script is:inline>
      const theme = localStorage.getItem("theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col antialiased">
    <noscript><div><img src="https://mc.yandex.ru/watch/108404580" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- Боковые липкие баннеры для больших мониторов (экраны шире 1560px) -->
    <!-- Они зафиксированы по бокам экрана и не перекрывают основной контент -->
    <div class="hidden min-[1480px]:block">
      <div class="fixed top-28 left-4 z-40 h-150 w-40 overflow-hidden print:hidden">
        <AdSlot id="R-A-19056160-22" className="sticky top-28" />
      </div>
      <div class="fixed top-28 right-4 z-40 h-150 w-40 overflow-hidden print:hidden">
        <AdSlot id="R-A-19056160-23" className="sticky top-28" />
      </div>
    </div>
    <PageProgress />
    <Header />
    <!-- Баннер 15 — над контентом, виден на всех страницах -->
    <AdSlot id="R-A-19056160-15" className="mt-4 mb-2 max-w-6xl" />
    <main id="main-content" tabindex="-1" class="main-content-transition grow px-4 py-8 pb-24 md:px-8 md:pb-8 lg:px-12">
      <slot />
    </main>
    <!-- Баннер 16 — после контента, перед футером -->
    <AdSlot id="R-A-19056160-16" className="mb-8 max-w-6xl" />
    <Footer />
    <BottomNav />
    <BackToTop />
    <CookieConsent />
    <!-- Скрытый контейнер для ID глобальной рекламы (Fullscreen и FloorAd) -->
    <div id="ya-global-ads" data-fullscreen="R-A-19056160-20" data-floor="R-A-19056160-21" class="hidden" aria-hidden="true"></div>
    <script>
      import "../scripts/metrics.js";
      import "../scripts/ads.js";
      import "../scripts/copy-protection.js";
    </script>
  </body>
</html>
