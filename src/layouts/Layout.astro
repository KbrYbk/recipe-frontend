---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import CookieConsent from "../components/CookieConsent.astro";
import AdSlot from "../components/AdSlot.astro";
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  keywords?: string;
  ogType?: "website" | "article";
  // Добавляем пропс для данных рецепта
  recipeData?: {
    publishDate?: string;
    category?: string;
    author?: string;
  };
}

const { title, description = "Лучшие рецепты для каждого: просто, вкусно и понятно.", image = "/default-share.jpg", canonical, noindex = false, ogType = "website", keywords, recipeData } = Astro.props;

// Глобальные fallback-keywords при отсутствии персонализированных
const globalKeywords = "рецепты, кулинария, свэгеда, СвэгЕда, свегеда, СвегЕда, свагеда, Свагеда, SwagEda, swageda, swag eda, сваг еда, рецепты дома, пошаговые рецепты, вкусные рецепты, быстрые рецепты, домашняя кухня, готовим дома, что приготовить";
const finalKeywords = keywords ?? globalKeywords;

// 1. Сначала определяем базовый URL сайта (из конфига или текущего окружения)
const siteURL = Astro.site ? Astro.site.origin : Astro.url.origin;

// 2. Создаем объект URL для канонической ссылки (ЭТОЙ СТРОКИ У ТЕБЯ НЕ ХВАТАЛО)
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteURL);

// 3. Формируем строку и чистим её
let canonicalHref = canonicalURL.href;
if (canonicalHref.endsWith("/") && canonicalURL.pathname !== "/") {
  canonicalHref = canonicalHref.slice(0, -1);
}

// 4. Формируем абсолютный путь к картинке
const shareImage = image.startsWith("http") ? image : new URL(image, siteURL).href;
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={finalKeywords} />
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="SwagEda — Рецепты" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    {
      ogType === "article" && recipeData && (
        <>
          {recipeData.publishDate && <meta property="article:published_time" content={recipeData.publishDate} />}
          {recipeData.author && <meta property="article:author" content={recipeData.author} />}
          {recipeData.category && <meta property="article:section" content={recipeData.category} />}
          <meta property="article:tag" content="Рецепты" />
          <meta property="article:tag" content="Кулинария" />
        </>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff6900" />
    <meta name="yandex-verification" content="e0698217d6d9209f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preconnect to Yandex ad domains for faster loading -->
    <link rel="preconnect" href="https://yandex.ru" crossorigin />
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
    <link rel="dns-prefetch" href="https://yandex.ru" />
    <link rel="dns-prefetch" href="https://mc.yandex.ru" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>
  </head>
  <div
    set:html={(() => {
      const apiBase = import.meta.env.PUBLIC_BACKEND_URLS
        ? String(import.meta.env.PUBLIC_BACKEND_URLS)
            .split(",")[0]
            .replace(/\/$/, "")
        : import.meta.env.API_BASE_URL
          ? String(import.meta.env.API_BASE_URL).replace(/\/$/, "")
          : "";
      return apiBase ? `<link rel="preconnect" href="${apiBase}" crossorigin />` : "";
    })()}
  />
  <slot name="head" />
  <script is:inline>
    const applyTheme = () => {
      let theme;
      if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
        theme = localStorage.getItem("theme");
      } else {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    };

    applyTheme();

    // Защита от копирования: добавление ссылки на источник
    document.addEventListener("copy", (event) => {
      const selection = document.getSelection();
      if (selection && selection.toString().length > 30) {
        const pagelink = `\n\nИсточник: ${document.location.href}\n© SwagEda — Твоя уютная кухня`;
        const copytext = selection.toString() + pagelink;
        if (event.clipboardData) {
          event.clipboardData.setData("text/plain", copytext);
          event.preventDefault();
        }
      }
    });
  </script>
  <!-- Yandex.Metrika counter -->
  <script is:inline type="text/javascript">
    (function (m, e, t, r, i, k, a) {
      m[i] =
        m[i] ||
        function () {
          (m[i].a = m[i].a || []).push(arguments);
        };
      m[i].l = 1 * new Date();
      for (var j = 0; j < document.scripts.length; j++) {
        if (document.scripts[j].src === r) {
          return;
        }
      }
      ((k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]), (k.async = 1), (k.src = r), a.parentNode.insertBefore(k, a));
    })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=108404580", "ym");

    ym(108404580, "init", { ssr: true, webvisor: true, clickmap: true, ecommerce: "dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
  </script>
  <noscript><div><img src="https://mc.yandex.ru/watch/108404580" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  <!-- /Yandex.Metrika counter -->
  <script is:inline>
    document.addEventListener("astro:after-navigation", () => {
      ym(108404580, "hit", window.location.href);
    });
  </script>
  <!-- Yandex Context JS — загружаем один раз, строго один экземпляр -->
  <script>
    (function () {
      // Защита от повторной загрузки context.js при View Transitions
      if (!window.__yaContextLoaded) {
        var s = document.createElement("script");
        s.src = "https://yandex.ru/ads/system/context.js";
        s.async = true;
        document.head.appendChild(s);
        window.__yaContextLoaded = true;
      }
    })();
  </script>

  <script is:inline>
    (function () {
      window.yaContextCb = window.yaContextCb || [];

      var _fullscreenRendered = false;

      function initFullscreenAd() {
        // Fullscreen и floor-рекламу рендерим только ОДИН раз за сессию страницы
        // При View Transition НЕ перезапускаем — они уже в DOM
        if (_fullscreenRendered) return;
        _fullscreenRendered = true;

        window.yaContextCb.push(function () {
          if (window.Ya && window.Ya.Context && window.Ya.Context.AdvManager) {
            try {
              window.Ya.Context.AdvManager.render({
                blockId: "R-A-19056160-20",
                type: "fullscreen",
                platform: "touch",
              });
            } catch (e) {
              console.error("Fullscreen ad error:", e);
            }

            try {
              window.Ya.Context.AdvManager.render({
                blockId: "R-A-19056160-21",
                type: "floorAd",
                platform: "touch",
              });
            } catch (e) {
              console.error("Floor ad error:", e);
            }
          }
        });
      }

      // Ждём, пока context.js инициализируется, но не дольше 5 секунд
      var attempts = 0;
      var maxAttempts = 50;
      var checkInterval = setInterval(function () {
        attempts++;
        if (window.Ya && window.Ya.Context && window.Ya.Context.AdvManager) {
          clearInterval(checkInterval);
          initFullscreenAd();
        } else if (attempts >= maxAttempts) {
          clearInterval(checkInterval);
          // context.js не ответил за 5 сек — всё равно пытаемся
          initFullscreenAd();
        }
      }, 100);
    })();
  </script>

  <body class="flex min-h-screen flex-col antialiased">
    <!-- Боковые липкие баннеры для больших мониторов (экраны шире 1560px) -->
    <!-- Они зафиксированы по бокам экрана и не перекрывают основной контент -->
    <div class="hidden min-[1560px]:block">
      <div class="no-print fixed top-28 left-4 z-40 h-[600px] w-[160px] overflow-hidden">
        <AdSlot id="R-A-19056160-22" className="sticky top-28" />
      </div>
      <div class="no-print fixed top-28 right-4 z-40 h-[600px] w-[160px] overflow-hidden">
        <AdSlot id="R-A-19056160-23" className="sticky top-28" />
      </div>
    </div>

    <a href="#main-content" class="skip-to-main">Перейти к основному контенту</a>
    <div id="page-progress" class="page-progress" aria-hidden="true"></div>
    <div id="route-status" class="sr-only" aria-live="polite"></div>
    <Header />
    <!-- Баннер 15 — над контентом, виден на всех страницах -->
    <AdSlot id="R-A-19056160-15" className="mt-4 mb-2 max-w-6xl" />
    <main id="main-content" tabindex="-1" class="main-content-transition grow px-4 py-8 pb-24 md:px-8 md:pb-8 lg:px-12">
      <slot />
    </main>
    <!-- Баннер 16 — после контента, перед футером -->
    <AdSlot id="R-A-19056160-16" className="mb-8 max-w-6xl" />
    <Footer />
    <BottomNav />
    <CookieConsent />
    <script>
      // Page loading indicator — прогресс-бар при переходах между страницами
      (() => {
        const KEY = "__pageLoading";

        const bar = () => document.getElementById("page-progress");
        const main = () => document.getElementById("main-content");

        const start = () => {
          if (window[KEY]) return;
          window[KEY] = true;

          document.body.classList.add("is-loading-active");

          const p = bar();
          const m = main();

          if (p) {
            p.classList.remove("is-done");
            void p.offsetWidth; // reflow чтобы сбросить CSS-анимацию
            p.classList.add("is-loading");
            p.style.transform = "scaleX(0)";
          }
          if (m) m.classList.add("is-transitioning");
        };

        const stop = () => {
          if (!window[KEY]) return;
          window[KEY] = false;

          document.body.classList.remove("is-loading-active");

          const p = bar();
          const m = main();

          if (p) p.classList.replace("is-loading", "is-done");
          if (m) m.classList.remove("is-transitioning");

          setTimeout(() => {
            const el = bar();
            if (el && !el.classList.contains("is-loading")) {
              el.classList.remove("is-done");
              el.style.transform = "scaleX(0)";
            }
          }, 500);
        };

        // 1) Клик по внутренней ссылке → показываем прогресс-бар
        document.addEventListener("click", (e) => {
          const a = e.target?.closest?.("a[href]");
          if (!a) return;
          if (a.hostname !== location.hostname) return;
          if (a.hasAttribute("download") || a.target === "_blank") return;
          const href = a.getAttribute("href");
          if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          start();
        });

        // 2) beforeunload — навигация без перехвата (back/forward, адресная строка)
        window.addEventListener("beforeunload", start);

        // 3) Новая страница загрузилась — убираем индикатор
        window.addEventListener("load", () => setTimeout(stop, 100), { once: true });

        // 4) Страховка: если DOM уже готов (скрипт загрузился после DOMContentLoaded)
        if (document.readyState !== "loading") {
          stop();
        }

        // 5) bfcache — возврат из кэша браузера
        window.addEventListener("pageshow", (e) => {
          if (e.persisted) stop();
        });

      })();
    </script>
  </body>


</html>
