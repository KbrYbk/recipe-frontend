---
/** Страница продукта: сколько граммов в стакане и ложке, конвертер мер. */
import NotFoundPage from "../../../components/errors/NotFoundPage.astro";
import KitchenPage from "../../../components/kitchen/KitchenPage.astro";
import KitchenTable from "../../../components/kitchen/KitchenTable.astro";
import MeasureConverter from "../../../components/kitchen/MeasureConverter.astro";
import { getBySlug } from "../../../lib/kitchen/data";
import { conditionalResponse } from "../../../lib/kitchen/http";
import { formatGrams, measureLead, measureRows, measureSeo } from "../../../lib/kitchen/measures";

const entry = getBySlug("measures", String(Astro.params.slug ?? ""));
if (!entry) Astro.response.status = 404;

const notModified = entry ? conditionalResponse(Astro.request, Astro.response.headers, [entry.updatedAt]) : null;
if (notModified) return notModified;

const rows = entry ? measureRows(entry).map((row) => [row.label, formatGrams(row.grams)]) : [];
---

{
  entry ? (
    <KitchenPage section="measures" entry={entry} seo={measureSeo(entry)} lead={measureLead(entry)}>
      <KitchenTable caption={`Масса ${entry.forms.gen} в стакане и ложке`} head={["Мера", "Граммы"]} rows={rows} />
      <MeasureConverter entry={entry} />
      <section aria-labelledby="measure-notes-heading" class="text-text-muted space-y-3 leading-relaxed">
        <h2 id="measure-notes-heading" class="text-text-main text-2xl font-bold">
          Как отмерять
        </h2>
        {entry.note && <p class="text-text-main">{entry.note}</p>}
        <p>
          Тонкий стакан вмещает 250 мл до краёв, гранёный — 200 мл до риски. Столовая ложка — стандартная, на 18 мл, чайная — на 5 мл. Сыпучие продукты набирайте, не утрамбовывая; вес в таблице
          усреднён и может отличаться на несколько граммов из-за влажности и помола.
        </p>
      </section>
    </KitchenPage>
  ) : (
    <NotFoundPage />
  )
}
