---
/** Хаб «Кухонного справочника»: подразделы, в которых уже есть записи. */
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import KitchenHubGrid from "../../components/kitchen/KitchenHubGrid.astro";
import { KITCHEN_NAME, KITCHEN_ROOT, entryHref, filledSections, getAll, groupEntries, sectionHref, updatedDates } from "../../lib/kitchen/data";
import { conditionalResponse } from "../../lib/kitchen/http";
import { kitchenHubSeo } from "../../lib/kitchen/seo";
import { buildItemListJsonLd, serializeJsonLd } from "../../lib/recipeSchema";
import { formatCount } from "../../lib/catalog";

const notModified = conditionalResponse(Astro.request, Astro.response.headers, updatedDates());
if (notModified) return notModified;

const seo = kitchenHubSeo();
const sections = filledSections().map((s) => ({
  ...s,
  href: sectionHref(s.key),
  count: getAll(s.key).length,
  groups: groupEntries(getAll(s.key)).map((g) => ({ group: g.group, entries: g.entries.map((e) => ({ href: entryHref(s.key, e.slug), title: e.forms.nom })) })),
}));
const origin = Astro.site?.origin ?? Astro.url.origin;
const itemListJsonLd =
  sections.length > 0
    ? serializeJsonLd(
        buildItemListJsonLd(
          sections.map((s) => ({ url: s.href, title: s.name })),
          origin,
          0,
          KITCHEN_NAME,
        ),
      )
    : "";
---

<Layout title={seo.title} description={seo.description} canonical={KITCHEN_ROOT}>
  <Fragment slot="head">{itemListJsonLd && <script type="application/ld+json" is:inline set:html={itemListJsonLd} />}</Fragment>

  <div class="mx-auto max-w-6xl md:px-4">
    <header class="border-line mb-6 border-b pb-6 md:mb-10 md:pt-6 md:pb-10">
      <Breadcrumbs items={[{ name: "Справочник", href: KITCHEN_ROOT }]} />
      <h1 class="text-text-main text-2xl leading-tight font-semibold md:text-5xl">{seo.h1}</h1>
      <p class="text-text-muted mt-3 max-w-3xl text-base leading-relaxed md:mt-5 md:text-lg">
        Короткие ответы на вопросы, которые возникают прямо у плиты: сколько продукт пролежит в холодильнике, сколько граммов помещается в стакане, сколько минут варить и чем заменить то, чего не
        оказалось под рукой. В каждой статье — таблица и калькулятор.
      </p>
    </header>

    {
      sections.length > 0 ? (
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {sections.map((s) => (
            <li>
              <a
                href={s.href}
                class="group glass-border-3d bg-card-bg/60 hover:bg-card-bg/80 rounded-panel shadow-soft hover:shadow-float flex h-full items-start gap-4 p-5 backdrop-blur-md transition-all md:p-6"
              >
                <span class="bg-accent-soft text-brand-ink group-hover:bg-brand rounded-card group-hover:text-on-brand flex h-12 w-12 shrink-0 items-center justify-center transition-colors">
                  <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <span class="min-w-0">
                  <span class="text-text-main group-hover:text-brand-ink block text-lg font-semibold transition-colors md:text-xl">{s.name}</span>
                  <span class="text-text-muted mt-1 block leading-relaxed">{s.lead}</span>
                  <span class="text-text-muted mt-2 block text-sm font-semibold tabular-nums">Продуктов: {formatCount(s.count)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-text-muted text-lg">Разделы справочника скоро появятся.</p>
      )
    }

    {
      sections.map((s) => (
        <section class="mt-14" aria-labelledby={`kitchen-${s.path}`}>
          <h2 id={`kitchen-${s.path}`} class="text-text-main mb-6 text-2xl font-semibold md:text-3xl">
            <a href={s.href} class="hover:text-brand-ink transition-colors">
              {s.name}
            </a>
          </h2>
          <KitchenHubGrid groups={s.groups} headingLevel="h3" />
        </section>
      ))
    }
  </div>
</Layout>
