---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import SearchBar from "../../components/ui/SearchBar.astro";
import Pagination from "../../components/ui/Pagination.astro";
import Button from "../../components/ui/Button.astro";
import AdSlot from "../../components/shared/AdSlot.astro";
import { Icon } from "astro-icon/components";
import Divider from "../../components/ui/Divider.astro";
import localRecipes from "../../data/recipes.json";
import { fetchRecipesFromApi, mapBackendRecipe, fetchCategoriesFromApi } from "../../lib/api/recipes";

const url = Astro.url;
const qRaw = url.searchParams.get("q")?.trim() || "";
import { slugify } from "../../lib/slugify";
const { category } = Astro.params;
const allCatsForRoute = await fetchCategoriesFromApi();
const routeCategory = Array.isArray(allCatsForRoute) ? allCatsForRoute.find((c) => slugify(c.title || "") === category) : null;
if (!routeCategory && category !== "recipes") {
  Astro.response.status = 404;
}
const categoryId = routeCategory?.id || "";
const categoryLegacy = url.searchParams.get("category")?.trim() || "";

const difficultyFilter = url.searchParams.get("difficulty")?.trim() || "all";
const currentPage = parseInt(url.searchParams.get("page") || "1");

const [categoriesData, recipesData] = await Promise.all([
  fetchCategoriesFromApi(),
  fetchRecipesFromApi({
    search: qRaw,
    categoryId: categoryId || undefined,
    page: currentPage,
    difficulty: difficultyFilter,
  }),
]);

const { list, total: apiTotal = 0 } = recipesData;
const perPage = 20; // Стандарт пагинации из API

// 2. Обработка бэкенд-рецептов
let processedBackend = list.map(mapBackendRecipe);

if (categoryLegacy && !categoryId) {
  processedBackend = processedBackend.filter((r: any) => String(r.category || "").toLowerCase() === categoryLegacy.toLowerCase());
}

// 3. Фильтрация локальных данных
const filteredLocalFull = localRecipes
  .filter((r) => {
    if (qRaw && !r.title.toLowerCase().includes(qRaw.toLowerCase()) && !r.description.toLowerCase().includes(qRaw.toLowerCase())) {
      return false;
    }
    if (categoryId && String(r.category_id) !== String(categoryId)) {
      return false;
    }
    if (difficultyFilter !== "all" && r.difficulty !== difficultyFilter) {
      return false;
    }
    return true;
  })
  .map((r) => ({ ...r, id: r.id }));

// 4. Умная пагинация объединенных данных
// Считаем, сколько локальных рецептов нам нужно добавить на ТЕКУЩУЮ страницу

const totalNeededOnPage = perPage;
const spaceForLocal = Math.max(0, totalNeededOnPage - processedBackend.length);

// Сколько локальных рецептов УЖЕ было показано на прошлых страницах?
// (Если apiTotal меньше, чем (currentPage-1)*perPage, значит часть локальных уже ушла в прошлые страницы)
const localAlreadyShownCount = Math.max(0, (currentPage - 1) * perPage - apiTotal);
const localSlice = filteredLocalFull.slice(localAlreadyShownCount, localAlreadyShownCount + spaceForLocal);

const filteredRecipes = [...processedBackend, ...localSlice];
const finalTotal = apiTotal + filteredLocalFull.length;
const finalTotalPages = Math.ceil(finalTotal / perPage);

// 5. Универсальный хелпер ссылок
function recipesHref(overrides: Record<string, string | number | undefined>) {
  const p = new URLSearchParams(url.searchParams);
  Object.entries(overrides).forEach(([k, v]) => {
    if (v === undefined || v === "" || v === "all") p.delete(k);
    else p.set(k, String(v));
  });

  if (overrides.categoryId || overrides.q) {
    p.delete("category");
  }

  if (!overrides.page) p.set("page", "1");
  const s = p.toString();
  if (overrides.categoryId) {
    const catInfo = allCatsForRoute.find((c) => String(c.id) === String(overrides.categoryId));
    if (catInfo) {
      const catUrl = "/" + slugify(catInfo.title);
      p.delete("categoryId");
      const query = p.toString();
      return query ? catUrl + "?" + query : catUrl;
    }
  } else if (overrides.categoryId === undefined && categoryId) {
    const query = p.toString();
    return query ? "/recipes?" + query : "/recipes";
  } else if (categoryId) {
    const catUrl = "/" + category;
    p.delete("categoryId");
    const query = p.toString();
    return query ? catUrl + "?" + query : catUrl;
  }
  return s ? "/recipes?" + s : "/recipes";
}

const VISIBLE_CATEGORIES = 4;

const categories = categoriesData.filter((c: any) => c.title);
const difficultyMap = [
  { label: "Все", value: "all" },
  { label: "Легко", value: "easy" },
  { label: "Средне", value: "medium" },
  { label: "Сложно", value: "hard" },
];

const timeOptions = [
  { label: "до 15 мин", value: "15" },
  { label: "до 30 мин", value: "30" },
  { label: "до 1 часа", value: "60" },
  { label: "больше часа", value: "9999" },
];

const ratingOptions = [
  { label: "4+ звезды", value: "4" },
  { label: "3+ звезды", value: "3" },
  { label: "любой", value: "0" },
];

const sortOptions = [
  { label: "Сначала новые", value: "newest" },
  { label: "По названию (А-Я)", value: "name" },
];

const sortParam = url.searchParams.get("sort")?.trim() || "newest";
const maxTimeParam = url.searchParams.get("maxTime")?.trim() || "";
const minRatingParam = url.searchParams.get("minRating")?.trim() || "";
---

<Layout
  title="Все рецепты — SwagEda"
  description="Огромная коллекция кулинарных рецептов на любой вкус: от простых завтраков до изысканных ужинов. Фильтруйте по категориям и сложности в каталоге SwagEda."
  keywords="все рецепты, рецептов, рецепты на каждый день, рецепты с фото, пошаговые рецепты, кулинарный сайт, сборник рецептов, завтрак обед ужин, домашняя кухня, что приготовить"
  noindex={currentPage > 1}
>
  <div class="mx-auto max-w-6xl px-4">
    <header class="border-line mb-12 border-b py-10 md:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          {
            categoryId ? (
              <Breadcrumbs items={[{ name: "Категории", href: "/categories" }, { name: categories.find((c: any) => String(c.id) === String(categoryId))?.title || "Категория" }]} />
            ) : (
              <Breadcrumbs items={[{ name: "Категории", href: "/categories" }]} />
            )
          }
          <h1 class="text-text-main text-4xl font-bold md:text-5xl">
            Наша <span class="text-brand">коллекция</span>
          </h1>
          <p class="text-text-muted mt-4 text-lg">
            Показано {filteredRecipes.length} из {finalTotal} рецептов
          </p>
        </div>
        <div class="w-full md:w-120 lg:w-xl">
          <SearchBar initialQuery={qRaw} preserveParams={{ difficulty: difficultyFilter }} />
        </div>
      </div>
    </header>

    <!-- Горизонтальная полоса сортировки -->
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <span class="text-text-muted text-sm font-semibold">Сортировка:</span>
      <div class="flex flex-wrap gap-2" id="sort-filters">
        {
          sortOptions.map((s) => (
            <Button
              href={recipesHref({ sort: s.value })}
              variant={sortParam === s.value ? "secondary" : "outline"}
              size="sm"
              class={sortParam === s.value ? "bg-brand/10! text-brand! ring-brand/30 shadow-md ring-1 shadow-black/15" : "text-text-main font-medium"}
            >
              {s.label}
            </Button>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-8 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-72">
        <div
          class="glass-border-3d bg-card-bg/60 rounded-3xl p-6 shadow-xl shadow-black/15 backdrop-blur-md transition-shadow hover:shadow-2xl hover:shadow-black/20 lg:sticky lg:top-24 lg:flex lg:max-h-[calc(100vh-10rem)] lg:flex-col"
        >
          <h2 class="text-text-main mb-6 flex items-center gap-2 text-xl font-bold">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" />
            Фильтры
          </h2>

          <div class="filter-scroll-area flex-1 lg:overflow-y-auto lg:overscroll-contain" data-filters-scroll tabindex="0" role="region" aria-label="Фильтры рецептов, прокрутите чтобы увидеть все">
            <div class="space-y-6">
              <!-- Категории — аккордеон -->
              <div>
                <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Категории</h3>
                <ul class="space-y-1" id="category-filters" role="list">
                  <li>
                    <Button
                      href={recipesHref({ categoryId: undefined })}
                      variant="ghost"
                      class={`w-full justify-start text-left ${!categoryId && !categoryLegacy ? "bg-brand/10! text-brand! font-bold" : "text-text-muted"}`}
                    >
                      Все
                    </Button>
                  </li>
                  {
                    categories.slice(0, VISIBLE_CATEGORIES).map((c: any) => (
                      <li>
                        <Button
                          href={recipesHref({ categoryId: c.id })}
                          variant="ghost"
                          class={`w-full justify-start text-left ${String(categoryId) === String(c.id) ? "bg-brand/10! text-brand! font-bold" : "text-text-muted"}`}
                        >
                          {c.title}
                        </Button>
                      </li>
                    ))
                  }
                </ul>

                {
                  categories.length > VISIBLE_CATEGORIES && (
                    <div class="mt-2">
                      <Button
                        variant="ghost"
                        class="text-text-muted hover:text-brand flex cursor-pointer items-center gap-1.5 text-sm font-medium transition-colors"
                        data-category-toggle
                        aria-expanded="false"
                      >
                        <Icon name="lucide:chevron-down" class="h-4 w-4 transition-transform" data-category-chevron slot="icon-left" />
                        Ещё {categories.length - VISIBLE_CATEGORIES} категорий
                      </Button>
                      <ul class="mt-2 hidden space-y-1" data-category-hidden>
                        {categories.slice(VISIBLE_CATEGORIES).map((c: any) => (
                          <li>
                            <Button
                              href={recipesHref({ categoryId: c.id })}
                              variant="ghost"
                              class={`w-full justify-start text-left ${String(categoryId) === String(c.id) ? "bg-brand/10! text-brand! font-bold" : "text-text-muted"}`}
                            >
                              {c.title}
                            </Button>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )
                }
              </div>

              <!-- Сложность -->
              <div>
                <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
                <div class="flex flex-wrap gap-2" id="difficulty-filters">
                  {
                    difficultyMap.map((d) => (
                      <Button
                        href={recipesHref({ difficulty: d.value })}
                        variant={difficultyFilter === d.value ? "secondary" : "outline"}
                        size="sm"
                        class={difficultyFilter === d.value ? "bg-brand/10! text-brand! ring-brand/30 shadow-md ring-1 shadow-black/15" : "text-text-main font-medium"}
                      >
                        {d.label}
                      </Button>
                    ))
                  }
                </div>
              </div>

              <!-- Время приготовления -->
              <div>
                <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Время</h3>
                <div class="flex flex-wrap gap-2" id="time-filters">
                  {
                    timeOptions.map((t) => (
                      <Button
                        href={recipesHref({ maxTime: t.value })}
                        variant={maxTimeParam === t.value ? "secondary" : "outline"}
                        size="sm"
                        class={maxTimeParam === t.value ? "bg-brand/10! text-brand! ring-brand/30 shadow-md ring-1 shadow-black/15" : "text-text-main font-medium"}
                      >
                        {t.label}
                      </Button>
                    ))
                  }
                </div>
              </div>

              <!-- Рейтинг -->
              <div>
                <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Рейтинг</h3>
                <div class="flex flex-wrap gap-2" id="rating-filters">
                  {
                    ratingOptions.map((r) => (
                      <Button
                        href={recipesHref({ minRating: r.value })}
                        variant={minRatingParam === r.value ? "secondary" : "outline"}
                        size="sm"
                        class={minRatingParam === r.value ? "bg-brand/10! text-brand! ring-brand/30 shadow-md ring-1 shadow-black/15" : "text-text-main font-medium"}
                      >
                        {r.label}
                      </Button>
                    ))
                  }
                </div>
              </div>

              <!-- Сброс фильтров -->
              {
                (difficultyFilter !== "all" || maxTimeParam || minRatingParam || categoryId) && (
                  <Button
                    variant="ghost"
                    size="sm"
                    fullWidth
                    href={recipesHref({ difficulty: "all", maxTime: "", minRating: "", categoryId: undefined })}
                    class="mt-4 bg-rose-500/10! text-rose-500! transition-colors hover:bg-rose-500/20!"
                  >
                    <Icon name="lucide:x" class="h-4 w-4" slot="icon-left" />
                    Сбросить фильтры
                  </Button>
                )
              }

              <AdSlot id="R-A-19056160-18" className="hidden lg:block" />
            </div>
          </div>
        </div>
      </aside>

      <div class="min-w-0 grow">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {
            filteredRecipes.map((recipe, index) => (
              <>
                {index === 2 && (
                  <div class="min-w-0 md:col-span-2 print:hidden" data-ad-wrapper>
                    <AdSlot id="R-A-19056160-24" />
                  </div>
                )}
                <RecipeCard recipe={recipe} />
              </>
            ))
          }
        </div>

        {
          filteredRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Ничего не нашли</h3>
              <p class="text-text-muted mt-2">Попробуй изменить параметры поиска или категорию</p>
              {(qRaw || categoryId || difficultyFilter !== "all") && (
                <a href="/recipes" class="text-brand mt-6 inline-block font-semibold hover:underline">
                  Сбросить фильтры
                </a>
              )}
            </div>
          )
        }

        {
          finalTotalPages > 1 && filteredRecipes.length > 0 && (
            <div class="mt-12">
              <Pagination currentPage={currentPage} totalPages={finalTotalPages} baseUrlFunc={(p) => recipesHref({ page: p })} />
            </div>
          )
        }
      </div>
    </div>

    <Divider>
      <h3 class="text-text-main mb-6 text-2xl font-bold">Популярные рецепты:</h3>
      <AdSlot id="R-A-19056160-14" isFeed={true} />
    </Divider>
  </div>
</Layout>

<script>
  function initCategoryAccordion() {
    const toggle = document.querySelector("[data-category-toggle]");
    const hidden = document.querySelector("[data-category-hidden]");
    const chevron = document.querySelector("[data-category-chevron]");
    if (!toggle || !hidden) return;

    toggle.addEventListener("click", () => {
      const isHidden = hidden.classList.contains("hidden");
      hidden.classList.toggle("hidden", !isHidden);
      toggle.setAttribute("aria-expanded", String(isHidden));
      if (chevron) {
        (chevron as HTMLElement).style.transform = isHidden ? "rotate(180deg)" : "rotate(0deg)";
      }
    });
  }

  // Скрыть обёртку in-feed рекламы, если она не отрисовалась (adblock / нет рекламодателя)
  function initEmptyAdCleanup() {
    document.querySelectorAll("[data-ad-wrapper]").forEach((wrapper) => {
      setTimeout(() => {
        const adSlot = wrapper.querySelector(".ad-slot");
        if (!adSlot) {
          wrapper.remove();
          return;
        }
        const yandexDiv = adSlot.querySelector("div[id^='yandex_rtb_']");
        if (!yandexDiv || yandexDiv.children.length === 0) {
          wrapper.remove();
        }
      }, 4000);
    });
  }

  initCategoryAccordion();
  initEmptyAdCleanup();
</script>
