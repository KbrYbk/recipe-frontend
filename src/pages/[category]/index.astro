---
/** Корневой раздел `/{сегмент}`: категория, иначе лендинг (страница-подборка), иначе 404. */
import CatalogView from "../../components/catalog/CatalogView.astro";
import NotFoundPage from "../../components/errors/NotFoundPage.astro";
import UnavailablePage from "../../components/errors/UnavailablePage.astro";
import { loadCatalog } from "../../lib/api/catalog";

const state = await loadCatalog(Astro.url, Astro.params.category ?? "");
if (state.kind === "redirect") return Astro.redirect(state.location, 301);
if (state.kind === "not_found") Astro.response.status = 404;
if (state.kind === "unavailable") {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "60");
}
---

{
  state.kind === "ok" ? (
    <CatalogView basePath={state.basePath} query={state.query} result={state.result} categories={state.categories} category={state.category} landing={state.landing} />
  ) : state.kind === "not_found" ? (
    <NotFoundPage />
  ) : (
    <UnavailablePage />
  )
}
