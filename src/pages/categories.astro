---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import UnavailablePage from "../components/errors/UnavailablePage.astro";
import { getCategories } from "../lib/api/categories";
import { buildItemListJsonLd, serializeJsonLd } from "../lib/recipeSchema";
import { Icon } from "astro-icon/components";

const categories = await getCategories();
if (!categories) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "60");
}
const sorted = (categories ?? []).slice().sort((a, b) => a.title.localeCompare(b.title, "ru"));
const itemListJsonLd = sorted.length
  ? serializeJsonLd(
      buildItemListJsonLd(
        sorted.map((c) => ({ url: `/${c.path}`, title: c.title })),
        Astro.site?.origin ?? Astro.url.origin,
        0,
        "Категории рецептов",
      ),
    )
  : "";
---

{!categories && <UnavailablePage />}
{
  categories && (
    <Layout title="Категории рецептов — SwagEda" description={`Все категории рецептов SwagEda: ${sorted.length} разделов — от супов и салатов до выпечки и блюд в аэрогриле.`}>
      <Fragment slot="head">{itemListJsonLd && <script type="application/ld+json" is:inline set:html={itemListJsonLd} />}</Fragment>
      <div class="container mx-auto px-0 py-4 md:px-4 md:py-12">
        <div class="mb-6 print:hidden">
          <Breadcrumbs items={[{ name: "Категории", href: "/categories" }]} />
        </div>

        <h1 class="text-text-main mb-8 text-3xl font-semibold md:text-5xl">
          Все <span class="text-brand-ink">категории</span>
        </h1>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {sorted.map((cat) => (
            <a href={`/${cat.path}`} class="glass-border-3d bg-card-bg group rounded-card shadow-soft hover:shadow-soft flex items-center justify-between p-6 transition-colors hover:-translate-y-1">
              <span class="text-text-main group-hover:text-brand-ink text-lg font-semibold transition-colors">{cat.title}</span>
              <Icon name="lucide:chevron-right" class="text-text-muted group-hover:text-brand-ink h-5 w-5 transition-colors" />
            </a>
          ))}
        </div>
      </div>
    </Layout>
  )
}
