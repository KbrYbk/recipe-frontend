---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import RecipeCard from "../components/RecipeCard.astro";

import type { Recipe } from "../types/recipe";

const raw = await import.meta.glob("../data/recipes.json", { eager: true })["../data/recipes.json"];
const recipes: Recipe[] = raw?.default ?? [];
---

<Layout title="РецептыДома — Твоя уютная кухня">
  <div class="mx-auto max-w-6xl">
    <section class="py-12 text-center md:py-16">
      <h1 class="mb-6 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl lg:text-6xl dark:text-slate-100">
        Что <span class="text-primary">приготовим</span> сегодня?
      </h1>
      <p class="mx-auto mb-10 max-w-3xl text-xl text-gray-700 md:text-2xl dark:text-gray-300">Выбирай из наших лучших рецептов</p>
      <SearchBar />
    </section>

    <section aria-labelledby="categories-heading" class="my-12">
      <h2 id="categories-heading" class="sr-only">Популярные категории</h2>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <CategoryCard iconName="lucide:coffee" title="Завтраки" href="/category/zavtrak" />
        <CategoryCard iconName="lucide:soup" title="Обеды" href="/category/obed" />
        <CategoryCard iconName="lucide:drumstick" title="Ужины" href="/category/uzhin" />
        <CategoryCard iconName="lucide:croissant" title="Выпечка" href="/category/vypechka" />
      </div>
    </section>

    <section aria-labelledby="recipes-heading" class="my-12">
      <h2 id="recipes-heading" class="mb-10 text-center text-3xl font-bold">Популярные рецепты</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {recipes.map((recipe) => <RecipeCard key={recipe.id} recipe={recipe} />)}
      </div>
    </section>
  </div>
</Layout>
