---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/ui/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import RecipeCard from "../components/RecipeCard.astro";
import AdSlot from "../components/shared/AdSlot.astro";
import UnavailablePage from "../components/errors/UnavailablePage.astro";
import { Icon } from "astro-icon/components";
import { fetchCollection, fetchRecipeList, type CollectionType } from "../lib/api/recipes";
import { DEFAULT_QUERY } from "../lib/catalog";
import { homeSeo } from "../lib/seo";
import { buildItemListJsonLd, serializeJsonLd } from "../lib/recipeSchema";

const COLLECTION_CONFIG: { id: CollectionType; title: string; icon: string }[] = [
  { id: "breakfast", title: "Завтраки", icon: "lucide:coffee" },
  { id: "lunch", title: "Обеды", icon: "lucide:soup" },
  { id: "dinner", title: "Ужины", icon: "lucide:drumstick" },
  { id: "bakery", title: "Выпечка", icon: "lucide:croissant" },
];

// Первая страница каталога (по новизне) даёт и новые рецепты, и общее число рецептов (один запрос, кэшируется).
// Популярное и подборки грузятся параллельно; если какой-то блок не загрузился — он просто не показывается.
const [res, popularRes, ...collectionRes] = await Promise.all([
  fetchRecipeList({ ...DEFAULT_QUERY, sort: "newest" }),
  fetchRecipeList({ ...DEFAULT_QUERY, sort: "likes" }),
  ...COLLECTION_CONFIG.map((c) => fetchCollection(c.id, 1)),
]);
const popularRecipes = popularRes.ok ? popularRes.data.list.slice(0, 6) : [];
const collections = COLLECTION_CONFIG.map((c, i) => {
  const r = collectionRes[i];
  return { ...c, recipes: r.ok ? r.data.list.slice(0, 3) : [] };
}).filter((c) => c.recipes.length > 0);
if (!res.ok) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "60");
}
const latestRecipes = res.ok ? res.data.list.slice(0, 3) : [];
const total = res.ok ? res.data.total : 0;
// «Более 39 000» — округление вниз до тысяч; без числа, если оно неизвестно или мало.
const seo = homeSeo(total);
const origin = Astro.site?.origin ?? Astro.url.origin;
const itemLists = [
  latestRecipes.length ? buildItemListJsonLd(latestRecipes, origin, 0, "Новые рецепты") : null,
  popularRecipes.length ? buildItemListJsonLd(popularRecipes, origin, 0, "Популярные рецепты") : null,
].filter(Boolean);
---

{!res.ok && <UnavailablePage />}
{
  res.ok && (
    <Layout title={seo.title} description={seo.description}>
      <Fragment slot="head">
        {itemLists.map((ld) => (
          <script type="application/ld+json" is:inline set:html={serializeJsonLd(ld)} />
        ))}
      </Fragment>
      <div class="mx-auto max-w-6xl px-4">
        <div class="glass-border-3d bg-card-bg rounded-panel shadow-soft mt-2 mb-8 px-4 py-7 md:px-10 md:py-12 lg:px-14 lg:py-16">
          <section class="pb-8 md:pb-10">
            <h1 class="page-title text-text-main mb-5 max-w-4xl lg:text-[4rem]">
              Рецепты с фото пошагово: что <span class="text-brand">приготовить</span> сегодня?
            </h1>
            <p class="lead-text mb-8 max-w-2xl">Выбирай из наших лучших рецептов на SwagEda — пошаговые инструкции, которые помогут приготовить шедевр даже новичку.</p>
            <SearchBar />
          </section>

          <section aria-labelledby="categories-heading">
            <h2 id="categories-heading" class="sr-only">
              Популярные категории
            </h2>
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
              {COLLECTION_CONFIG.map((c) => (
                <CategoryCard iconName={c.icon} title={c.title} href={`/collection/${c.id}`} />
              ))}
            </div>
          </section>
        </div>

        {/* Баннер 17 — после категорий, горячий трафик главной */}
        <AdSlot id="R-A-19056160-17" className="max-w-6xl" />

        <section aria-labelledby="recipes-heading" class="mb-12 md:mb-16">
          <div class="mb-5 flex items-baseline justify-between gap-4 md:mb-6">
            <div>
              <h2 id="recipes-heading" class="section-title text-text-main">
                Новые рецепты
              </h2>
            </div>
            <a href="/recipes" class="text-brand-ink shrink-0 py-2 text-sm font-medium hover:underline">
              Все рецепты &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
            {latestRecipes.map((recipe, i) => (
              <RecipeCard recipe={recipe} headingLevel="h3" priority={i === 0} featured={i === 0} />
            ))}
          </div>
        </section>

        {popularRecipes.length > 0 && (
          <section aria-labelledby="popular-heading" class="mb-12 md:mb-16">
            <div class="mb-5 flex items-baseline justify-between gap-4 md:mb-6">
              <div>
                <h2 id="popular-heading" class="section-title text-text-main">
                  Популярное
                </h2>
              </div>
              <a href="/recipes?sort=likes" class="text-brand-ink shrink-0 py-2 text-sm font-medium hover:underline">
                Смотреть все &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
              {popularRecipes.map((recipe) => (
                <RecipeCard recipe={recipe} headingLevel="h3" />
              ))}
            </div>
          </section>
        )}

        {collections.length > 0 && (
          <section aria-labelledby="collections-heading" class="mb-12 md:mb-16">
            <div class="mb-5 md:mb-6">
              <h2 id="collections-heading" class="section-title text-text-main">
                Подборки
              </h2>
            </div>
            <div class="space-y-12 md:space-y-14">
              {collections.map((c) => (
                <section aria-labelledby={`collection-${c.id}-heading`}>
                  <div class="mb-5 flex items-center justify-between gap-4">
                    <h3 id={`collection-${c.id}-heading`} class="text-text-main flex items-center gap-3 text-xl font-semibold">
                      <span class="bg-accent-soft text-brand-ink rounded-control flex h-10 w-10 items-center justify-center">
                        <Icon name={c.icon} class="h-5 w-5" aria-hidden="true" />
                      </span>
                      {c.title}
                    </h3>
                    <a href={`/collection/${c.id}`} class="text-brand-ink shrink-0 py-2 text-sm font-medium hover:underline" aria-label={`Смотреть все: ${c.title}`}>
                      Смотреть все &rarr;
                    </a>
                  </div>
                  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
                    {c.recipes.map((recipe) => (
                      <RecipeCard recipe={recipe} headingLevel="h4" />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </section>
        )}
      </div>
    </Layout>
  )
}
