---
import Layout from '../layouts/Layout.astro';
import recipes from '../data/recipes.json';
---

<Layout title="Главная | РецептыДома">
  <main class="py-10">
    <h1 class="text-4xl font-bold mb-8 text-center">Что приготовим сегодня?</h1>
    
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8" aria-label="Список доступных рецептов">
      {recipes.map((recipe) => (
        <article class="bg-white p-6 rounded-2xl shadow-lg border border-slate-200 hover:shadow-xl transition-shadow">
          <h2 class="text-2xl font-bold mb-2">{recipe.title}</h2>
          <p class="text-slate-600 mb-4">{recipe.description}</p>
          <div class="flex justify-between items-center text-sm font-medium">
            <span class="bg-orange-100 text-orange-800 px-3 py-1 rounded-full">⏱ {recipe.time} мин</span>
            <span class="text-slate-500">Сложность: {recipe.difficulty}</span>
          </div>
          <a href={`/recipe/${recipe.id}`} class="block mt-6 w-full text-center bg-slate-900 text-white py-3 rounded-lg font-bold hover:bg-slate-700">
            Открыть рецепт
          </a>
        </article>
      ))}
    </section>
  </main>
</Layout>