---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import RecipeCard from "../components/RecipeCard.astro";
import localRecipes from "../data/recipes.json";
import { fetchRecipesFromApi, mapBackendRecipe } from "../lib/api/recipes";

let errorMessage = "";
const { list, ok, status } = await fetchRecipesFromApi({ limit: 3 });

if (!ok && status === 403) {
  errorMessage = "Бэкенд: доступ запрещен (IP Whitelist). Покажу только локальные рецепты.";
} else if (!ok && status !== 0) {
  errorMessage = "Не удалось загрузить рецепты с сервера. Показаны локальные данные.";
} else if (!ok) {
  errorMessage = "Бэкенд недоступен. Использую резервные данные.";
}

const processedBackend = (list as Record<string, unknown>[]).map((r) => mapBackendRecipe(r));

// Для локальных рецептов просто добавляем префикс к ID
const processedLocal = localRecipes.map((r) => ({
  ...r,
  id: `local-${r.id}`,
}));

// Соединяем: если API был успешен, используем его данные. Иначе - локальные.
const allRecipes = ok ? processedBackend : processedLocal;
---

<Layout title="SwagEda — Твоя уютная кухня">
  <div class="mx-auto max-w-6xl">
    {
      errorMessage && (
        <div class="my-8 rounded-2xl border border-red-200 bg-red-50 px-6 py-4 text-red-700">
          <p class="font-bold">Проблема с бэкендом:</p>
          <p>{errorMessage}</p>
        </div>
      )
    }

    <section class="py-12 text-center md:py-16">
      <h1 class="text-text-main m mb-6 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
        Что <span class="text-brand">приготовим</span> сегодня?
      </h1>
      <p class="text-text-muted mx-auto mb-10 max-w-3xl text-xl md:text-2xl">Выбирай из наших лучших рецептов</p>
      <SearchBar />
    </section>

    <section aria-labelledby="categories-heading" class="mb-12">
      <h2 id="categories-heading" class="sr-only">Популярные категории</h2>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
        <CategoryCard iconName="lucide:coffee" title="Завтраки" href="/recipes?category=breakfast" />
        <CategoryCard iconName="lucide:soup" title="Обеды" href="/recipes?category=lunch" />
        <CategoryCard iconName="lucide:drumstick" title="Ужины" href="/recipes?category=dinner" />
        <CategoryCard iconName="lucide:croissant" title="Выпечка" href="/recipes?category=bakery" />
      </div>
    </section>

    <section aria-labelledby="recipes-heading" class="mb-20">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <h2 id="recipes-heading" class="text-text-main text-3xl font-bold md:text-4xl">Популярные рецепты</h2>
          <div class="bg-brand mt-2 h-1.5 w-20 rounded-full"></div>
        </div>
        <a href="/recipes" class="text-brand hidden font-semibold hover:underline md:block"> Все рецепты &rarr; </a>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {allRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
      </div>
    </section>
  </div>
</Layout>
