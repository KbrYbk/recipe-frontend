---
import Layout from "../layouts/Layout.astro";
import recipes from "../data/recipes.json";
import RecipeImage from "../components/RecipeImage.astro";
---

<Layout title="РецептыДома — Твоя уютная кухня">
  <main class="max-w-6xl mx-auto px-4 py-12"> 
    <div class="text-center mb-16">
      <h1 class="text-6xl font-black text-slate-900 mb-4 tracking-tight">
        Что <span class="text-orange-600">приготовим</span> сегодня?
      </h1>
      <p class="text-xl text-slate-600">Выбирай из наших лучших рецептов</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      recipes.map((recipe) => (
        <a href={`/recipe/${recipe.id}`} class="group w-full">
          {" "}
          <div class="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 border border-slate-100 flex flex-col h-full">
            <RecipeImage
              src={recipe.image}
              alt={recipe.title}  
              class="w-full h-48"
            />

            <div class="p-6 flex flex-col flex-grow">
              <div class="flex justify-between items-start mb-4">
                <h2 class="text-2xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">
                  {recipe.title}
                </h2>
              </div>

              <p class="text-slate-600 line-clamp-2 mb-6 flex-grow">
                {recipe.description}
              </p>

              <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-50">
                <span class="text-sm font-bold text-slate-400">
                  ⏱ {recipe.time} мин
                </span>
                <span class="text-sm font-bold text-orange-600 uppercase tracking-wider text-xs">
                  Смотреть →
                </span>
              </div>
            </div>
          </div>
        </a>
      ))
    }
  </main>
</Layout>
