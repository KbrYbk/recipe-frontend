---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import RecipeCard from "../components/RecipeCard.astro";
import AdSlot from "../components/AdSlot.astro";
import localRecipes from "../data/recipes.json";
import { fetchRecipesFromApi, mapBackendRecipe, fetchCollectionFromApi } from "../lib/api/recipes";

let errorMessage = "";

const COLLECTION_CONFIG = [
  { id: "breakfast", title: "Завтраки", icon: "lucide:coffee" },
  { id: "lunch", title: "Обеды", icon: "lucide:soup" },
  { id: "dinner", title: "Ужины", icon: "lucide:drumstick" },
  { id: "bakery", title: "Выпечка", icon: "lucide:croissant" },
];

// Загружаем популярные и все коллекции параллельно
const [popularRes, ...collectionResults] = await Promise.all([
  fetchRecipesFromApi({ limit: 3 }),
  ...COLLECTION_CONFIG.map(c => fetchCollectionFromApi(c.id))
]);

console.log('DEBUG: popularRes', popularRes);
console.log('DEBUG: collectionResults', collectionResults);

const ok = popularRes.ok;
const status = popularRes.status;

if (!ok && status === 403) {
  errorMessage = "Бэкенд: доступ запрещен (IP Whitelist). Покажу только локальные рецепты.";
} else if (!ok && status !== 0) {
  errorMessage = "Не удалось загрузить рецепты с сервера. Показаны локальные данные.";
} else if (!ok) {
  errorMessage = "Бэкенд недоступен. Использую резервные данные.";
}

console.log('DEBUG: errorMessage', errorMessage);

// Популярные рецепты
const popularRecipes = ok ? (popularRes.list as any[]).map(mapBackendRecipe) : localRecipes.slice(0, 3).map((r) => ({ ...r, id: `local-${r.id}` }));
console.log('DEBUG: popularRecipes (processed)', popularRecipes);

// Обрабатываем коллекции
const collections = COLLECTION_CONFIG.map((config, index) => {
  const res = collectionResults[index];
  const recipes = (res.list || []).slice(0, 3).map(mapBackendRecipe);
  return { ...config, recipes };
}).filter(c => c.recipes.length > 0);

---

<Layout title="SwagEda — Твоя уютная кухня" description="SwagEda (СвэгЕда) — ваш гид в мире кулинарии. Более 31,000 быстрых рецептов: от завтраков до ужинов. Готовим просто, вкусно и с любовью.">
  <div class="mx-auto max-w-6xl px-4">
    {
      errorMessage && (
        <div class="my-8 rounded-2xl border border-red-200 bg-red-50 px-6 py-4 text-red-700">
          <p class="font-bold">Проблема с бэкендом:</p>
          <p>{errorMessage}</p>
        </div>
      )
    }

    <section class="py-12 text-center md:py-16">
      <h1 class="text-text-main mb-6 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">
        Что <span class="text-brand">приготовим</span> сегодня?
        <span class="sr-only">Проект СвэгЕда, СвегЕда, СвагЕда, SwagEda — лучшие домашние рецепты пошагово</span>
      </h1>
      <p class="text-text-muted mx-auto mb-10 max-w-3xl text-xl md:text-2xl">Выбирай из наших лучших рецептов на SwagEda — пошаговые инструкции, которые помогут приготовить шедевр даже новичку.</p>
      <SearchBar />
    </section>

    <section aria-labelledby="categories-heading" class="mb-12">
      <h2 id="categories-heading" class="sr-only">Популярные категории</h2>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
        {COLLECTION_CONFIG.map(c => (
          <CategoryCard iconName={c.icon} title={c.title} href={`/collection/${c.id}`} />
        ))}
      </div>
    </section>

    <AdSlot id="R-A-19056160-16" />

    <section aria-labelledby="recipes-heading" class="mb-20">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <h2 id="recipes-heading" class="text-text-main text-3xl font-bold md:text-4xl">Популярные рецепты</h2>
          <div class="bg-brand mt-2 h-1.5 w-20 rounded-full"></div>
        </div>
        <a href="/recipes" class="text-brand hidden font-semibold hover:underline md:block"> Все рецепты &rarr; </a>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {popularRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
      </div>
    </section>


  </div>
</Layout>
