---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import RecipeCard from "../components/RecipeCard.astro";

import type { Recipe } from "../types/recipe";

const raw = await import.meta.glob("../data/recipes.json", { eager: true })["../data/recipes.json"];
const recipes: Recipe[] = (raw as any)?.default ?? [];
---

<Layout title="Рецепты Дома — Твоя уютная кухня">
  <div class="mx-auto max-w-6xl">
    <section class="py-12 text-center md:py-16">
      <h1 class="mb-6 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl text-text-main m">
        Что <span class="text-brand">приготовим</span> сегодня?
      </h1>
      <p class="mx-auto mb-10 max-w-3xl text-xl md:text-2xl text-text-muted ">Выбирай из наших лучших рецептов</p>
      <SearchBar />
    </section>

    <section aria-labelledby="categories-heading" class="mb-12">
      <h2 id="categories-heading" class="sr-only">Популярные категории</h2>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
        <CategoryCard iconName="lucide:coffee" title="Завтраки" href="/category/breakfast" />
        <CategoryCard iconName="lucide:soup" title="Обеды" href="/category/lunch" />
        <CategoryCard iconName="lucide:drumstick" title="Ужины" href="/category/dinner" />
        <CategoryCard iconName="lucide:croissant" title="Выпечка" href="/category/bakery" />
      </div>
    </section>

    <section aria-labelledby="recipes-heading" class="mb-20">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <h2 id="recipes-heading" class="text-text-main text-3xl font-bold md:text-4xl">Популярные рецепты</h2>
          <div class="bg-brand mt-2 h-1.5 w-20 rounded-full"></div>
        </div>
        <a href="/recipes" class="text-brand hidden font-semibold hover:underline md:block"> Все рецепты &rarr; </a>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {recipes.slice(0, 3).map((recipe) => <RecipeCard recipe={recipe} />)}
      </div>
    </section>
  </div>
</Layout>
