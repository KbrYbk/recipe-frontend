---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import Pagination from "../../components/ui/Pagination.astro";
import NotFoundPage from "../../components/errors/NotFoundPage.astro";
import UnavailablePage from "../../components/errors/UnavailablePage.astro";
import { COLLECTION_TYPES, fetchCollection, isCollectionType } from "../../lib/api/recipes";
import { catalogCanonical, formatCount, parseCatalogQuery, pluralRecipes } from "../../lib/catalog";
import { collectionSeo, listingNoindex } from "../../lib/seo";

const { type } = Astro.params;
const page = parseCatalogQuery(Astro.url.searchParams).page;
const valid = isCollectionType(type);
const res = valid ? await fetchCollection(type, page) : null;

let state: "ok" | "not_found" | "unavailable" = "not_found";
if (res?.ok) state = page > 1 && res.data.list.length === 0 ? "not_found" : "ok";
else if (res) state = res.status === 404 ? "not_found" : "unavailable";

if (state === "not_found") Astro.response.status = 404;
if (state === "unavailable") {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "60");
}

const title = valid ? COLLECTION_TYPES[type] : "";
const basePath = `/collection/${type}`;
const data = res?.ok ? res.data : null;
const total = data?.total ?? 0;
// Страницы 2+ подборки повторяют карточки категорий — noindex,follow.
const noindex = listingNoindex("collection", Astro.url.searchParams, page);
// Под запросы «что приготовить на завтрак/обед/ужин» (src/lib/seo.ts).
const seo = collectionSeo(String(type), title, total, page);
---

{state === "not_found" && <NotFoundPage />}
{state === "unavailable" && <UnavailablePage />}
{
  state === "ok" && data && (
    <Layout title={seo.title} description={seo.description} canonical={catalogCanonical(basePath, page)} noindex={noindex}>
      <div class="mx-auto max-w-6xl md:px-4">
        <header class="border-line mb-8 border-b pb-6 md:mb-12 md:py-10">
          <Breadcrumbs
            items={[
              { name: "Все рецепты", href: "/recipes" },
              { name: title, href: basePath },
            ]}
          />
          <h1 class="text-brand mt-2 text-3xl font-bold md:mt-4 md:text-5xl">{seo.h1}</h1>
          <p class="text-text-muted mt-2 text-base md:mt-4 md:text-lg">
            {total > 0 ? `Подборка «${title.toLowerCase()}»: ${formatCount(total)} ${pluralRecipes(total)}.` : "В этой подборке пока нет рецептов."}
          </p>
        </header>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {data.list.map((recipe, i) => (
            <RecipeCard recipe={recipe} priority={i === 0} />
          ))}
        </div>

        {data.totalPages > 1 && (
          <div class="mt-12">
            <Pagination currentPage={page} totalPages={data.totalPages} baseUrlFunc={(p) => catalogCanonical(basePath, p)} />
          </div>
        )}
      </div>
    </Layout>
  )
}
