---
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import recipes from "../data/recipes.json";

// На стороне сервера мы не знаем, что в localStorage,
// поэтому рендерим базовую страницу, а фильтрацию делаем на клиенте.
---

<Layout title="Избранные рецепты — SwagEda">
  <script is:inline define:vars={{ recipes }}>
    window.ALL_RECIPES = recipes;
  </script>

  <div class="mx-auto max-w-7xl">
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-text-main md:text-4xl">Мои любимые рецепты</h1>
      <p class="text-text-muted">Ваша личная кулинарная книга</p>
    </header>

    <div id="favorites-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Сюда клиентский JS вставит карточки избранного -->
    </div>

    <div id="empty-favorites" class="hidden flex-col items-center justify-center py-20 text-center">
      <div class="mb-4 rounded-full bg-accent-soft p-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 00-1.344 4.395L3 11h4.618c1.735 0 3.182 1.447 3.182 3.182V21l3-3v-7.618c0-1.735-1.447-3.182-3.182-3.182H4.318z" />
        </svg>
      </div>
      <h2 class="text-xl font-semibold text-text-main">Тут пока пусто</h2>
      <p class="text-text-muted">Добавьте рецепты в избранное, чтобы они появились здесь</p>
      <a href="/recipes" class="mt-6 rounded-xl bg-brand px-6 py-3 font-bold text-white transition-all hover:bg-brand-hover">
        Найти рецепты
      </a>
    </div>
  </div>
</Layout>

<script>
  function renderFavorites() {
    const grid = document.getElementById("favorites-grid");
    const empty = document.getElementById("empty-favorites");
    const favorites = JSON.parse(localStorage.getItem("swageda_favorites") || "[]");

    if (!grid || !empty) return;

    if (favorites.length === 0) {
      grid.innerHTML = "";
      empty.classList.remove("hidden");
      empty.classList.add("flex");
      return;
    }

    empty.classList.add("hidden");
    empty.classList.remove("flex");

    const recipesData = (window as any).ALL_RECIPES || [];
    
    favorites.forEach(id => {
      // Robust ID matching: handle numbers, strings, and prefixes
      const recipe = recipesData.find((r: any) => {
        const rid = String(r.id);
        return rid === String(id) || rid === `local-${id}` || rid === `db-${id}`;
      });

      if (recipe) {
        const card = document.createElement("div");
        card.innerHTML = `
          <div class="group relative overflow-hidden rounded-2xl border border-line bg-card-bg transition-all hover:shadow-lg active:scale-95">
            <div class="aspect-video overflow-hidden">
              <img src="${recipe.main_image}" alt="${recipe.title}" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-4">
              <h3 class="mb-2 text-lg font-bold text-text-main transition-colors group-hover:text-brand">${recipe.title}</h3>
              <p class="mb-4 line-clamp-2 text-sm text-text-muted">${recipe.description}</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-text-muted">
                  <span class="flex items-center gap-1"><svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> ${recipe.cooking_time} мин</span>
                </div>
                <a href="/recipe/${recipe.id}" class="rounded-lg bg-brand/10 px-3 py-1 text-xs font-semibold text-brand transition-colors hover:bg-brand hover:text-white">Смотреть</a>
              </div>
            </div>
          </div>
        `;
        grid.appendChild(card);
      }
    });
  }

  document.addEventListener("astro:page-load", renderFavorites);
</script>
