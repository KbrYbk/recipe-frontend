---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Избранные рецепты — SwagEda">
  <div class="mx-auto max-w-7xl px-4">
    <header class="mb-8 text-center">
      <h1 class="text-text-main text-3xl font-bold md:text-4xl">Избранные рецепты</h1>
      <p class="text-text-muted mt-2">Ваша личная кулинарная книга</p>
    </header>

    <div id="favorites-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list" aria-label="Список избранных рецептов">
      <!-- Сюда клиентский JS вставит карточки избранного -->
    </div>

    <div id="empty-favorites" class="hidden flex-col items-center justify-center py-20 text-center" role="status">
      <div class="mb-4 rounded-full bg-accent-soft p-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 00-1.344 4.395L3 11h4.618c1.735 0 3.182 1.447 3.182 3.182V21l3-3v-7.618c0-1.735-1.447-3.182-3.182-3.182H4.318z" />
        </svg>
      </div>
      <h2 class="text-text-main text-xl font-semibold">Тут пока пусто</h2>
      <p class="text-text-muted mt-2">Добавьте рецепты в избранное, чтобы они появились здесь</p>
      <a href="/recipes" class="bg-brand hover:bg-brand-hover mt-6 inline-block rounded-xl px-6 py-3 font-bold text-white transition-all">
        Найти рецепты
      </a>
    </div>
  </div>
</Layout>

<script>
  // Рендер избранного: читаем id из localStorage, грузим каждый рецепт по отдельности
  async function renderFavorites() {
    const grid = document.getElementById("favorites-grid");
    const empty = document.getElementById("empty-favorites");
    const favorites = JSON.parse(localStorage.getItem("swageda_favorites") || "[]");

    console.log("[favorites] ids from localStorage:", favorites);

    if (!grid || !empty) return;

    if (favorites.length === 0) {
      grid.innerHTML = "";
      grid.classList.add("hidden");
      empty.classList.remove("hidden");
      empty.classList.add("flex");
      return;
    }

    empty.classList.add("hidden");
    empty.classList.remove("flex");
    grid.classList.remove("hidden");

    // Загружаем каждый избранный рецепт по отдельности (параллельно) через наш API endpoint
    // id в localStorage хранится с префиксом ("db-123"), API endpoint сам стрипнет и найдёт рецепт
    const recipes = (
      await Promise.all(
        favorites.map(async (id) => {
          try {
            const url = `/api/recipe/${encodeURIComponent(id)}`;
            console.log("[favorites] fetching:", url);
            const res = await fetch(url);
            console.log("[favorites] response status:", res.status, "for", id);
            if (!res.ok) return null;
            return await res.json();
          } catch (e) {
            console.error("[favorites] fetch error for", id, e);
            return null;
          }
        })
      )
    ).filter(Boolean);

    console.log("[favorites] loaded recipes:", recipes.length);

    const fragment = document.createDocumentFragment();

    recipes.forEach((recipe) => {
      const card = document.createElement("article");
      card.className = "group glass-border-3d relative overflow-hidden rounded-2xl bg-card-bg transition-all shadow-md shadow-black/15 hover:shadow-xl hover:shadow-black/20";
      card.setAttribute("role", "listitem");

      const timeDisplay = recipe.cooking_time ? `${recipe.cooking_time} мин` : "";
      const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      const safeTitle = esc(recipe.title || "");
      const safeDesc = esc(recipe.description || "");
      const safeImg = esc(recipe.main_image || "/default-share.jpg");
      const safeId = encodeURIComponent(recipe.id || "");

      card.innerHTML = `
        <a href="/recipe/${safeId}" class="block">
          <div class="aspect-video overflow-hidden">
            <img
              src="${safeImg}"
              alt="${safeTitle}"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-4">
            <h3 class="text-text-main mb-2 text-lg font-bold transition-colors group-hover:text-brand line-clamp-2">${safeTitle}</h3>
            ${recipe.description ? `<p class="text-text-muted mb-3 line-clamp-2 text-sm">${safeDesc}</p>` : ""}
            <div class="flex items-center justify-between">
              ${timeDisplay ? `<span class="text-text-muted flex items-center gap-1 text-xs" aria-label="Время приготовления: ${timeDisplay}"><svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> ${timeDisplay}</span>` : ""}
              <span class="text-brand text-xs font-semibold opacity-0 transition-opacity group-hover:opacity-100">Смотреть →</span>
            </div>
          </div>
        </a>
      `;
      fragment.appendChild(card);
    });

    grid.innerHTML = "";
    grid.appendChild(fragment);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderFavorites);
  } else {
    renderFavorites();
  }
</script>
