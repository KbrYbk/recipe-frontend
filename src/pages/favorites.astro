---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Избранные рецепты — SwagEda" description="Ваши избранные рецепты на SwagEda." noindex>
  <div class="mx-auto max-w-6xl md:px-4">
    <header class="mb-8 text-center">
      <h1 class="text-text-main text-3xl font-bold md:text-4xl">Избранные рецепты</h1>
      <p class="text-text-muted mt-2">Ваша личная кулинарная книга</p>
    </header>

    <p id="favorites-loading" class="text-text-muted hidden py-10 text-center" role="status">Загружаем избранное…</p>
    <p id="favorites-error" class="text-text-muted hidden py-10 text-center" role="alert">Не удалось загрузить избранное. Попробуйте обновить страницу чуть позже.</p>
    <!-- Сюда клиентский JS вставит карточки (тот же RecipeCard, что и в каталоге: /partials/recipe-cards) -->
    <div id="favorites-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list" aria-label="Список избранных рецептов"></div>

    <div id="empty-favorites" class="hidden flex-col items-center justify-center py-20 text-center" role="status">
      <div class="bg-accent-soft mb-4 rounded-full p-6">
        <Icon name="lucide:book-heart" class="text-brand h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="text-text-main text-xl font-semibold">Тут пока пусто</h2>
      <p class="text-text-muted mt-2">Нажмите «В избранное» на странице рецепта — и он появится здесь.</p>
      <a href="/recipes" class="bg-brand hover:bg-brand-hover mt-6 inline-flex items-center gap-2 rounded-xl px-6 py-3 font-bold text-white transition-all">
        <Icon name="lucide:cooking-pot" class="h-5 w-5" aria-hidden="true" />
        Перейти в каталог рецептов
      </a>
    </div>
  </div>
</Layout>

<script>
  import { FAVORITES_KEY, readIdList, toggleId, writeJson } from "../lib/client/storage";
  import { showToast } from "../lib/client/toast";

  const grid = document.getElementById("favorites-grid");
  const empty = document.getElementById("empty-favorites");
  const loading = document.getElementById("favorites-loading");
  const errorBox = document.getElementById("favorites-error");

  function showEmpty() {
    if (!grid || !empty) return;
    grid.innerHTML = "";
    grid.classList.add("hidden");
    empty.classList.remove("hidden");
    empty.classList.add("flex");
  }

  async function renderFavorites() {
    if (!grid || !empty) return;

    // Старый формат "db-123" нормализуется и сохраняется обратно как "123".
    const ids = readIdList(FAVORITES_KEY);
    writeJson(FAVORITES_KEY, ids);
    if (ids.length === 0) return showEmpty();

    // Сначала — добавленные последними.
    const ordered = [...ids].reverse().slice(0, 50);
    loading?.classList.remove("hidden");
    try {
      const res = await fetch(`/partials/recipe-cards?removable=1&ids=${ordered.join(",")}`, { headers: { Accept: "text/html" } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const html = (await res.text()).trim();
      if (!html) return showEmpty();
      grid.innerHTML = html;
    } catch {
      errorBox?.classList.remove("hidden");
    } finally {
      loading?.classList.add("hidden");
    }
  }

  grid?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-favorite-remove]");
    if (!btn) return;
    e.preventDefault();
    const id = btn.dataset.favoriteRemove ?? "";
    toggleId(FAVORITES_KEY, id, false);
    btn.closest("[data-card-item]")?.remove();
    showToast("Рецепт убран из избранного", "info");
    if (!grid.querySelector("[data-card-item]")) showEmpty();
  });

  renderFavorites();
</script>
