---
/**
 * Устаревшие адреса рецепта: /recipe/{id}-{slug}, /recipe/{id}, /recipe/db-{id} (и /recipe/{slug}).
 * Только 301 на канонический /{категория}/{slug} — одним переходом, без цепочек.
 * Бэкенд недоступен → 503 (не 302: временный редирект на промежуточный адрес поисковикам не нужен).
 */
import NotFoundPage from "../../components/errors/NotFoundPage.astro";
import UnavailablePage from "../../components/errors/UnavailablePage.astro";
import { fetchRecipe, fetchRecipeBySlug } from "../../lib/api/recipes";
import { isCanonicalRecipePath, isValidRecipeSlug, parseRecipeParam } from "../../lib/recipeUrl";

const raw = String(Astro.params.id ?? "")
  .trim()
  .toLowerCase();
const parsed = parseRecipeParam(raw);
const res = parsed ? await fetchRecipe(parsed.id) : isValidRecipeSlug(raw) ? await fetchRecipeBySlug(raw) : null;

if (res?.ok && isCanonicalRecipePath(res.data.url)) return Astro.redirect(res.data.url, 301);

const unavailable = res !== null && (res.ok || res.status !== 404);
if (unavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "60");
} else {
  Astro.response.status = 404;
}
---

{unavailable ? <UnavailablePage /> : <NotFoundPage title="Рецепт не найден" />}
