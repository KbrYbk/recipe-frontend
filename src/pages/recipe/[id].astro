---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import localRecipes from "../../data/recipes.json";
import { Icon } from "astro-icon/components";
import IngredientsList from "../../components/IngredientsList.astro";
import { Image } from "astro:assets";
import VideoPlayer from "../../components/VideoPlayer.astro";
import HttpNotFound from "../../components/HttpNotFound.astro";
import AdSlot from "../../components/AdSlot.astro";
import { fetchRecipeById, mapBackendRecipe } from "../../lib/api/recipes";
import { normalizeIngredients } from "../../lib/normalizeIngredients";

const { id } = Astro.params;
const cleanId = id?.replace(/^(local-|db-)/, "");

let recipe: any | null = null;
let isBackendError = false;
let backendErrorMessage = "";

if (id?.startsWith("local-")) {
  const raw = localRecipes.find((r) => String(r.id) === cleanId);
  if (raw) {
    recipe = {
      ...raw,
      id: `local-${raw.id}`,
    } as Record<string, unknown>;
  }
} else if (id?.startsWith("db-")) {
  const { item, ok, status } = await fetchRecipeById(id);
  if (ok && item) {
    recipe = mapBackendRecipe(item) as Record<string, unknown>;
  } else {
    if (status !== 404) {
      isBackendError = true;
      if (status === 403) {
        backendErrorMessage = "Бэкенд: доступ запрещен (IP Whitelist). Не удалось получить данные.";
      } else if (status === 0) {
        backendErrorMessage = "Бэкенд недоступен. Сетевая ошибка или сервер выключен.";
      } else {
        backendErrorMessage = `Не удалось загрузить рецепт с сервера. Код статуса: ${status}`;
      }
    }
  }
}

if (!recipe) {
  Astro.response.status = 404;
}

const title = String(recipe?.title ?? "");
const description = String(recipe?.description ?? (isBackendError ? "Произошла техническая ошибка при загрузке рецепта SwagEda." : "Рецепт не найден на SwagEda."));
const main_image = recipe?.main_image != null ? String(recipe.main_image) : "";
const cooking_time = Number(recipe?.cooking_time ?? 0);
const ingredients = normalizeIngredients(recipe?.ingredients);
const steps = (recipe?.steps as { order?: number; text?: string; image?: string }[] | undefined) ?? [];
const difficulty = recipe?.difficulty != null ? String(recipe.difficulty) : "";
const video_url = recipe?.video_url != null ? String(recipe.video_url) : "";
const pageTitle = recipe ? `${title} — SwagEda` : isBackendError ? "Технические неполадки — SwagEda" : "Рецепт не найден — SwagEda";
const canonical = recipe ? `/recipe/${id}` : "/404";
const origin = Astro.url.origin;
// Перед созданием jsonLdRecipe добавим хелпер для абсолютных ссылок
const toAbsUrl = (url: string) => {
  if (!url) return "";
  if (url.startsWith("http")) return url;
  // Берем домен из конфига (https://swageda.ru)
  const siteUrl = Astro.site ? Astro.site.origin : "https://swageda.ru";
  const cleanPath = url.startsWith("/") ? url : `/${url}`;
  const finalPath = cleanPath.startsWith("/api-images") ? cleanPath : `/api-images${cleanPath}`;

  return `${siteUrl}${finalPath}`;
};
const jsonLdRecipe =
  recipe &&
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Recipe",
    name: title,
    description,
    image: main_image ? [toAbsUrl(main_image)] : [],
    prepTime: recipe.prep_time ? `PT${recipe.prep_time}M` : undefined,
    cookTime: cooking_time ? `PT${cooking_time}M` : undefined,
    totalTime: recipe.prep_time || cooking_time ? `PT${(Number(recipe.prep_time) || 0) + cooking_time}M` : undefined,
    recipeIngredient: ingredients.map((i) => `${i.name}${i.amount || i.unit ? ` — ${i.amount ?? ""} ${i.unit ?? ""}`.trim() : ""}`),
    recipeInstructions: steps.map((step, index) => ({
      "@type": "HowToStep",
      name: `Шаг ${step.order ?? index + 1}`, // Обязательно для карусели
      url: `${Astro.site?.origin}${canonical}#step-${step.order ?? index + 1}`,
      position: step.order ?? index + 1,
      text: step.text ?? "",
      image: step.image ? toAbsUrl(step.image) : undefined,
    })),
    aggregateRating:
      recipe.average_rating > 0
        ? {
            "@type": "AggregateRating",
            ratingValue: recipe.average_rating,
            // Ждем честный ratings_count от бэкенда
            reviewCount: recipe.ratings_count || recipe.likes_count || 1,
          }
        : undefined,
    author: {
      "@type": "Person",
      name: recipe.user?.name || "Команда SwagEda",
    },
    recipeCuisine: recipe.cuisine || undefined,
    recipeYield: recipe.yield ? `${recipe.yield} порции` : "4 порции",
    nutrition: recipe.calories
      ? {
          "@type": "NutritionInformation",
          calories: `${recipe.calories} kcal`,
        }
      : undefined,
    keywords: recipe.keywords || undefined,
    datePublished: recipe.created_at,
    video: video_url
      ? {
          "@type": "VideoObject",
          name: title,
          description: description,
          thumbnailUrl: [toAbsUrl(main_image)],
          contentUrl: video_url,
          uploadDate: recipe.created_at,
        }
      : undefined,
  });
// Формируем объект для мета-тегов
const recipeMeta = recipe
  ? {
      publishDate: recipe.created_at || recipe.updated_at,
      category: typeof recipe.category === "object" ? recipe.category.title : recipe.category,
      author: recipe.user?.name,
    }
  : undefined;
---

<Layout title={pageTitle} description={description} image={main_image} canonical={canonical} noindex={!recipe} ogType="article" recipeData={recipeMeta}>
  {
    !recipe ? (
      <>
        {isBackendError && (
          <div class="mx-auto max-w-lg px-4">
            <div class="my-8 rounded-3xl border border-brand/15 bg-accent-soft p-6 md:p-8 shadow-sm">
              <div class="flex flex-col gap-6 md:flex-row md:items-center">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-brand">
                  <Icon name="lucide:chef-hat" class="h-10 w-10 animate-pulse" aria-hidden="true" />
                </div>
                <div class="flex-grow">
                  <h3 class="text-xl font-bold text-text-main md:text-2xl">
                    Ой, временные трудности на кухне! 🍳
                  </h3>
                  <p class="mt-2 text-base text-text-muted leading-relaxed">
                    Наш сайт сейчас испытывает небольшие технические неполадки. Не переживайте, мы уже вовсю "колдуем" над плитой и исправляем проблему! Возвращайтесь совсем скоро.
                  </p>
                  
                  <details class="mt-4 border-t border-brand/10 pt-4 text-xs text-text-muted">
                    <summary class="cursor-pointer font-medium hover:text-brand transition-colors focus:outline-none">
                      Технические детали (для отладки)
                    </summary>
                    <div class="mt-2 rounded-xl bg-card-bg p-3 border border-line font-mono text-[11px] leading-relaxed break-all text-text-main">
                      Код ошибки: {backendErrorMessage}
                    </div>
                  </details>
                </div>
              </div>
            </div>
          </div>
        )}
        <HttpNotFound />
      </>
    ) : (
      <article class="mx-auto max-w-4xl px-4 py-8 md:py-12">
        {jsonLdRecipe && <script type="application/ld+json" set:html={jsonLdRecipe} />}

        <div class="no-print mb-8">
          <Breadcrumbs
            items={[
              { name: "Рецепты", href: "/recipes" },
              ...(recipe.category
                ? [
                    {
                      name: typeof recipe.category === "object" ? recipe.category.title : recipe.category,
                      href: `/recipes?categoryId=${recipe.category_id || recipe.category?.id}`,
                    },
                  ]
                : []),
              { name: title, href: canonical },
            ]}
          />

          <a href="/recipes" class="group text-brand mt-4 inline-flex items-center text-sm font-bold">
            <Icon name="lucide:arrow-left" class="mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1" aria-hidden="true" />
            Назад к списку
          </a>
        </div>

        <header class="mb-12">
          <h1 class="text-text-main mb-4 text-4xl font-bold md:text-5xl lg:text-7xl">{title}</h1>

          <!-- Метки рецепта: время, сложность -->
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class="bg-card-bg border-line text-text-main inline-flex h-10 items-center gap-2 rounded-lg border px-3 text-sm font-medium sm:h-11 sm:rounded-xl sm:px-4" aria-label={`Время приготовления: ${cooking_time} минут`}>
              <Icon name="lucide:clock" class="text-brand h-4 w-4 shrink-0 sm:h-5 sm:w-5" aria-hidden="true" />
              <span class="tabular-nums">{cooking_time} мин</span>
            </span>

            {difficulty && (
              <span class="bg-accent-soft text-brand inline-flex h-10 items-center gap-2 rounded-lg px-3 text-xs font-bold tracking-wide uppercase sm:h-11 sm:rounded-xl sm:px-4 sm:text-xs" aria-label={`Сложность: ${difficulty === "hard" ? "Сложно" : difficulty === "medium" ? "Средне" : "Легко"}`}>
                <Icon name="lucide:flame" class="h-4 w-4 shrink-0 sm:h-5 sm:w-5" aria-hidden="true" />
                <span>{difficulty === "hard" ? "Сложно" : difficulty === "medium" ? "Средне" : "Легко"}</span>
              </span>
            )}
          </div>

          <!-- Действия: рейтинг, избранное, печать, шаринг -->
          <div class="flex flex-wrap items-center gap-3">
            <!-- Рейтинг -->
            <div
              id="ratingStars"
              data-id={id}
              data-avg={recipe?.average_rating || 0}
              class="bg-card-bg border-line flex h-11 items-center gap-2 rounded-xl border px-3 text-sm font-bold text-amber-500"
              role="group"
              aria-label={`Рейтинг: ${recipe?.average_rating ? Number(recipe.average_rating).toFixed(1) : "0"} из 5`}
            >
              <div class="stars-container flex gap-0.5" role="radiogroup" aria-label="Ваша оценка">
                {[1, 2, 3, 4, 5].map((star) => (
                  <button
                    type="button"
                    data-star={star}
                    class="star-btn rounded-md p-1 transition-transform hover:scale-110 active:scale-90 disabled:opacity-50 disabled:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                    aria-label={`Оценить на ${star} ${star === 1 ? "звезду" : star < 5 ? "звезды" : "звёзд"}`}
                    aria-pressed="false"
                  >
                    <Icon name="lucide:star" class="h-5 w-5 shrink-0" aria-hidden="true" />
                  </button>
                ))}
              </div>
              <div class="ml-1 text-text-main">
                <span class="avg-val font-bold">{recipe?.average_rating ? Number(recipe.average_rating).toFixed(1) : "0"}</span>
                <span class="sr-only"> из 5</span>
                <span class="user-val text-xs text-text-muted hidden"> (Ваша: <span class="val"></span>)</span>
              </div>
            </div>

            <button
              type="button"
              id="favoriteBtn"
              data-id={id}
              aria-label="Добавить в избранное"
              aria-pressed="false"
              class="bg-card-bg border-line text-text-main flex h-11 items-center gap-2 rounded-xl border px-4 text-sm font-medium transition-all hover:text-brand hover:border-brand active:scale-95"
            >
              <Icon name="lucide:bookmark" class="bookmark-icon h-4 w-4 shrink-0" aria-hidden="true" />
              <span class="button-label">Избранное</span>
            </button>

            <button
              type="button"
              onclick="window.print()"
              class="bg-card-bg border-line text-text-main hover:border-brand no-print flex h-11 items-center gap-2 rounded-xl border px-4 text-sm font-medium transition-all active:scale-95"
              aria-label="Печать рецепта"
            >
              <Icon name="lucide:printer" class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span class="button-label">Печать</span>
            </button>

            <button
              type="button"
              id="shareBtn"
              class="bg-brand hover:bg-brand-hover flex h-11 items-center gap-2 rounded-xl px-5 text-sm font-bold text-white transition-all active:scale-95"
              aria-label="Поделиться рецептом"
            >
              <Icon name="lucide:share-2" class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span class="button-label">Поделиться</span>
            </button>
          </div>
        </header>

        <div class="bg-card-bg border-line relative mb-12 aspect-video overflow-hidden rounded-[2.5rem] border shadow-2xl">
          {main_image ? (
            <Image
              src={main_image}
              alt={`Фото готового блюда: ${title}`}
              width={1200}
              height={675}
              data-zoomable
              class="image-zoom h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style={`view-transition-name: recipe-image-${id}`}
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <Icon name="lucide:utensils-crossed" class="text-text-muted h-24 w-24 opacity-10" aria-hidden="true" />
            </div>
          )}
        </div>

        <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
            <IngredientsList ingredients={ingredients} recipeSlug={id ?? "recipe"} />
            <AdSlot id="R-A-19056160-13" className="hidden lg:block" />
          </aside>

          <div class="lg:col-span-2">
            <section aria-labelledby="about-heading" class="mb-12">
              <h2 id="about-heading" class="text-text-main mb-6 text-3xl font-bold">
                О рецепте
              </h2>

              <div class="relative">
                <div class="bg-brand/20 absolute top-0 bottom-0 -left-4 hidden w-1 rounded-full md:block" />

                <p class="text-text-muted mb-6 text-xl leading-relaxed italic">«{description}»</p>
              </div>
            </section>

            <VideoPlayer videoUrl={video_url} />

             <AdSlot id="R-A-19056160-19" />

            <div id="textSteps" role={video_url ? "tabpanel" : undefined} aria-labelledby={video_url ? "tab-recipe-text" : "steps-heading"}>
              <h2 id="steps-heading" class="text-text-main mt-12 mb-8 text-3xl font-bold">
                Приготовление
              </h2>
              <ol class="list-none space-y-12 p-0" aria-labelledby="steps-heading">
                {steps.map((step, index) => (
                  <li class="group relative">
                    <div class="mb-4 flex gap-6">
                      <div class="bg-brand flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-lg font-bold text-white" aria-hidden="true">
                        {step.order ?? index + 1}
                      </div>
                      <p class="text-text-main pt-1 text-lg leading-relaxed">{step.text}</p>
                    </div>

                    {step.image ? (
                      <div class="ml-0 max-w-xl overflow-hidden rounded-2xl border shadow-md sm:ml-16 dark:border-slate-800">
                        <img
                          data-zoomable
                          src={step.image}
                          alt={`Шаг ${step.order ?? index + 1}: иллюстрация`}
                          width={800}
                          height={450}
                          loading="lazy"
                          decoding="async"
                          class="image-zoom h-auto w-full"
                        />
                      </div>
                    ) : null}
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
        <!-- ЛЕНТА РЕКОМЕНДАЦИЙ (РСЯ Виджет) в самом низу рецепта -->
             <div class="border-t border-line mt-12 pt-8 no-print">
              <h3 class="text-text-main mb-6 text-2xl font-bold">Рекомендуем приготовить:</h3>
               <AdSlot id="R-A-19056160-14" isFeed={true} />
            </div>
      </article>
    )
  }
</Layout>

<script is:inline>
  function setupLightbox() {
    let overlay = document.getElementById("image-lightbox");
    if (!overlay) {
      overlay = document.createElement("div");
      overlay.id = "image-lightbox";
      overlay.className = "image-lightbox";
      overlay.innerHTML = '<button type="button" class="image-lightbox-close" aria-label="Закрыть увеличенное изображение">Esc</button><img alt="" />';
      document.body.appendChild(overlay);

      const close = () => overlay.classList.remove("is-open");
      const closeBtn = overlay.querySelector(".image-lightbox-close");
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) close();
      });
      closeBtn?.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    }

    const lightboxImage = overlay.querySelector("img");
    const zoomables = document.querySelectorAll("img[data-zoomable]");
    zoomables.forEach((node) => {
      if (!(node instanceof HTMLImageElement)) return;
      if (node.dataset.lightboxBound === "1") return;
      node.dataset.lightboxBound = "1";
      node.addEventListener("click", () => {
        lightboxImage.src = node.currentSrc || node.src;
        lightboxImage.alt = node.alt || "Увеличенное изображение";
        overlay.classList.add("is-open");
      });
    });
  }

  setupLightbox();
  document.addEventListener("astro:page-load", setupLightbox);

  const shareBtn = document.getElementById("shareBtn");
  if (shareBtn && shareBtn.dataset.bound !== "1") {
    shareBtn.dataset.bound = "1";
    shareBtn.addEventListener("click", async () => {
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url: window.location.href });
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert("Ссылка скопирована!");
        }
      } catch (err) {
        if (import.meta.env.DEV) console.error(err);
      }
    });
  }
</script>

<script>
  import { setRating } from "../../lib/api/recipes";

  function setupInteractions() {
    const favBtn = document.getElementById("favoriteBtn") as HTMLButtonElement | null;
    const ratingContainer = document.getElementById("ratingStars");
    const recipeId = (favBtn || ratingContainer)?.dataset?.id;
    if (!recipeId) return;

    // === FAVORITES ===
    if (favBtn) {
      const favorites = JSON.parse(localStorage.getItem("swageda_favorites") || "[]");
      const isFav = favorites.includes(recipeId);

      const applyFavState = (active: boolean) => {
        const icon = favBtn.querySelector(".bookmark-icon") as SVGElement | null;
        const label = favBtn.querySelector(".button-label") as HTMLElement | null;
        if (active) {
          favBtn.classList.add("text-brand", "border-brand");
          favBtn.setAttribute("aria-pressed", "true");
          if (icon) icon.classList.add("fill-current");
          if (label) label.textContent = "В избранном";
        } else {
          favBtn.classList.remove("text-brand", "border-brand");
          favBtn.setAttribute("aria-pressed", "false");
          if (icon) icon.classList.remove("fill-current");
          if (label) label.textContent = "Избранное";
        }
      };

      applyFavState(isFav);

      favBtn.addEventListener("click", () => {
        const currentFavs = JSON.parse(localStorage.getItem("swageda_favorites") || "[]");
        const index = currentFavs.indexOf(recipeId);
        if (index > -1) {
          currentFavs.splice(index, 1);
          applyFavState(false);
        } else {
          currentFavs.push(recipeId);
          applyFavState(true);
        }
        localStorage.setItem("swageda_favorites", JSON.stringify(currentFavs));
      });
    }

    // === RATING ===
    if (ratingContainer) {
      const myRatings = JSON.parse(localStorage.getItem("my_ratings") || "{}");
      const userRating = myRatings[recipeId];
      const stars = ratingContainer.querySelectorAll(".star-btn") as NodeListOf<HTMLButtonElement>;
      const avgValSpan = ratingContainer.querySelector(".avg-val");
      const avgNum = parseFloat(ratingContainer.dataset.avg || "0");
      let isProcessing = false;

      const fillStars = (val: number) => {
        stars.forEach((s) => {
          const starNum = parseInt(s.dataset.star || "0");
          const svg = s.querySelector("svg");
          if (svg) {
            svg.classList.toggle("fill-current", starNum <= val);
          }
        });
      };

      const updateStarsUI = (val: number, isHover = false) => {
        stars.forEach((s) => {
          const starNum = parseInt(s.dataset.star || "0");
          const svg = s.querySelector("svg");
          const filled = starNum <= val;
          if (svg) {
            svg.classList.toggle("fill-current", filled);
          }
          s.setAttribute("aria-pressed", String(filled && !isHover));
          if (isHover) {
            s.classList.toggle("scale-110", filled);
          }
        });
      };

      const showUserRating = (val: number) => {
        const userValEl = ratingContainer.querySelector(".user-val") as HTMLElement | null;
        const valSpan = userValEl?.querySelector(".val");
        if (userValEl && valSpan) {
          userValEl.classList.remove("hidden");
          valSpan.textContent = String(val);
        }
      };

      // Инициализация при загрузке
      if (userRating) {
        // Пользователь уже голосовал: показываем его оценку и бекенд-среднее
        fillStars(Math.round(avgNum));
        showUserRating(userRating);
        stars.forEach((s) => {
          s.disabled = true;
          s.classList.add("cursor-default");
          s.classList.remove("hover:scale-110", "active:scale-90");
        });
        ratingContainer.classList.add("opacity-90");
      } else {
        // Пользователь ещё не голосовал: показываем среднее с бекенда
        fillStars(Math.round(avgNum));

        // Hover-эффект только если не голосовали
        stars.forEach((btn) => {
          btn.addEventListener("mouseenter", () => {
            if (isProcessing) return;
            const val = parseInt(btn.dataset.star || "0");
            updateStarsUI(val, true);
          });
        });

        ratingContainer.addEventListener("mouseleave", () => {
          if (isProcessing) return;
          fillStars(Math.round(avgNum));
        });
      }

      stars.forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (isProcessing) return;
          // Проверяем и localStorage-флаг, и наличие сохранённой оценки
          if (localStorage.getItem(`rated_${recipeId}`) || myRatings[recipeId]) return;

          const rating = parseInt(btn.dataset.star || "0");
          isProcessing = true;

          // Визуально отключаем кнопки сразу
          stars.forEach((s) => { s.disabled = true; });

          try {
            const ip = await fetch("https://api64.ipify.org?format=json")
              .then((r) => r.json())
              .then((d) => d.ip)
              .catch(() => "0.0.0.0");

            const res = await setRating(recipeId, rating, ip).catch(() => null);

            if (res?.ok) {
              const result = await res.json().catch(() => ({}));
              const newAvg = result?.data?.average_rating || result?.average_rating;

              myRatings[recipeId] = rating;
              localStorage.setItem("my_ratings", JSON.stringify(myRatings));
              localStorage.setItem(`rated_${recipeId}`, "true");

              // Заполняем звёзды по среднему с бекенда
              const displayAvg = newAvg ? Math.round(Number(newAvg)) : rating;
              fillStars(displayAvg);
              showUserRating(rating);

              // Анимация успеха
              ratingContainer.classList.add("ring-2", "ring-amber-500", "ring-offset-2");
              setTimeout(() => ratingContainer.classList.remove("ring-2", "ring-amber-500", "ring-offset-2"), 2000);

              // Обновляем средний балл
              if (avgValSpan) {
                avgValSpan.textContent = newAvg ? Number(newAvg).toFixed(1) : String(rating);
              }
            } else {
              const status = res?.status;
              if (status === 403) {
                alert("Вы уже оценивали этот рецепт");
                myRatings[recipeId] = rating;
                localStorage.setItem("my_ratings", JSON.stringify(myRatings));
                localStorage.setItem(`rated_${recipeId}`, "true");
              } else {
                alert("Произошла ошибка при сохранении оценки. Попробуйте позже.");
                stars.forEach((s) => { s.disabled = false; });
                isProcessing = false;
              }
            }
          } catch (err) {
            console.error(err);
            stars.forEach((s) => { s.disabled = false; });
            isProcessing = false;
          }
        });
      });
    }
  }

  setupInteractions();
  document.addEventListener("astro:page-load", setupInteractions);
</script>
