---
export const prerender = false;
import { fetchRecipeById, mapBackendRecipe } from "../../lib/api/recipes";
import localRecipes from "../../data/recipes.json";
import { slugify } from "../../lib/slugify";

const { id } = Astro.params;
const cleanId = String(id).replace(/^(local-|db-)/, "");

let recipe: any = null;
const isLocal = Number(cleanId) >= 999000 || id?.startsWith("local-");

if (isLocal) {
  recipe = localRecipes.find((r) => String(r.id) === cleanId);
} else {
  const { item, ok } = await fetchRecipeById(cleanId);
  if (ok && item) {
    recipe = mapBackendRecipe(item);
  }
}

if (!recipe) {
  return Astro.redirect("/404");
}

const catSlug = slugify(typeof recipe.category === "object" ? recipe.category?.title || "recipe" : recipe.category || "recipe");
const authorSlug = slugify(recipe.user?.name || "author");
const titleSlug = slugify(recipe.title);

return Astro.redirect(`/${catSlug}/${authorSlug}/${cleanId}/${titleSlug}`, 301);
---
