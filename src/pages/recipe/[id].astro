---
import Layout from "../../layouts/Layout.astro";
import recipesData from "../../data/recipes.json";
import type { Recipe } from "../../types/recipe";

export async function getStaticPaths() {
  const recipes = recipesData as Recipe[];
  return recipes.map((recipe) => ({
    params: { id: recipe.id.toString() },
    props: { recipe },
  }));
}

const { recipe } = Astro.props; // Типизация пропсов уже подхватится из getStaticPaths
const { title, description, image, time, ingredients = [], steps = [], difficulty } = recipe;
---

<Layout title={`${title} — РецептыДома`}>
  <article class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <nav class="mb-8">
      <a href="/" class="group text-primary inline-flex items-center font-medium transition-colors">
        <span class="mr-2 transition-transform group-hover:-translate-x-1">←</span>
        Назад к рецептам
      </a>
    </nav>

    <header class="mb-12">
      <h1 class="mb-6 text-4xl font-black tracking-tight text-slate-900 md:text-5xl lg:text-7xl dark:text-white">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-base md:text-lg">
        <span class="flex items-center gap-2 rounded-2xl bg-slate-100 px-5 py-2 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          ⏱ {time} мин
        </span>
        {difficulty && <span class="flex items-center gap-2 rounded-2xl bg-orange-50 px-5 py-2 font-medium text-orange-600 dark:bg-orange-900/20 dark:text-orange-400">🔥 {difficulty}</span>}
      </div>
    </header>

    <div class="relative mb-12 flex aspect-video items-center justify-center overflow-hidden rounded-[2rem] border border-slate-100 bg-slate-200 shadow-2xl dark:border-slate-800 dark:bg-slate-800">
      {image ? <img src={image} alt={title} class="h-full w-full object-cover" /> : <div class="text-9xl opacity-20">🍲</div>}
    </div>

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-3">
      <aside class="lg:sticky lg:top-28 lg:col-span-1">
        <div class="rounded-[2rem] border border-slate-100 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold text-slate-900 dark:text-white">
            <span>🛒</span> Ингредиенты
          </h2>
          <ul class="space-y-4">
            {
              ingredients.map((item) => (
                <li class="flex items-center gap-3 border-b border-slate-50 pb-2 text-slate-700 last:border-0 dark:border-slate-800/50 dark:text-slate-300">
                  <input type="checkbox" class="text-primary focus:ring-primary h-5 w-5 rounded border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>

      <div class="lg:col-span-2">
        <section>
          <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">О рецепте</h2>
          <p class="mb-12 text-xl leading-relaxed text-slate-600 italic dark:text-slate-400">
            «{description}»
          </p>

          <h2 class="mb-8 text-3xl font-bold text-slate-900 dark:text-white">Пошаговое приготовление</h2>
          <div class="space-y-10">
            {
              steps.map((step, index) => (
                <div class="group flex gap-6">
                  <div class="group-hover:bg-primary flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-slate-100 text-xl font-bold text-slate-500 transition-colors group-hover:text-white dark:border-slate-700 dark:bg-slate-800">
                    {index + 1}
                  </div>
                  <div class="pt-2">
                    <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300">{step}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>
