---
import Layout from "../../layouts/Layout.astro";
import recipesData from "../../data/recipes.json";
import type { Recipe } from "../../types/recipe";
import VideoPlayer from "../../components/VideoPlayer.astro";
import IngredientsList from "../../components/IngredientsList.astro";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const recipes = recipesData as Recipe[];
  return recipes.map((recipe) => ({
    params: { id: recipe.id.toString() },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { title, description, image, time, ingredients, steps, difficulty, videoUrl } = recipe;
---

<Layout title={`${title} — РецептыДома`}>
  <article class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <nav class="mb-8 print:hidden">
      <a href="/" class="group text-primary inline-flex items-center font-medium">
        <span class="mr-2 transition-transform group-hover:-translate-x-1">
          <Icon name="lucide:arrow-left" class="h-4 w-4" /></span>
          Назад к рецептам
      </a>
    </nav>

    <header class="mb-12">
      <h1 class="mb-6 text-4xl font-black text-slate-900 md:text-5xl lg:text-7xl dark:text-white">
        {title}
      </h1>

      <div class="flex flex-col justify-between gap-6 sm:flex-row md:items-center">
        <div class="flex flex-col gap-4 sm:flex-row">
          <span class="flex items-center justify-center gap-2 rounded-2xl bg-slate-100 px-5 py-2 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
            <Icon name="lucide:clock" class="h-5 w-5" />
            <span>{time} мин</span>
          </span>
          {
            difficulty && (
              <span class="flex items-center justify-center gap-2 rounded-2xl bg-orange-50 px-5 py-2 font-medium text-orange-600 dark:bg-orange-900/20 dark:text-orange-400">
                <Icon name="lucide:flame" class="h-5 w-5" />
                {difficulty}
              </span>
            )
          }
        </div>

        <div class="flex flex-col gap-3 sm:flex-row print:hidden">
          <button onclick="window.print()" class="flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2 text-sm font-medium dark:bg-slate-800 dark:text-slate-300">
            <Icon name="lucide:printer" class="h-4 w-4" />
            <span>Печать</span>
          </button>
          <button id="shareBtn" class="bg-primary/10 text-primary flex items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-medium">
            <Icon name="lucide:share-2" class="h-4 w-4" />
            Поделиться</button
          >
        </div>
      </div>
    </header>

    <div class="relative mb-12 flex aspect-video items-center justify-center overflow-hidden rounded-[2rem] bg-slate-200 shadow-2xl dark:bg-slate-800">
      {image ? (
        <img src={image} alt={title} class="h-full w-full object-cover" />
      ) : (
        <div class="flex items-center justify-center h-full w-full">
           <Icon name="lucide:utensils-crossed" class="h-20 w-20 opacity-20" />
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      <IngredientsList ingredients={ingredients} />

      <div class="lg:col-span-2">
        <section>
          <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">О рецепте</h2>
          <p class="mb-12 text-xl text-slate-600 italic dark:text-slate-400">«{description}»</p>

          <VideoPlayer videoUrl={videoUrl} />

          <h2 class="mb-8 text-3xl font-bold text-slate-900 dark:text-white">Приготовление</h2>
          <div id="textSteps" class="space-y-12">
            {
              (steps || []).map((step, index) =>(
                <div class="group">
                  <div class="mb-4 flex gap-6">
                    <div class="bg-primary flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full font-bold text-white">{index + 1}</div>
                    <p class="pt-1 text-lg text-slate-700 dark:text-slate-300">{typeof step === "string" ? step : step.text}</p>
                  </div>
                  {typeof step !== "string" && step.image && (
                    <div class="ml-16 max-w-xl overflow-hidden rounded-2xl border shadow-md dark:border-slate-800">
                      <img src={step.image} alt={`Шаг ${index + 1}`} class="h-auto w-full" />
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>

<script>
  const shareBtn = document.getElementById("shareBtn");
  shareBtn?.addEventListener("click", async () => {
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: window.location.href });
      } else {
        await navigator.clipboard.writeText(window.location.href);
        alert("Ссылка скопирована!");
      }
    } catch (err) {
      console.error(err);
    }
  });
</script>
