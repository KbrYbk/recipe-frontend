---
/** Список покупок: хранится только в браузере (localStorage), без бэкенда. */
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Список покупок — SwagEda" description="Список покупок из ингредиентов рецептов SwagEda." noindex>
  <div class="mx-auto max-w-2xl">
    <header class="mb-6 md:mb-8">
      <h1 class="text-text-main text-3xl font-semibold md:text-4xl">Список покупок</h1>
      <p class="text-text-muted mt-2 text-sm md:text-base">Добавляйте ингредиенты кнопкой «В список покупок» на странице рецепта. Список хранится только на этом устройстве.</p>
    </header>

    <form class="mb-6 flex gap-2" data-shopping-add>
      <label for="shopping-new" class="sr-only">Добавить позицию</label>
      <input
        id="shopping-new"
        name="item"
        type="text"
        maxlength="200"
        autocomplete="off"
        placeholder="Добавить: молоко, хлеб…"
        class="glass-border-3d bg-card-bg text-text-main placeholder:text-text-muted focus:ring-brand/45 rounded-control w-full px-4 py-3 focus:ring-2 focus:outline-none"
      />
      <button type="submit" class="btn-primary shrink-0 px-4" aria-label="Добавить">
        <Icon name="lucide:plus" class="h-5 w-5" aria-hidden="true" />
      </button>
    </form>

    <div class="mb-6 flex flex-wrap gap-2" data-shopping-actions hidden>
      <button
        type="button"
        class="glass-border-3d text-text-main hover:text-brand-ink rounded-control inline-flex cursor-pointer items-center gap-1.5 px-3 py-2 text-sm font-semibold"
        data-shopping-share
      >
        <Icon name="lucide:share-2" class="h-4 w-4" aria-hidden="true" />
        Поделиться
      </button>
      <button
        type="button"
        class="glass-border-3d text-text-main hover:text-brand-ink rounded-control inline-flex cursor-pointer items-center gap-1.5 px-3 py-2 text-sm font-semibold"
        data-shopping-copy
      >
        <Icon name="lucide:copy" class="h-4 w-4" aria-hidden="true" />
        Копировать
      </button>
      <button
        type="button"
        class="glass-border-3d text-text-main hover:text-brand-ink rounded-control inline-flex cursor-pointer items-center gap-1.5 px-3 py-2 text-sm font-semibold"
        data-shopping-clear-done
      >
        <Icon name="lucide:check-check" class="h-4 w-4" aria-hidden="true" />
        Убрать купленное
      </button>
      <button
        type="button"
        class="rounded-control text-negative inline-flex cursor-pointer items-center gap-1.5 bg-rose-500/10 px-3 py-2 text-sm font-semibold hover:bg-rose-500/20"
        data-shopping-clear
      >
        <Icon name="lucide:trash-2" class="h-4 w-4" aria-hidden="true" />
        Очистить всё
      </button>
    </div>

    <div class="bg-page-bg/70 border-line rounded-card mb-4 inline-grid grid-cols-2 gap-1 border p-1" role="group" aria-label="Вид списка" data-shopping-view hidden>
      <button type="button" class="rounded-control h-9 cursor-pointer px-4 text-sm font-semibold transition-colors" data-view="merged" aria-pressed="true">Всё вместе</button>
      <button type="button" class="rounded-control h-9 cursor-pointer px-4 text-sm font-semibold transition-colors" data-view="recipes" aria-pressed="false">По рецептам</button>
    </div>

    <div data-shopping-list class="space-y-6" aria-live="polite"></div>

    <div class="hidden flex-col items-center py-16 text-center" data-shopping-empty>
      <div class="bg-accent-soft mb-4 rounded-full p-6">
        <Icon name="lucide:shopping-cart" class="text-brand-ink h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="text-text-main text-xl font-semibold">Список пуст</h2>
      <p class="text-text-muted mt-2">Откройте рецепт и нажмите «В список покупок».</p>
      <a href="/recipes" class="btn-primary mt-6 px-6 py-3">Найти рецепты</a>
    </div>
  </div>
</Layout>

<script>
  import { readJson, readString, writeJson, writeString } from "../lib/client/storage";
  import { showToast } from "../lib/client/toast";
  import { cleanIngredientAmount } from "../lib/normalizeIngredients";
  import { CHECKBOX_CLASS } from "../lib/ui";
  import {
    addItems,
    formatMergedShoppingList,
    formatShoppingList,
    groupByRecipe,
    mergeShoppingItems,
    removeDone,
    removeItems,
    removeRecipe,
    sanitizeShoppingList,
    setItemsDone,
    SHOPPING_LIST_KEY,
    type ShoppingItem,
  } from "../lib/shoppingList";

  const VIEW_KEY = "swageda:shopping-view";
  type View = "merged" | "recipes";
  let view: View = readString(VIEW_KEY) === "recipes" ? "recipes" : "merged";
  const viewEl = document.querySelector<HTMLElement>("[data-shopping-view]");

  const listEl = document.querySelector<HTMLElement>("[data-shopping-list]");
  const emptyEl = document.querySelector<HTMLElement>("[data-shopping-empty]");
  const actionsEl = document.querySelector<HTMLElement>("[data-shopping-actions]");

  const load = (): ShoppingItem[] => sanitizeShoppingList(readJson<unknown>(SHOPPING_LIST_KEY, []));
  const save = (list: ShoppingItem[]) => {
    writeJson(SHOPPING_LIST_KEY, list);
    render();
  };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text = ""): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  }

  /** Строка списка: чекбокс, название, количество, (рецепты), удалить. ids — позиции, которые строка объединяет. */
  function row(name: string, amount: string, done: boolean, ids: string[], sub?: string): HTMLLIElement {
    const li = el("li", "flex items-center gap-3 rounded-control p-2 hover:bg-page-bg/50");
    const label = el("label", "flex min-w-0 flex-1 cursor-pointer items-start gap-3");
    const cb = el("input", `mt-0.5 h-5 w-5 ${CHECKBOX_CLASS}`);
    cb.type = "checkbox";
    cb.checked = done;
    cb.addEventListener("change", () => save(setItemsDone(load(), ids, cb.checked)));
    const body = el("span", "min-w-0");
    const text = el("span", done ? "text-text-muted line-through" : "text-text-main font-medium", name);
    body.appendChild(text);
    const shownAmount = cleanIngredientAmount(amount);
    if (shownAmount) body.appendChild(el("span", "text-text-muted ml-2 text-sm whitespace-nowrap", shownAmount));
    if (sub) body.appendChild(el("span", "text-text-muted/80 block text-xs", sub));
    label.append(cb, body);
    const del = el("button", "text-text-muted hover:text-negative flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg", "✕");
    del.type = "button";
    del.setAttribute("aria-label", `Удалить «${name}»`);
    del.addEventListener("click", () => save(removeItems(load(), ids)));
    li.append(label, del);
    return li;
  }

  function renderView() {
    viewEl?.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((b) => {
      const on = b.dataset.view === view;
      b.setAttribute("aria-pressed", String(on));
      b.classList.toggle("bg-brand", on);
      b.classList.toggle("text-on-brand", on);
      b.classList.toggle("text-text-muted", !on);
    });
  }

  function render() {
    if (!listEl || !emptyEl || !actionsEl) return;
    const list = load();
    listEl.replaceChildren();
    const isEmpty = list.length === 0;
    emptyEl.classList.toggle("hidden", !isEmpty);
    emptyEl.classList.toggle("flex", isEmpty);
    actionsEl.hidden = isEmpty;
    if (viewEl) viewEl.hidden = isEmpty;
    renderView();
    if (isEmpty) return;

    if (view === "merged") {
      const section = el("section", "glass-border-3d bg-card-bg/60 rounded-panel p-4 md:p-6");
      const ul = el("ul", "space-y-1");
      for (const item of mergeShoppingItems(list)) {
        ul.appendChild(row(item.name, item.amount, item.done, item.ids, item.recipes.length > 1 ? item.recipes.join(", ") : undefined));
      }
      section.appendChild(ul);
      listEl.appendChild(section);
      return;
    }

    for (const group of groupByRecipe(list)) {
      const section = el("section", "glass-border-3d bg-card-bg/60 rounded-panel p-4 md:p-6");
      const head = el("div", "mb-3 flex items-center justify-between gap-3");
      const title = group.url ? el("a", "text-text-main hover:text-brand-ink text-lg font-semibold", group.title) : el("h2", "text-text-main text-lg font-semibold", group.title);
      if (group.url && title instanceof HTMLAnchorElement) title.href = group.url;
      head.appendChild(title);
      if (group.recipeId) {
        const rm = el("button", "text-text-muted hover:text-negative shrink-0 cursor-pointer px-2 py-2 text-xs font-medium", "Убрать рецепт");
        rm.type = "button";
        rm.addEventListener("click", () => save(removeRecipe(load(), group.recipeId!)));
        head.appendChild(rm);
      }
      section.appendChild(head);

      const ul = el("ul", "space-y-1");
      for (const item of group.items) ul.appendChild(row(item.name, item.amount ?? "", item.done, [item.id]));
      section.appendChild(ul);
      listEl.appendChild(section);
    }
  }

  viewEl?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-view]");
    if (!btn) return;
    view = btn.dataset.view === "recipes" ? "recipes" : "merged";
    writeString(VIEW_KEY, view === "merged" ? null : view);
    render();
  });

  const shareText = () => (view === "merged" ? formatMergedShoppingList(load()) : formatShoppingList(load()));

  document.querySelector<HTMLFormElement>("[data-shopping-add]")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = (e.currentTarget as HTMLFormElement).elements.namedItem("item") as HTMLInputElement | null;
    const name = input?.value.trim();
    if (!input || !name) return;
    save(addItems(load(), [{ name }]).list);
    input.value = "";
  });

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      showToast("Список скопирован", "success");
    } catch {
      showToast("Не удалось скопировать", "error");
    }
  }

  document.querySelector("[data-shopping-copy]")?.addEventListener("click", () => copyText(shareText()));
  document.querySelector("[data-shopping-share]")?.addEventListener("click", async () => {
    const text = shareText();
    if (navigator.share) {
      try {
        await navigator.share({ title: "Список покупок", text });
        return;
      } catch (err) {
        if (err instanceof DOMException && err.name === "AbortError") return;
      }
    }
    copyText(text);
  });
  document.querySelector("[data-shopping-clear-done]")?.addEventListener("click", () => save(removeDone(load())));
  document.querySelector("[data-shopping-clear]")?.addEventListener("click", () => {
    if (confirm("Очистить весь список покупок?")) save([]);
  });

  // Изменения из другой вкладки
  window.addEventListener("storage", (e) => {
    if (e.key === SHOPPING_LIST_KEY) render();
  });

  render();
</script>
