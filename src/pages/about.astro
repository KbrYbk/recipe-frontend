---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import Surface from "../components/ui/Surface.astro";
import { fetchRecipesTotal } from "../lib/api/recipes";
import { formatCount } from "../lib/catalog";
import { serializeJsonLd } from "../lib/recipeSchema";

// Число рецептов — из API, как на главной: «более 39 000» (округление вниз до тысяч). Нет данных — без цифры.
const total = await fetchRecipesTotal();
const rounded = total >= 2000 ? Math.floor(total / 1000) * 1000 : 0;
const countText = rounded ? `более ${formatCount(rounded)}` : "тысячи";
const description = `SwagEda — кулинарный сайт с пошаговыми рецептами: ${countText} рецептов с фото. Кто мы, как отбираем и проверяем рецепты и как сообщить об ошибке.`;

const origin = Astro.site?.origin ?? Astro.url.origin;
const aboutJsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: `${origin}/about`,
  name: "О проекте — SwagEda",
  isPartOf: { "@id": `${origin}/#website` },
  about: { "@id": `${origin}/#organization` },
});

const checks = [
  { icon: "lucide:list-checks", title: "Полный список ингредиентов", text: "С количеством и единицами измерения, чтобы всё можно было купить заранее и ничего не искать в середине готовки." },
  { icon: "lucide:camera", title: "Шаги с фотографиями", text: "Каждый этап описан отдельно, а к шагам приложены фото: видно, какой должна быть консистенция и как выглядит блюдо на каждом этапе." },
  { icon: "lucide:clock", title: "Время и сложность", text: "У каждого рецепта указано время приготовления и уровень сложности — легко выбрать блюдо на будний вечер или на праздник." },
];

const features = [
  { icon: "lucide:chef-hat", title: "Режим готовки", text: "Крупные шаги на весь экран, экран не гаснет, пока вы готовите." },
  { icon: "lucide:scale", title: "Пересчёт порций", text: "Количество ингредиентов меняется в один клик — от половины до тройной порции." },
  { icon: "lucide:shopping-cart", title: "Список покупок", text: "Ингредиенты из нескольких рецептов собираются в один список, одинаковые складываются." },
];
---

<Layout title="О проекте — SwagEda" description={description}>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={aboutJsonLd} /></Fragment>
  <div class="mx-auto max-w-4xl px-4 py-12 md:py-16">
    <section class="mb-14 text-center">
      <span class="bg-accent-soft text-brand-ink inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-semibold">
        <Icon name="lucide:utensils" class="h-4 w-4" aria-hidden="true" />
        О проекте
      </span>
      <h1 class="page-title text-text-main mt-5">SwagEda — рецепты, по которым удобно готовить</h1>
      <p class="text-text-muted mx-auto mt-5 max-w-2xl text-lg leading-relaxed">
        Мы делаем кулинарный сайт для обычной домашней кухни. Сейчас на SwagEda <strong class="text-text-main">{countText} рецептов</strong> с пошаговыми фото: супы, салаты, вторые блюда, выпечка, десерты,
        заготовки и блюда для аэрогриля.
      </p>
    </section>

    <section class="mb-14">
      <Surface padding="lg">
        <h2 class="section-title text-text-main mb-4 flex items-center gap-2">
          <Icon name="lucide:users" class="text-brand-ink h-6 w-6" aria-hidden="true" />
          Кто стоит за сайтом
        </h2>
        <div class="text-text-muted space-y-4 leading-relaxed">
          <p>
            SwagEda ведёт небольшая редакция. Мы отбираем рецепты, следим за тем, чтобы они были понятны и полны, разбиваем приготовление на шаги и собираем их в разделы и подборки — «что приготовить
            на завтрак», «на ужин», праздничные салаты, выпечку.
          </p>
          <p>
            У рецептов есть авторы — их имена указаны на странице рецепта вместе с датой публикации. Некоторые рецепты написала и приготовила сама редакция. Мы не прячем рецепт за регистрацией и не
            просим подписку, чтобы увидеть ингредиенты.
          </p>
        </div>
      </Surface>
    </section>

    <section class="mb-14">
      <h2 class="section-title text-text-main mb-6 text-center">Каким должен быть рецепт на SwagEda</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          checks.map((c) => (
            <Surface padding="md">
              <div class="bg-accent-soft text-brand-ink rounded-card mb-3 flex h-12 w-12 items-center justify-center">
                <Icon name={c.icon} class="h-6 w-6" aria-hidden="true" />
              </div>
              <h3 class="text-text-main mb-2 text-lg font-semibold">{c.title}</h3>
              <p class="text-text-muted text-sm">{c.text}</p>
            </Surface>
          ))
        }
      </div>
    </section>

    <section class="mb-14">
      <Surface padding="lg" class="bg-accent-soft/50">
        <h2 class="section-title text-text-main mb-4 flex items-center gap-2">
          <Icon name="lucide:message-square-warning" class="text-brand-ink h-6 w-6" aria-hidden="true" />
          Нашли ошибку в рецепте?
        </h2>
        <div class="text-text-muted space-y-4 leading-relaxed">
          <p>
            Опечатка в граммовке, перепутанный шаг или неточное время — напишите нам на
            <a href="mailto:support@swageda.ru" class="text-brand-ink font-semibold hover:underline">support@swageda.ru</a> и приложите ссылку на рецепт. Мы проверим и исправим рецепт, а дата обновления
            появится на его странице.
          </p>
          <p>Предложения по разделам, новым подборкам и удобству сайта тоже присылайте на этот адрес — мы читаем все письма.</p>
        </div>
      </Surface>
    </section>

    <section class="mb-14">
      <h2 class="section-title text-text-main mb-6 text-center">Что помогает на кухне</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          features.map((f) => (
            <Surface padding="md" hoverable>
              <div class="bg-accent-soft text-brand-ink rounded-card mb-3 flex h-12 w-12 items-center justify-center">
                <Icon name={f.icon} class="h-6 w-6" aria-hidden="true" />
              </div>
              <h3 class="text-text-main mb-2 text-lg font-semibold">{f.title}</h3>
              <p class="text-text-muted text-sm">{f.text}</p>
            </Surface>
          ))
        }
      </div>
    </section>

    <!-- Creators -->
    <section class="border-border-light text-text-muted mb-14 flex flex-col items-center justify-center gap-4 border-t pt-8 text-sm sm:flex-row sm:gap-8">
      <div class="flex items-center gap-3">
        <span>Фронтенд:</span>
        <a href="https://github.com/KbrYbk" target="_blank" rel="noopener noreferrer" class="hover:text-brand-ink flex items-center gap-1 transition-colors" title="GitHub">
          <Icon name="lucide:github" class="h-4 w-4" />
        </a>
        <a href="https://t.me/kbrybk" target="_blank" rel="noopener noreferrer" class="hover:text-brand-ink flex items-center gap-1 transition-colors" title="Telegram">
          <Icon name="tg" class="h-4 w-4" />
        </a>
      </div>
      <div class="text-border-light hidden sm:block">•</div>
      <div class="flex items-center gap-3">
        <span>Бэкенд:</span>
        <a href="https://github.com/nievon" target="_blank" rel="noopener noreferrer" class="hover:text-brand-ink flex items-center gap-1 transition-colors" title="GitHub">
          <Icon name="lucide:github" class="h-4 w-4" />
        </a>
        <a href="tg://user?id=5049617152" target="_blank" rel="noopener noreferrer" class="hover:text-brand-ink flex items-center gap-1 transition-colors" title="Telegram">
          <Icon name="tg" class="h-4 w-4" />
        </a>
      </div>
    </section>

    <section class="text-center">
      <p class="text-text-muted mb-5 text-lg">Выберите раздел или просто посмотрите, что готовят другие.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/recipes" class="btn-primary px-6 py-3">
          <Icon name="lucide:utensils-crossed" class="h-5 w-5" aria-hidden="true" />
          Все рецепты
        </a>
        <a href="/categories" class="text-brand-ink inline-flex items-center gap-2 px-4 py-2 text-lg font-semibold hover:underline">Категории рецептов &rarr;</a>
      </div>
    </section>
  </div>
</Layout>
