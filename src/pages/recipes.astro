---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import SearchBar from "../components/SearchBar.astro";
import { Icon } from "astro-icon/components";
import localRecipes from "../data/recipes.json";
import { fetchRecipesFromApi, mapBackendRecipe } from "../lib/api/recipes";

const qRaw = Astro.url.searchParams.get("q")?.trim() || "";
const categoryId = Astro.url.searchParams.get("categoryId")?.trim() || "";
const categoryLegacy = Astro.url.searchParams.get("category")?.trim() || "";
const difficultyFilter = Astro.url.searchParams.get("difficulty")?.trim() || "";

// 1) Если есть поиск — используем search/{search}/{categoryId?}
// 2) Если есть categoryId — используем category/{id}
// 3) Иначе — список рецептов
const { list } = await fetchRecipesFromApi({
  search: qRaw || undefined,
  categoryId: categoryId || undefined,
});

let processedBackend = (list as Record<string, unknown>[]).map((r) => mapBackendRecipe(r));

// Временная совместимость: если кто-то ходит по старым ссылкам ?category=breakfast
if (categoryLegacy) {
  processedBackend = processedBackend.filter((r) => String((r as any).category ?? "") === categoryLegacy);
}

const processedLocal = localRecipes.map((r) => ({
  ...r,
  id: `local-${r.id}`,
}));

// В каталоге отдаём приоритет бэку; локальные данные оставляем как fallback, если бэк пустой
const allRecipes = processedBackend.length > 0 ? processedBackend : processedLocal;

function recipesHref(overrides: Record<string, string | undefined>): string {
  const p = new URLSearchParams(Astro.url.searchParams);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined || value === "") p.delete(key);
    else p.set(key, value);
  }
  const s = p.toString();
  return s ? `/recipes?${s}` : "/recipes";
}

// Фильтр сложности оставляем на фронте (если бэк пока не поддерживает), дешево по данным страницы
const filteredRecipes = allRecipes.filter((r) => {
  if (!difficultyFilter || difficultyFilter === "all") return true;
  return String((r as any).difficulty ?? "") === difficultyFilter;
});

// Словарь для фильтров сложности (чтобы сопоставить API и UI)
const difficultyMap = [
  { label: "Все", value: "all" },
  { label: "Легко", value: "easy" },
  { label: "Средне", value: "medium" },
  { label: "Сложно", value: "hard" },
];

const categoryNav = [
  { label: "Все", value: "" },
  { label: "Завтраки", value: "breakfast" },
  { label: "Обеды", value: "lunch" },
  { label: "Ужины", value: "dinner" },
  { label: "Выпечка", value: "bakery" },
];

const searchPreserve: Record<string, string> = {};
if (categoryLegacy) searchPreserve.category = categoryLegacy;
if (difficultyFilter && difficultyFilter !== "all") searchPreserve.difficulty = difficultyFilter;
---

<Layout title="Все рецепты — Рецепты Дома">
  <div class="mx-auto max-w-6xl px-4">
    <header class="border-line mb-12 border-b py-10 md:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <nav class="text-text-muted mb-4 flex items-center gap-2 text-sm">
            <a href="/" class="hover:text-brand transition-colors">Главная</a>
            <Icon name="lucide:chevron-right" class="h-4 w-4" />
            <span class="text-text-main font-medium">Все рецепты</span>
          </nav>
          <h1 class="text-text-main text-4xl font-bold md:text-5xl">
            Наша <span class="text-brand">коллекция</span>
          </h1>
          <p class="text-text-muted mt-4 text-lg">
            Найдено {filteredRecipes.length} из {allRecipes.length} рецептов
          </p>
        </div>

        <div class="w-full md:w-96">
          <SearchBar preserveParams={searchPreserve} initialQuery={qRaw} />
        </div>
      </div>
    </header>

    <div class="flex flex-col gap-12 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-64">
        <div class="sticky top-24">
          <h2 class="text-text-main mb-6 flex items-center gap-2 text-xl font-bold">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" />
            Фильтры
          </h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Категория</h3>
              <ul class="space-y-2" id="category-filters">
                {
                  categoryNav.map((c) => (
                    <li>
                      <a
                        href={c.value === "" ? recipesHref({ category: undefined, categoryId: undefined }) : recipesHref({ category: c.value, categoryId: undefined })}
                        aria-current={categoryLegacy === c.value || (c.value === "" && !categoryLegacy) ? "page" : undefined}
                        class:list={[
                          "hover:bg-brand/10 hover:text-brand block rounded-lg px-3 py-2 text-sm transition-colors",
                          categoryLegacy === c.value || (c.value === "" && !categoryLegacy) ? "bg-brand/10 text-brand font-semibold" : "text-text-muted",
                        ]}
                      >
                        {c.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
              <div class="flex flex-wrap gap-2" id="difficulty-filters">
                {
                  difficultyMap.map((diff) => (
                    <a
                      href={diff.value === "all" ? recipesHref({ difficulty: undefined }) : recipesHref({ difficulty: diff.value })}
                      aria-current={difficultyFilter === diff.value || (diff.value === "all" && !difficultyFilter) ? "page" : undefined}
                      class:list={[
                        "border-line hover:border-brand hover:text-brand rounded-full border px-4 py-1 text-xs font-medium transition-colors",
                        difficultyFilter === diff.value || (diff.value === "all" && !difficultyFilter)
                          ? "border-brand text-brand font-bold"
                          : "text-text-muted",
                      ]}
                    >
                      {diff.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </aside>

      <main class="grow">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {filteredRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>

        {
          allRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Ничего не нашли</h3>
              <p class="text-text-muted mt-2">Попробуй изменить параметры поиска или категорию</p>
            </div>
          )
        }

        {
          allRecipes.length > 0 && filteredRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Нет рецептов по выбранным условиям</h3>
              <p class="text-text-muted mt-2">Сбросьте фильтры или измените запрос в поиске.</p>
              <a href={recipesHref({ category: undefined, difficulty: undefined, q: undefined })} class="text-brand mt-6 inline-block font-semibold hover:underline">
                Показать все рецепты
              </a>
            </div>
          )
        }
      </main>
    </div>
  </div>
</Layout>
