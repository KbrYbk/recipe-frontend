---
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import SearchBar from "../components/SearchBar.astro";
import { Icon } from "astro-icon/components";

import type { Recipe } from "../types/recipe";

const raw = await import.meta.glob("../data/recipes.json", { eager: true })["../data/recipes.json"];
const allRecipes: Recipe[] = (raw as any)?.default ?? [];

---

<Layout title="Все рецепты — Рецепты Дома">
  <div class="mx-auto max-w-6xl px-4">
    <header class="border-line mb-12 border-b py-10 md:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <nav class="text-text-muted mb-4 flex items-center gap-2 text-sm">
            <a href="/" class="hover:text-brand transition-colors">Главная</a>
            <Icon name="lucide:chevron-right" class="h-4 w-4" />
            <span class="text-text-main font-medium">Все рецепты</span>
          </nav>
          <h1 class="text-text-main text-4xl font-bold md:text-5xl">
            Наша <span class="text-brand">коллекция</span>
          </h1>
          <p class="text-text-muted mt-4 text-lg">
            Найдено {allRecipes.length} потрясающих блюд
          </p>
        </div>

        <div class="w-full md:w-96">
          <SearchBar />
        </div>
      </div>
    </header>

    <div class="flex flex-col gap-12 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-64">
        <div class="sticky top-24">
          <h2 class="text-text-main mb-6 flex items-center gap-2 text-xl font-bold">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" />
            Фильтры
          </h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Категория</h3>
              <ul class="space-y-2" id="category-filters">
                <li>
                  <a href=href="/recipes" class="text-text-muted hover:bg-brand/10 hover:text-brand block rounded-lg px-3 py-2 text-sm transition-colors"> Все </a>
                </li>
                <li>
                  <a href="/recipes?category=breakfast" class="text-text-muted hover:bg-brand/10 hover:text-brand block rounded-lg px-3 py-2 text-sm transition-colors"> Завтраки </a>
                </li>
                <li>
                  <a href="/recipes?category=lunch" class="text-text-muted hover:bg-brand/10 hover:text-brand block rounded-lg px-3 py-2 text-sm transition-colors"> Обеды </a>
                </li>
                <li>
                  <a href="/recipes?category=dinner" class="text-text-muted hover:bg-brand/10 hover:text-brand block rounded-lg px-3 py-2 text-sm transition-colors"> Ужины </a>
                </li>
                <li>
                  <a href="/recipes?category=bakery" class="text-text-muted hover:bg-brand/10 hover:text-brand block rounded-lg px-3 py-2 text-sm transition-colors"> Выпечка </a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
              <div class="flex flex-wrap gap-2" id="difficulty-filters">
                {
                  ["Все", "Легко", "Средне", "Сложно"].map((diff) => (
                    <a
                      href={diff === "Все" ? "/recipes" : `/recipes?difficulty=${diff}`}
                      class="border-line text-text-muted hover:border-brand hover:text-brand rounded-full border px-4 py-1 text-xs font-medium transition-colors"
                    >
                      {diff}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </aside>

      <main class="grow">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {allRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>

        {
          allRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Ничего не нашли</h3>
              <p class="text-text-muted mt-2">Попробуй изменить параметры поиска или категорию</p>
            </div>
          )
        }
      </main>
    </div>
  </div>
</Layout>
