---
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import SearchBar from "../components/SearchBar.astro";
import { Icon } from "astro-icon/components";

import type { Recipe } from "../types/recipe";

const raw = await import.meta.glob("../data/recipes.json", { eager: true })["../data/recipes.json"];
const allRecipes: Recipe[] = (raw as any)?.default ?? [];

const categories = ["Все", ...new Set(allRecipes.map((r) => r.category).filter(Boolean))];
---

<Layout title="Все рецепты — Рецепты Дома">
  <div class="mx-auto max-w-6xl px-4">
    <header class="border-line mb-12 border-b py-10 md:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <nav class="text-text-muted mb-4 flex items-center gap-2 text-sm">
            <a href="/" class="hover:text-brand transition-colors">Главная</a>
            <Icon name="lucide:chevron-right" class="h-4 w-4" />
            <span class="text-text-main font-medium">Все рецепты</span>
          </nav>
          <h1 class="text-text-main text-4xl font-bold md:text-5xl">
            Наша <span class="text-brand">коллекция</span>
          </h1>
          <p class="text-text-muted mt-4 text-lg">
            Найдено {allRecipes.length} потрясающих блюд
          </p>
        </div>

        <div class="w-full md:w-96">
          <SearchBar />
        </div>
      </div>
    </header>

    <div class="flex flex-col gap-12 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-64">
        <div class="sticky top-24">
          <h2 class="text-text-main mb-6 flex items-center gap-2 text-xl font-bold">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" />
            Фильтры
          </h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Категория</h3>
              <ul class="space-y-2" id="category-filters">
                <li>
                  <button class="filter-btn active bg-brand flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-sm text-white transition-colors" data-category="all">
                    Все
                  </button>
                </li>
                <li>
                  <button
                    class="filter-btn text-text-muted hover:bg-brand/10 flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-sm transition-colors"
                    data-category="breakfast"
                  >
                    Завтраки
                  </button>
                </li>
                <li>
                  <button class="filter-btn text-text-muted hover:bg-brand/10 flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-sm transition-colors" data-category="lunch">
                    Обеды
                  </button>
                </li>
                <li>
                  <button class="filter-btn text-text-muted hover:bg-brand/10 flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-sm transition-colors" data-category="dinner">
                    Ужины
                  </button>
                </li>
                <li>
                  <button class="filter-btn text-text-muted hover:bg-brand/10 flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-sm transition-colors" data-category="bakery">
                    Выпечка
                  </button>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
              <div class="flex flex-wrap gap-2">
                {
                  ["Легко", "Средне", "Сложно"].map((diff) => (
                    <button class="border-line text-text-muted hover:border-brand hover:text-brand rounded-full border px-4 py-1 text-xs font-medium">{diff}</button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </aside>

      <main class="grow">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {allRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>

        {
          allRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Ничего не нашли</h3>
              <p class="text-text-muted mt-2">Попробуй изменить параметры поиска</p>
            </div>
          )
        }
      </main>
    </div>
  </div>
</Layout>
<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const recipeCards = document.querySelectorAll('.group.block.w-full'); // Находим все обертки карточек

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');

      // 1. Управляем активным стилем кнопок
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-brand', 'text-white');
        btn.classList.add('text-text-muted');
      });
      button.classList.add('bg-brand', 'text-white');
      button.classList.remove('text-text-muted');

      // 2. Логика фильтрации карточек
      recipeCards.forEach(card => {
        // Нам нужно как-то понять категорию карточки. 
        // В идеале в RecipeCard.astro добавить data-category={recipe.category}
        // Но пока можно просто искать текст или добавить атрибут в компонент.
      });
    });
  });
</script>