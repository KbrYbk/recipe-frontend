---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import SearchBar from "../components/SearchBar.astro";
import Pagination from "../components/Pagination.astro";
import { Icon } from "astro-icon/components";
import localRecipes from "../data/recipes.json";
import { fetchRecipesFromApi, mapBackendRecipe, fetchCategoriesFromApi } from "../lib/api/recipes";

const url = Astro.url;
const qRaw = url.searchParams.get("q")?.trim() || "";
const categoryId = url.searchParams.get("categoryId")?.trim() || "";
const categoryLegacy = url.searchParams.get("category")?.trim() || "";
const difficultyFilter = url.searchParams.get("difficulty")?.trim() || "all";
const currentPage = parseInt(url.searchParams.get("page") || "1");

// 1. Параллельная загрузка (самый быстрый способ)
const [categoriesData, recipesData] = await Promise.all([
  fetchCategoriesFromApi(),
  fetchRecipesFromApi({
    search: qRaw,
    categoryId: categoryId || undefined,
    page: currentPage,
    difficulty: difficultyFilter,
  }),
]);

const { list, total, totalPages, ok } = recipesData;

// 2. Обработка бэкенд-рецептов + Legacy фильтр
let processedBackend = list.map(mapBackendRecipe);

if (categoryLegacy && !categoryId) {
  // Дофильтровываем на фронте только если это старый параметр и нет categoryId
  processedBackend = processedBackend.filter((r: any) => String(r.category || "").toLowerCase() === categoryLegacy.toLowerCase());
}

// 3. Умный Fallback на локальные данные
const processedLocal = localRecipes.map((r) => ({ ...r, id: `local-${r.id}` }));

// Условие: если бэк ответил с ошибкой ИЛИ он пустой (и это не результат поиска/фильтра)
const isBackendEmpty = !ok || (processedBackend.length === 0 && !qRaw && !categoryId && !categoryLegacy);
const allRecipes = isBackendEmpty ? processedLocal : processedBackend;

// 4. Фильтрация локальных данных (бэкенд уже отфильтрован в API)
const filteredRecipes = isBackendEmpty
  ? allRecipes.filter((r: any) => (difficultyFilter === "all" ? true : String(r.difficulty) === difficultyFilter))
  : allRecipes;

// 5. Универсальный хелпер ссылок
function recipesHref(overrides: Record<string, string | number | undefined>) {
  const p = new URLSearchParams(url.searchParams);
  Object.entries(overrides).forEach(([k, v]) => {
    if (v === undefined || v === "" || v === "all") p.delete(k);
    else p.set(k, String(v));
  });

  // При переходе на категорию или поиск - сбрасываем старый slug-фильтр
  if (overrides.categoryId || overrides.q) {
    p.delete("category");
  }

  // Сбрасываем страницу на 1 при изменении фильтров, если не указано иное
  if (!overrides.page) p.set("page", "1");
  const s = p.toString();
  return s ? `/recipes?${s}` : "/recipes";
}

const categories = categoriesData.filter((c: any) => c.title).slice(0, 20);
// Словарь для фильтров сложности (чтобы сопоставить API и UI)
const difficultyMap = [
  { label: "Все", value: "all" },
  { label: "Легко", value: "easy" },
  { label: "Средне", value: "medium" },
  { label: "Сложно", value: "hard" },
];
const jsonLdBreadcrumbs = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Главная",
      item: new URL("/", Astro.url.origin).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Рецепты",
      item: Astro.url.href,
    },
  ],
});
---

<Layout title="Все рецепты — Рецепты Дома">
  <script type="application/ld+json" set:html={jsonLdBreadcrumbs} slot="head" />
  <div class="mx-auto max-w-6xl px-4">
    <header class="border-line mb-12 border-b py-10 md:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <nav class="text-text-muted mb-4 flex items-center gap-2 text-sm">
            <a href="/" class="hover:text-brand transition-colors">Главная</a>
            <Icon name="lucide:chevron-right" class="h-4 w-4" />
            <span class="text-text-main font-medium">Все рецепты</span>
          </nav>
          <h1 class="text-text-main text-4xl font-bold md:text-5xl">
            Наша <span class="text-brand">коллекция</span>
          </h1>
          <p class="text-text-muted mt-4 text-lg">
            Показано {filteredRecipes.length} из {total} рецептов
          </p>
        </div>
        <div class="w-full md:w-96">
          <SearchBar initialQuery={qRaw} preserveParams={{ categoryId, difficulty: difficultyFilter }} />
        </div>
      </div>
    </header>

    <div class="flex flex-col gap-12 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-64">
        <div class="lg:sticky lg:top-24">
          <h2 class="text-text-main mb-6 flex items-center gap-2 text-xl font-bold">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" />
            Фильтры
          </h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Категории</h3>
              <ul class="space-y-2" id="category-filters">
                <li>
                  <a
                    href={recipesHref({ categoryId: undefined })}
                    class:list={[
                      "block rounded-lg px-3 py-2 transition-colors",
                      !categoryId && !categoryLegacy && "bg-brand/10 text-brand font-bold",
                    ]}
                  >
                    Все
                  </a>
                </li>

                {
                  categories.map((c: any) => (
                    <li>
                      <a
                        href={recipesHref({ categoryId: c.id })}
                        class:list={[
                          "hover:bg-brand/5 block rounded-lg px-3 py-2 transition-colors",
                          String(categoryId) === String(c.id) && "bg-brand/10 text-brand font-bold",
                        ]}
                      >
                        {c.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
              <div class="flex flex-wrap gap-2" id="difficulty-filters">
                {
                  difficultyMap.map((d) => (
                    <a
                      href={recipesHref({ difficulty: d.value })}
                      class:list={[
                        "rounded-full border px-4 py-1 text-xs transition-all",
                        difficultyFilter === d.value ? "border-brand text-brand bg-brand/5" : "border-line text-text-muted",
                      ]}
                    >
                      {d.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </aside>

      <div class="grow">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {filteredRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>

        {
          allRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Ничего не нашли</h3>
              <p class="text-text-muted mt-2">Попробуй изменить параметры поиска или категорию</p>
            </div>
          )
        }

        {
          allRecipes.length > 0 && filteredRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Нет рецептов по выбранным условиям</h3>
              <p class="text-text-muted mt-2">Сбросьте фильтры или измените запрос в поиске.</p>
              <a href="/recipes" class="text-brand mt-6 inline-block font-semibold hover:underline">
                Показать все рецепты
              </a>
            </div>
          )
        }

        {
          totalPages > 1 && filteredRecipes.length > 0 && (
            <div class="mt-12">
              <Pagination currentPage={currentPage} totalPages={totalPages} baseUrlFunc={(p) => recipesHref({ page: p })} />
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
