---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import SearchBar from "../components/SearchBar.astro";
import Pagination from "../components/Pagination.astro";
import { Icon } from "astro-icon/components";
import localRecipes from "../data/recipes.json";
import { fetchRecipesFromApi, mapBackendRecipe, fetchCategoriesFromApi } from "../lib/api/recipes";

const url = Astro.url;
const qRaw = url.searchParams.get("q")?.trim() || "";
const categoryId = url.searchParams.get("categoryId")?.trim() || ""; // categoryId from URL, for display/highlighting
const categoryLegacy = url.searchParams.get("category")?.trim() || "";
// effectiveCategoryId is used for actual filtering/fetching. It's cleared if qRaw is present.
const effectiveCategoryId = qRaw ? "" : categoryId;
const difficultyFilter = url.searchParams.get("difficulty")?.trim() || "all";
const currentPage = parseInt(url.searchParams.get("page") || "1");

// 1. Параллельная загрузка (самый быстрый способ)
const [categoriesData, recipesData] = await Promise.all([
  fetchCategoriesFromApi(),
  fetchRecipesFromApi({
    search: qRaw,
    categoryId: categoryId || undefined,
    page: currentPage,
    difficulty: difficultyFilter,
  }),
]);

const { list, total: apiTotal = 0, ok: apiOk } = recipesData;
const perPage = 20; // Стандарт пагинации из API

// 2. Обработка бэкенд-рецептов
let processedBackend = list.map(mapBackendRecipe);

if (categoryLegacy && !categoryId) {
  processedBackend = processedBackend.filter((r: any) => String(r.category || "").toLowerCase() === categoryLegacy.toLowerCase());
}

// 3. Фильтрация локальных данных
const filteredLocalFull = localRecipes
  .filter((r) => {
    if (qRaw && !r.title.toLowerCase().includes(qRaw.toLowerCase()) && !r.description.toLowerCase().includes(qRaw.toLowerCase())) {
      return false;
    }
    if (categoryId && String(r.category_id) !== String(categoryId)) {
      return false;
    }
    if (difficultyFilter !== "all" && r.difficulty !== difficultyFilter) {
      return false;
    }
    return true;
  })
  .map((r) => ({ ...r, id: `local-${r.id}` }));

// 4. Умная пагинация объединенных данных
// Считаем, сколько локальных рецептов нам нужно добавить на ТЕКУЩУЮ страницу
const apiTotalLoadedSoFar = (currentPage - 1) * perPage + processedBackend.length;
const totalNeededOnPage = perPage;
const spaceForLocal = Math.max(0, totalNeededOnPage - processedBackend.length);

// Сколько локальных рецептов УЖЕ было показано на прошлых страницах?
// (Если apiTotal меньше, чем (currentPage-1)*perPage, значит часть локальных уже ушла в прошлые страницы)
const localAlreadyShownCount = Math.max(0, (currentPage - 1) * perPage - apiTotal);
const localSlice = filteredLocalFull.slice(localAlreadyShownCount, localAlreadyShownCount + spaceForLocal);

const filteredRecipes = [...processedBackend, ...localSlice];
const finalTotal = apiTotal + filteredLocalFull.length;
const finalTotalPages = Math.ceil(finalTotal / perPage);

// 5. Универсальный хелпер ссылок
function recipesHref(overrides: Record<string, string | number | undefined>) {
  const p = new URLSearchParams(url.searchParams);
  Object.entries(overrides).forEach(([k, v]) => {
    if (v === undefined || v === "" || v === "all") p.delete(k);
    else p.set(k, String(v));
  });

  if (overrides.categoryId || overrides.q) {
    p.delete("category");
  }

  if (!overrides.page) p.set("page", "1");
  const s = p.toString();
  return s ? `/recipes?${s}` : "/recipes";
}

const categories = categoriesData.filter((c: any) => c.title).slice(0, 20);
const difficultyMap = [
  { label: "Все", value: "all" },
  { label: "Легко", value: "easy" },
  { label: "Средне", value: "medium" },
  { label: "Сложно", value: "hard" },
];

const jsonLdBreadcrumbs = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: new URL("/", Astro.url.origin).href },
    { "@type": "ListItem", position: 2, name: "Рецепты", item: Astro.url.href },
  ],
});
---

<Layout title="Все рецепты — SwagEda" description="Огромная коллекция кулинарных рецептов на любой вкус: от простых завтраков до изысканных ужинов. Фильтруйте по категориям и сложности в каталоге SwagEda.">
  <script type="application/ld+json" set:html={jsonLdBreadcrumbs} slot="head" />
  <div class="mx-auto max-w-6xl px-4">
    <header class="border-line mb-12 border-b py-10 md:py-16">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <nav class="text-text-muted mb-4 flex items-center gap-2 text-sm">
            <a href="/" class="hover:text-brand transition-colors">Главная</a>
            <Icon name="lucide:chevron-right" class="h-4 w-4" />
            <span class="text-text-main font-medium">Все рецепты</span>
          </nav>
          <h1 class="text-text-main text-4xl font-bold md:text-5xl">
            Наша <span class="text-brand">коллекция</span>
          </h1>
          <p class="text-text-muted mt-4 text-lg">
            Показано {filteredRecipes.length} из {finalTotal} рецептов
          </p>
        </div>
        <div class="w-full md:w-96">
          <SearchBar initialQuery={qRaw} preserveParams={{ difficulty: difficultyFilter }} />
        </div>
      </div>
    </header>

    <div class="flex flex-col gap-12 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-64">
        <div class="lg:sticky lg:top-24">
          <h2 class="text-text-main mb-6 flex items-center gap-2 text-xl font-bold">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" />
            Фильтры
          </h2>

          <div class="space-y-8">
            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Категории</h3>
              <ul class="space-y-2" id="category-filters">
                <li>
                  <a href={recipesHref({ categoryId: undefined })} class:list={["block rounded-lg px-3 py-2 transition-colors", !categoryId && !categoryLegacy && "bg-brand/10 text-brand font-bold"]}>
                    Все
                  </a>
                </li>
                {
                  categories.map((c: any) => (
                    <li>
                      <a
                        href={recipesHref({ categoryId: c.id })}
                        class:list={["hover:bg-brand/5 block rounded-lg px-3 py-2 transition-colors", String(categoryId) === String(c.id) && "bg-brand/10 text-brand font-bold"]}
                      >
                        {c.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="text-text-muted mb-4 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
              <div class="flex flex-wrap gap-2" id="difficulty-filters">
                {
                  difficultyMap.map((d) => (
                    <a
                      href={recipesHref({ difficulty: d.value })}
                      class:list={["rounded-full border px-4 py-1 text-xs transition-all", difficultyFilter === d.value ? "border-brand text-brand bg-brand/5" : "border-line text-text-muted"]}
                    >
                      {d.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </aside>

      <div class="grow">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          {filteredRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>

        {
          filteredRecipes.length === 0 && (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h3 class="text-text-main text-xl font-bold">Ничего не нашли</h3>
              <p class="text-text-muted mt-2">Попробуй изменить параметры поиска или категорию</p>
              {(qRaw || categoryId || difficultyFilter !== "all") && (
                <a href="/recipes" class="text-brand mt-6 inline-block font-semibold hover:underline">
                  Сбросить фильтры
                </a>
              )}
            </div>
          )
        }

        {
          finalTotalPages > 1 && filteredRecipes.length > 0 && (
            <div class="mt-12">
              <Pagination currentPage={currentPage} totalPages={finalTotalPages} baseUrlFunc={(p) => recipesHref({ page: p })} />
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
