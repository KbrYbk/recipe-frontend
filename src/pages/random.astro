---
import { getRecipeUrl } from "../lib/slugify";
import { fetchRecipesFromApi } from "../lib/api/recipes";

const TOTAL_TTL_MS = 5 * 60 * 1000;
let totalCache: { value: number; expires: number } | null = null;

async function getDbTotal(): Promise<{ total: number; ok: boolean }> {
  const now = Date.now();
  if (totalCache && totalCache.expires > now) {
    return { total: totalCache.value, ok: true };
  }
  const res = await fetchRecipesFromApi({ page: 1 });
  if (res.ok && res.total > 0) {
    totalCache = { value: res.total, expires: now + TOTAL_TTL_MS };
  }
  return { total: res.total, ok: res.ok };
}

const { total: dbTotal, ok } = await getDbTotal();

if (!ok || dbTotal === 0) {
  return Astro.redirect("/");
}

const perPage = 20;
const totalPages = Math.max(1, Math.ceil(dbTotal / perPage));
const randomPage = Math.floor(Math.random() * totalPages) + 1;

const { list } = await fetchRecipesFromApi({ page: randomPage });

if (!list || list.length === 0) {
  const { list: fallbackList } = await fetchRecipesFromApi({ page: 1 });
  if (fallbackList && fallbackList.length > 0) {
    return Astro.redirect(getRecipeUrl(fallbackList[Math.floor(Math.random() * fallbackList.length)]));
  }
  return Astro.redirect("/recipes");
}

return Astro.redirect(getRecipeUrl(list[Math.floor(Math.random() * list.length)]));
---
