---
/** «Удиви меня»: редирект на случайный рецепт со случайной страницы каталога. Не кэшируется. */
import { fetchRecipeList, fetchRecipesTotal } from "../lib/api/recipes";
import { DEFAULT_QUERY } from "../lib/catalog";
import { PER_PAGE } from "../lib/api/map";

const total = await fetchRecipesTotal();
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const page = Math.floor(Math.random() * totalPages) + 1;

let res = await fetchRecipeList({ ...DEFAULT_QUERY, page });
if (!res.ok || res.data.list.length === 0) res = await fetchRecipeList(DEFAULT_QUERY);

if (!res.ok || res.data.list.length === 0) return Astro.redirect("/recipes", 302);

const pick = res.data.list[Math.floor(Math.random() * res.data.list.length)];
return Astro.redirect(pick.url, 302);
---
