---
const { videoUrl } = Astro.props;
import { Icon } from "astro-icon/components";
---

{
  videoUrl && (
    <div class="video-section mb-10 no-print">
      <div class="bg-page-bg border-line mb-6 flex max-w-70 rounded-xl border p-1">
        <button id="showText" class="tab-btn active-tab flex flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-bold transition-all">
          <Icon name="lucide:file-text" class="h-4 w-4" /> Текст
        </button>
        <button id="showVideo" class="tab-btn text-text-muted hover:text-text-main flex flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-bold transition-all">
          <Icon name="lucide:play-circle" class="h-4 w-4" /> Видео
        </button>
      </div>

      <div id="videoContainer" class="border-line hidden aspect-video overflow-hidden rounded-4xl border bg-black shadow-2xl">
        <iframe width="100%" height="100%" src={videoUrl} allowfullscreen class="border-0" />
      </div>
    </div>
  )
}

<script>
  function initVideoTabs() {
    const showTextBtn = document.getElementById("showText");
    const showVideoBtn = document.getElementById("showVideo");
    const videoContainer = document.getElementById("videoContainer");
    const textSteps = document.getElementById("textSteps");

    if (!showTextBtn || !showVideoBtn || !videoContainer || !textSteps) return;

    const setActive = (isVideo: boolean) => {
      // 1. Управляем видимостью контента
      videoContainer.classList.toggle("hidden", !isVideo);
      textSteps.classList.toggle("hidden", isVideo);

      // 2. Управляем классами кнопок
      if (isVideo) {
        showVideoBtn.classList.add("active-tab");
        showVideoBtn.classList.remove("text-text-muted");

        showTextBtn.classList.remove("active-tab");
        showTextBtn.classList.add("text-text-muted");
      } else {
        showTextBtn.classList.add("active-tab");
        showTextBtn.classList.remove("text-text-muted");

        showVideoBtn.classList.remove("active-tab");
        showVideoBtn.classList.add("text-text-muted");
      }
    };

    showVideoBtn.addEventListener("click", () => setActive(true));
    showTextBtn.addEventListener("click", () => setActive(false));
  }

  // Инициализация
  initVideoTabs();
  document.addEventListener("astro:after-swap", initVideoTabs);
</script>
