---
import { Icon } from "astro-icon/components";
const currentYear = new Date().getFullYear();
---

<footer class="border-line bg-card-bg print:hidden mt-20 border-t transition-colors">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-4">
      <!-- Колонки 1-2: Описание проекта -->
      <div class="md:col-span-2">
        <a href="/" class="text-brand mb-4 flex items-center gap-2 text-2xl font-bold" aria-label="SwagEda — на главную">
          <img src="/favicon.svg" alt="" class="h-7 w-7" aria-hidden="true" />
          SwagEda
        </a>
        <p class="text-text-muted max-w-md leading-relaxed">
          Твой уютный уголок с проверенными рецептами. Готовим просто, едим вкусно, делимся с любовью. Присоединяйся к нашему кулинарному сообществу!
        </p>
      </div>

      <!-- Колонка 3: Навигация -->
      <nav aria-labelledby="footer-nav-heading">
        <h3 id="footer-nav-heading" class="text-text-main mb-4 text-sm font-bold tracking-wider uppercase">Карта сайта</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-text-muted hover:text-brand font-medium transition-colors">Главная</a></li>
          <li><a href="/recipes" class="text-text-muted hover:text-brand font-medium transition-colors">Все рецепты</a></li>
          <li><a href="/privacy" class="text-text-muted hover:text-brand font-medium transition-colors">Политика конфиденциальности</a></li>
          <li><a href="/about" class="text-text-muted hover:text-brand font-medium transition-colors">О проекте</a></li>
          <li><a href="/contacts" class="text-text-muted hover:text-brand font-medium transition-colors">Контакты</a></li>
        </ul>
      </nav>

