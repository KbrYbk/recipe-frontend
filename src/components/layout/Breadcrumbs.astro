---
import { Icon } from "astro-icon/components";

interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /** plain — строка без подложки (первый экран рецепта); по умолчанию — плашка. */
  variant?: "pill" | "plain";
}

const { items, variant = "pill" } = Astro.props;

// 1. Более надежное получение origin
const siteOrigin = Astro.site?.origin || "https://swageda.ru";
const safeOrigin = siteOrigin.replace(/\/$/, "");

// 2. Формируем список элементов, включая "Главную", для SEO
// Яндекс и Google любят, когда "Главная" тоже есть в JSON-LD
const fullItems = [{ name: "Главная", href: "/" }, ...items];

const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: fullItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    // Используем URL constructor для гарантии абсолютного пути
    item: new URL(item.href || "", safeOrigin).href,
  })),
};

const jsonLd = JSON.stringify(breadcrumbList).replace(/</g, "\\u003c").replace(/>/g, "\\u003e");
---

<script type="application/ld+json" set:html={jsonLd} is:inline />

<nav
  aria-label="Хлебные крошки"
  class:list={[
    "text-text-muted flex flex-wrap items-center text-sm print:hidden",
    variant === "plain" ? "gap-x-2 gap-y-1" : "glass-border-3d bg-card-bg/60 mb-6 w-fit gap-2 rounded-2xl px-4 py-2 shadow-sm shadow-black/15 backdrop-blur-md",
  ]}
>
  <a href="/" class="hover:text-brand flex items-center transition-colors" aria-label="Главная">
    <Icon name="lucide:home" class="h-4 w-4" />
  </a>

  {
    items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <>
          <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 shrink-0 opacity-50" aria-hidden="true" />
          {isLast ? (
            <span class="text-text-main font-bold" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="hover:text-brand transition-colors">
              {item.name}
            </a>
          )}
        </>
      );
    })
  }
</nav>
