---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
};
---

<nav class="fixed bottom-4 left-4 right-4 z-50 flex h-16 items-center justify-around rounded-3xl glass-border-3d bg-card-bg/70 px-2 shadow-xl shadow-black/15 backdrop-blur-md md:hidden print:hidden">
  <a 
    href="/" 
    class={`flex flex-col items-center justify-center gap-1 transition-colors ${isActive("/") ? "text-brand" : "text-text-muted"} hover:text-brand active:text-brand`}
    aria-label="Главная"
  >
    <Icon name="lucide:home" class="h-6 w-6" />
    <span class="text-[10px] font-medium">Главная</span>
  </a>

  <a 
    href="/recipes" 
    class={`flex flex-col items-center justify-center gap-1 transition-colors ${isActive("/recipes") ? "text-brand" : "text-text-muted"} hover:text-brand active:text-brand`}
    aria-label="Рецепты"
  >
    <Icon name="lucide:cooking-pot" class="h-6 w-6" />
    <span class="text-[10px] font-medium">Рецепты</span>
  </a>

  <a 
    href="/recipes?action=search" 
    class={`flex flex-col items-center justify-center gap-1 transition-colors ${Astro.url.searchParams.get("action") === "search" ? "text-brand" : "text-text-muted"} hover:text-brand active:text-brand`}
    aria-label="Поиск"
  >
    <Icon name="lucide:search" class="h-6 w-6" />
    <span class="text-[10px] font-medium">Поиск</span>
  </a>

  <a 
    href="/random" 
    class={`flex flex-col items-center justify-center gap-1 transition-colors ${isActive("/random") ? "text-brand" : "text-text-muted"} hover:text-brand active:text-brand`}
    aria-label="Показать случайный рецепт"
  >
    <Icon name="lucide:dices" class="h-6 w-6" />
    <span class="text-[10px] font-medium">Выручай</span>
  </a>

  <a 
    href="/favorites" 
    class={`flex flex-col items-center justify-center gap-1 transition-colors ${isActive("/favorites") ? "text-brand" : "text-text-muted"} hover:text-brand active:text-brand`}
    aria-label="Избранное"
  >
    <Icon name="lucide:heart" class="h-6 w-6" />
    <span class="text-[10px] font-medium">Избранное</span>
  </a>
</nav>

<style>
  nav {
    /* Добавляем safe-area не внутрь (padding), а снаружи (bottom), чтобы не ломать выравнивание (items-center) */
    bottom: calc(1rem + env(safe-area-inset-bottom));
  }
</style>
