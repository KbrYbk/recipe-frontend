---
import { Icon } from "astro-icon/components";
import { navSection, type NavSection } from "../../lib/nav";

const section = navSection(Astro.url.pathname, Astro.url.searchParams);
const items: { href: string; label: string; icon: string; key: NavSection; short?: string; extra?: Record<string, string> }[] = [
  { href: "/", label: "Главная", icon: "lucide:home", key: "home" },
  { href: "/recipes", label: "Рецепты", icon: "lucide:cooking-pot", key: "recipes" },
  { href: "/recipes?action=search", label: "Поиск", icon: "lucide:search", key: "search", extra: { "data-bottom-search": "" } },
  { href: "/random", label: "Удиви меня", short: "Удиви", icon: "lucide:dices", key: "random" },
  { href: "/favorites", label: "Избранное", icon: "lucide:heart", key: "favorites" },
];
---

<nav
  class="glass-border-3d bg-card-bg/70 rounded-panel shadow-float fixed right-4 bottom-4 left-4 z-50 flex h-16 items-center justify-around px-1 backdrop-blur-md md:hidden print:hidden"
  aria-label="Нижняя навигация"
>
  {
    items.map((item) => {
      const active = section === item.key;
      return (
        <a
          href={item.href}
          class={`rounded-card flex min-h-12 min-w-0 flex-1 flex-col items-center justify-center gap-1 transition-colors ${active ? "text-brand-ink" : "text-text-muted"} hover:text-brand-ink active:text-brand-ink`}
          aria-current={active ? "page" : undefined}
          {...item.extra}
        >
          <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
          <span class={`max-w-full truncate px-0.5 text-[10px] ${active ? "font-semibold" : "font-medium"}`}>
            {item.short ? (
              <>
                <span class="min-[360px]:hidden">{item.short}</span>
                <span class="hidden min-[360px]:inline">{item.label}</span>
              </>
            ) : (
              item.label
            )}
          </span>
        </a>
      );
    })
  }
</nav>

<style>
  nav {
    /* Добавляем safe-area не внутрь (padding), а снаружи (bottom), чтобы не ломать выравнивание (items-center) */
    bottom: calc(1rem + env(safe-area-inset-bottom));
  }
</style>

<script>
  // «Поиск»: если на странице уже есть поле поиска — сфокусировать его, а не переходить.
  document.querySelector<HTMLAnchorElement>("[data-bottom-search]")?.addEventListener("click", (e) => {
    const input = Array.from(document.querySelectorAll<HTMLInputElement>("input[data-search-input]")).find((el) => el.offsetParent !== null);
    if (!input) return;
    e.preventDefault();
    input.scrollIntoView({ block: "center", behavior: "smooth" });
    input.focus({ preventScroll: true });
  });
</script>
