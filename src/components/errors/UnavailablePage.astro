---
/** Полная страница «сервис временно недоступен». Статус 503 выставляет вызывающая страница. */
import Layout from "../../layouts/Layout.astro";
import BackendErrorAlert from "./BackendErrorAlert.astro";
---

<Layout title="Сайт временно недоступен — SwagEda" description="Сайт временно недоступен. Попробуйте обновить страницу через минуту." noindex>
  <div class="mx-auto max-w-2xl px-4 py-8">
    <BackendErrorAlert />
    <div class="text-center">
      <a href="" class="text-brand-ink font-semibold hover:underline">Обновить страницу</a>
    </div>
  </div>
</Layout>
