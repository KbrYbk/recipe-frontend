---
import { Icon } from "astro-icon/components";

interface Props {
  /** Текст ошибки, отображается в details для отладки */
  message?: string;
  /** Показывать ли раскрывающийся блок с тех. деталями */
  showDetails?: boolean;
}

const { message = "", showDetails = true } = Astro.props;
---

<section class="my-8 rounded-3xl border border-brand/15 bg-accent-soft p-6 shadow-sm md:p-8" role="alert" aria-live="polite">
  <div class="flex flex-col gap-6 md:flex-row md:items-center">
    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-brand">
      <Icon name="lucide:chef-hat" class="h-10 w-10 animate-pulse" aria-hidden="true" />
    </div>
    <div class="flex-grow">
      <h3 class="text-xl font-bold text-text-main md:text-2xl">
        Ой, временные трудности на кухне!
      </h3>
      <div class="mt-2 text-base text-text-muted leading-relaxed">
        <slot>Наш сайт сейчас испытывает небольшие технические неполадки. Мы уже вовсю «колдуем» над плитой и исправляем проблему — возвращайтесь совсем скоро.</slot>
      </div>

      {showDetails && message && (
        <details class="mt-4 border-t border-brand/10 pt-4 text-xs text-text-muted">
          <summary class="cursor-pointer font-medium transition-colors hover:text-brand focus:outline-none">
            Технические детали (для отладки)
          </summary>
          <div class="mt-2 rounded-xl bg-card-bg p-3 font-mono text-[11px] leading-relaxed break-all text-text-main border border-line">
            Код ошибки: {message}
          </div>
        </details>
      )}
    </div>
  </div>
</section>
