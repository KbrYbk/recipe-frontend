---
interface Props {
  /** Сохранять фильтры при отправке поиска (например category, difficulty). */
  preserveParams?: Record<string, string>;
  initialQuery?: string;
}

const { preserveParams = {}, initialQuery = "" } = Astro.props;
---

<div class="mx-auto max-w-3xl">
  <form action="/recipes" method="GET" role="search" class="flex flex-col gap-4 sm:flex-row">
    <input type="hidden" name="page" value="1" />
    {Object.entries(preserveParams).map(([name, value]) => (value ? <input type="hidden" name={name} value={value} /> : null))}
    <div class="relative flex-1">
      <input
        type="search"
        name="q"
        value={initialQuery}
        placeholder="Курица, картошка, суп..."
        class="bg-card-bg border-line text-text-main placeholder:text-text-muted focus:border-brand focus:ring-brand/20 w-full rounded-2xl border-2 px-6 py-4 text-lg transition-all focus:ring-4 focus:outline-none md:py-5 md:text-xl"
        aria-label="Поиск рецепта"
        autocomplete="off"
      />
    </div>

    <button type="submit" class="bg-brand hover:bg-brand-hover shadow-brand/20 min-w-40 rounded-2xl px-8 py-4 text-lg font-bold text-white shadow-lg transition-all active:scale-95 md:py-5 md:text-xl">
      Найти
    </button>
  </form>
</div>
