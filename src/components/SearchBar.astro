<div class="mx-auto max-w-3xl">
  <form role="search" class="flex flex-col gap-4 sm:flex-row">
    <input
      type="search"
      placeholder="Например: курица, картошка, суп..."
      class="focus:border-primary focus:ring-primary/20 flex-1 rounded-xl border-2 border-gray-300 px-6 py-5 text-xl focus:ring-4 focus:outline-none"
      aria-label="Поиск рецепта по названию или ингредиентам"
    />
    <button type="submit" class="bg-primary hover:bg-primary-dark min-w-[180px] rounded-xl px-10 py-5 text-xl font-medium text-white transition"> Найти рецепт </button>
  </form>
</div>
