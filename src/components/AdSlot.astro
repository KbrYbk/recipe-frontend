---
interface Props {
  id: string; // ID блока из личного кабинета РСЯ
  className?: string;
  style?: string;
  isFeed?: boolean; // Установите true, если это "Виджет рекомендаций" или "Лента"
}

const { id, className, style, isFeed = false } = Astro.props;

// Формируем уникальный ID контейнера
const uniqueSuffix = Math.random().toString(36).substr(2, 5);
const containerId = `yandex_rtb_${id.replace(/-/g, '_')}_${uniqueSuffix}`;
---

<div class:list={["ad-slot no-print my-4 mx-auto text-center", className]} style={style}>
  <div class="text-[10px] text-text-muted mb-1 uppercase tracking-widest opacity-50">Реклама</div>
  <div id={containerId} class="min-h-[100px]"></div>
</div>

<script is:inline define:vars={{ id, containerId, isFeed }}">
  (function() {
    // Защита от повторного рендера этого же экземпляра
    var _rendered = false;

    function renderAd() {
      var container = document.getElementById(containerId);
      if (!container) return;

      // Если контейнер уже содержит рекламу или процесс рендеринга
      if (container.children.length > 0 || container.dataset.rendering === "true") return;

      // Уже успешно отрендили — не повторяем
      if (_rendered) return;

      container.dataset.rendering = "true";

      window.yaContextCb = window.yaContextCb || [];
      window.yaContextCb.push(function() {
        if (window.Ya && window.Ya.Context && window.Ya.Context.AdvManager) {
          // isFeed приходит как строка "true" или "false" из define:vars
          var isFeedBlock = (isFeed === true || isFeed === "true");

          try {
            if (isFeedBlock && typeof window.Ya.Context.AdvManager.renderFeed === "function") {
              // Feed-блоки требуют отдельного метода renderFeed()
              window.Ya.Context.AdvManager.renderFeed({
                blockId: id,
                renderTo: containerId
              });
            } else {
              // Обычные баннеры
              window.Ya.Context.AdvManager.render({
                blockId: id,
                renderTo: containerId,
                async: true
              });
            }
            _rendered = true;
          } catch (e) {
            console.error("Yandex Ad Render Error [" + id + "]:", e);
            container.dataset.rendering = "false";
            _rendered = false;
            // Повторная попытка через 5 секунд
            setTimeout(renderAd, 5000);
          }
        } else {
          container.dataset.rendering = "false";
        }
      });
    }

    // Таймаут: если context.js не загрузился за 3 секунд — всё равно пытаемся рендерить
    // (yaContextCb вызовет колбэк когда догонит)
    var fallbackTimer = setTimeout(function() {
      var container = document.getElementById(containerId);
      if (container && container.children.length === 0 && container.dataset.rendering !== "true") {
        renderAd();
      }
    }, 3000);

    // IntersectionObserver для ленивой загрузки
    var observer = null;
    try {
      observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            clearTimeout(fallbackTimer);
            renderAd();
            observer.unobserve(entry.target);
          }
        });
      }, {
        rootMargin: '200px'
      });
    } catch(e) {
      // Fallback для старых браузеров — рендерим сразу
      clearTimeout(fallbackTimer);
      renderAd();
    }

    if (observer) {
      var el = document.getElementById(containerId);
      if (el) {
        observer.observe(el);
      }
    }

    // Поддержка Astro View Transitions — пере-обсервим после смены страницы
    document.addEventListener("astro:page-load", function() {
      var el = document.getElementById(containerId);
      if (el && observer) {
        observer.observe(el);
      }
    });
  })();
</script>

<style>
  .ad-slot {
    width: 100%;
    max-width: 100%;
  }
</style>
