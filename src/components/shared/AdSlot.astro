---
interface Props {
  id: string; // ID блока из личного кабинета РСЯ
  className?: string;
  style?: string;
  isFeed?: boolean; // Установите true, если это "Виджет рекомендаций" или "Лента"
  refreshInterval?: number;
}

const { id, className, style, isFeed = false, refreshInterval = 0 } = Astro.props;

// Формируем уникальный ID контейнера
const uniqueSuffix = Math.random().toString(36).substring(2, 7);
const containerId = `yandex_rtb_${id.replace(/-/g, "_")}_${uniqueSuffix}`;
---

<div class={["ad-slot print:hidden my-4 mx-auto text-center", className].filter(Boolean).join(" ")} style={style}>
  <div class="text-text-muted mb-1 text-[10px] tracking-widest uppercase opacity-50">Реклама</div>
  <div id={containerId} data-ad-slot={id} data-ad-feed={String(isFeed)} data-ad-refresh={String(refreshInterval)} class="min-h-25"></div>
</div>

<style>
  .ad-slot {
    width: 100%;
    max-width: 100%;
  }
</style>
