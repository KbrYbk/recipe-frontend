---
import { Icon } from "astro-icon/components";

interface Props {
  url: string;
  title: string;
  description: string;
  image?: string;
  icon?: string;
  buttonText?: string;
  erid?: string;
}

const { url, title, description, image, icon = "lucide:shopping-bag", buttonText = "Смотреть на Маркете", erid = "" } = Astro.props;
---

<a
  href={url}
  rel="sponsored"
  target="_blank"
  class="glass-border-3d group bg-brand/5 hover:bg-brand/10 @container relative flex flex-col overflow-hidden rounded-2xl p-6 shadow-sm shadow-black/15 transition-all hover:shadow-lg hover:shadow-black/20"
>
  <!-- Раскладка по ширине самой карточки (container queries): узко — столбец, шире — картинка | текст, совсем широко — картинка | текст | кнопка -->
  <div
    class="grid grid-cols-1 justify-items-center gap-4 text-center @md:grid-cols-[auto_minmax(0,1fr)] @md:items-center @md:justify-items-start @md:gap-x-6 @md:text-left @3xl:grid-cols-[auto_minmax(0,1fr)_auto]"
  >
    {
      image ? (
        <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-white shadow-inner transition-transform group-hover:scale-105">
          <img src={image} alt="Рекомендуемый товар" class="h-full w-full object-contain p-2" loading="lazy" />
        </div>
      ) : (
        <div class="bg-brand/20 text-brand flex h-16 w-16 shrink-0 items-center justify-center rounded-full transition-transform group-hover:scale-110">
          <Icon name={icon} class="h-8 w-8" />
        </div>
      )
    }
    <div class="min-w-0">
      <h3 class="text-text-main text-lg font-bold md:text-xl">{title}</h3>
      <p class="text-text-muted mt-2 text-sm md:text-base">{description}</p>
    </div>
    <div class="@md:col-start-2 @3xl:col-start-auto">
      <span class="bg-brand shadow-brand/20 hover:bg-brand-hover inline-flex items-center justify-center rounded-xl px-6 py-3 text-sm font-bold whitespace-nowrap text-white shadow-lg transition-all">
        {buttonText}
      </span>
    </div>
  </div>

  <div class="border-line/60 text-text-muted/70 mt-5 flex flex-wrap items-center justify-between gap-2 border-t pt-2.5 text-[11px]">
    <span>Реклама. ООО «Яндекс Маркет», ИНН 9704254424{erid ? ` • erid: ${erid}` : ""}</span>
    <span class="opacity-80">Маркет</span>
  </div>
</a>
