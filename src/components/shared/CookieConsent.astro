---
/**
 * Баннер о cookie (дизайн как в исходной версии сайта), только кнопка «Принято!».
 * Логика — src/scripts/consent.ts. Метрика от баннера не зависит.
 */
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
---

<div
  id="cookie-banner"
  class="glass-border-3d bg-card-bg/80 fixed bottom-6 left-6 z-50 hidden max-w-sm translate-y-10 rounded-3xl p-6 opacity-0 shadow-2xl shadow-black/20 backdrop-blur-md transition-all duration-500 md:bottom-8 md:left-8 print:hidden"
  role="alert"
  aria-live="polite"
>
  <div class="flex items-start gap-4">
    <div class="bg-brand/10 text-brand flex h-12 w-12 shrink-0 items-center justify-center rounded-full">
      <Icon name="lucide:cookie" class="h-6 w-6" aria-hidden="true" />
    </div>

    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <h3 class="text-text-main text-lg font-bold">Рецепты и Cookie</h3>
        <p class="text-text-muted text-sm leading-relaxed">
          Мы используем cookie, чтобы сайт стал вкуснее. Оставаясь с нами, вы соглашаетесь с нашей <a href="/privacy" class="text-brand underline underline-offset-2">политикой</a>.
        </p>
      </div>

      <Button data-consent-accept variant="primary" fullWidth class="px-5 py-3 text-sm">
        <Icon name="lucide:check" slot="icon-left" class="h-4 w-4 shrink-0" />
        Принято!
      </Button>
    </div>
  </div>
</div>
