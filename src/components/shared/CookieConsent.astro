---
/**
 * Баннер согласия на cookie и аналитику. Логика — src/scripts/consent.ts.
 * Мобильный: компактная полоса над нижней навигацией; десктоп: карточка в левом нижнем углу.
 */
---

<div
  id="cookie-banner"
  class="glass-border-3d bg-card-bg/95 fixed inset-x-3 bottom-[calc(5.5rem+env(safe-area-inset-bottom))] z-[60] hidden translate-y-4 rounded-2xl p-3 opacity-0 shadow-2xl shadow-black/20 backdrop-blur-md transition-all duration-300 md:inset-x-auto md:bottom-8 md:left-8 md:max-w-sm md:p-5 print:hidden"
  role="region"
  aria-label="Согласие на использование cookie"
>
  <p class="text-text-muted text-xs leading-snug md:text-sm md:leading-relaxed">
    Мы используем cookie и Яндекс Метрику, чтобы понимать, как улучшить сайт. Аналитика включится только с вашего согласия.
    <a href="/privacy#analytics" class="text-brand underline underline-offset-2">Подробнее</a>
  </p>
  <div class="mt-2 flex gap-2 md:mt-4">
    <button type="button" data-consent-reject class="glass-border-3d text-text-main hover:text-brand flex-1 cursor-pointer rounded-xl px-3 py-2 text-sm font-semibold transition-colors"
      >Отклонить</button
    >
    <button type="button" data-consent-accept class="bg-brand hover:bg-brand-hover flex-1 cursor-pointer rounded-xl px-3 py-2 text-sm font-bold text-white transition-colors">Принять</button>
  </div>
</div>
