---
import { Icon } from "astro-icon/components";
---

<div
  id="cookie-banner"
  class="bg-card-bg border-line fixed bottom-6 left-6 z-50 hidden max-w-sm translate-y-10 rounded-3xl border p-6 opacity-0 shadow-2xl transition-all duration-500 md:bottom-8 md:left-8"
  role="alert"
  aria-live="polite"
>
  <div class="flex items-start gap-4">
    <div class="bg-brand/10 text-brand flex h-12 w-12 shrink-0 items-center justify-center rounded-full">
      <Icon name="lucide:cookie" class="h-6 w-6" aria-hidden="true" />
    </div>

    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <h3 class="text-text-main text-lg font-bold">Рецепты и Cookie</h3>
        <p class="text-text-muted text-sm leading-relaxed">Мы используем cookie, чтобы сайт стал вкуснее. Оставаясь с нами, вы соглашаетесь с нашей политикой.</p>
      </div>

      <button
        id="accept-cookie"
        type="button"
        class="bg-brand hover:bg-brand-hover shadow-brand/20 flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-lg transition-all active:scale-95"
      >
        <Icon name="lucide:check" class="h-4 w-4" />
        Принято!
      </button>
    </div>
  </div>
</div>

<script is:inline>
  // Senior-way: Используем inline-скрипт, чтобы показать баннер мгновенно,
  // если согласия еще нет, избегая FOUC (Flash of Unconsented Content).

  function initCookieBanner() {
    const banner = document.getElementById("cookie-banner");
    const btn = document.getElementById("accept-cookie");
    const storageKey = "swageda:cookie-accepted";

    // 1. Проверяем, есть ли уже согласие
    if (localStorage.getItem(storageKey) === "true") {
      return; // Согласие есть, ничего не делаем
    }

    // 2. Если согласия нет, показываем баннер с анимацией
    // Добавляем классы анимации в следующем "тике" события, чтобы сработал transition
    requestAnimationFrame(() => {
      banner?.classList.remove("hidden", "translate-y-10", "opacity-0");
    });

    // 3. Обработка клика
    btn?.addEventListener(
      "click",
      () => {
        // Сохраняем выбор
        localStorage.setItem(storageKey, "true");

        // Скрываем баннер с анимацией
        banner?.classList.add("translate-y-10", "opacity-0");

        // Полностью удаляем из DOM после завершения анимации (500ms)
        setTimeout(() => {
          banner?.remove();
        }, 500);
      },
      { once: true },
    ); // Обработчик сработает только один раз
  }

  initCookieBanner();
</script>
