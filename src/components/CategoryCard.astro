---
import { Icon } from "astro-icon/components";

interface Props {
  iconName: string;
  title: string;
  href: string;
}

const { iconName, title, href } = Astro.props;
---

<a
  href={href}
  class="group glass-border-3d bg-card-bg/60 hover:bg-card-bg/80 flex flex-col items-center justify-center rounded-4xl p-6 shadow-md shadow-black/15 backdrop-blur-md transition-all hover:shadow-lg hover:shadow-black/20"
>
  <div class="bg-accent-soft text-brand group-hover:bg-brand mb-4 flex h-16 w-16 items-center justify-center rounded-2xl transition-all group-hover:text-white">
    <Icon name={iconName} class="h-8 w-8" aria-hidden="true" />
  </div>

  <span class="text-text-main group-hover:text-brand text-lg font-bold transition-colors">
    {title}
  </span>
</a>
