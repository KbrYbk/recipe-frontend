---
import { Icon } from "astro-icon/components";

interface Props {
  iconName: string;
  title: string;
  href: string;
}

const { iconName, title, href } = Astro.props;
---

<a
  href={href}
  class="group rounded-panel glass-border-3d bg-card-bg/60 shadow-soft hover:shadow-float hover:bg-card-bg/80 flex flex-col items-center justify-center p-6 backdrop-blur-md transition-all"
>
  <div class="rounded-card bg-accent-soft text-brand-ink group-hover:bg-brand group-hover:text-on-brand mb-4 flex h-16 w-16 items-center justify-center transition-all">
    <Icon name={iconName} class="h-8 w-8" aria-hidden="true" />
  </div>

  <span class="text-text-main group-hover:text-brand-ink text-lg font-semibold transition-colors">
    {title}
  </span>
</a>
