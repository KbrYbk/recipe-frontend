---
const { emoji, title, href } = Astro.props;
---

<a
  href={href}
  class="group focus:ring-primary block rounded-2xl bg-white p-6 text-center shadow transition hover:shadow-xl focus:ring-2 focus:ring-offset-2 focus:outline-none dark:bg-gray-800"
  aria-label={`Перейти в категорию ${title}`}
>
  <div class="mb-4 text-5xl" aria-hidden="true">{emoji}</div>
  <h3 class="group-hover:text-primary text-2xl font-semibold text-slate-900 transition-colors dark:text-gray-300">
    {title}
  </h3>
</a>
