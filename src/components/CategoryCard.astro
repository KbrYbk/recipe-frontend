---
import { Icon } from "astro-icon/components";

interface Props {
  iconName: string;
  title: string;
  href: string;
}

const { iconName, title, href } = Astro.props;
---

<a
  href={href}
  class="group pressable focus-ring glass-border-3d bg-card-bg rounded-card shadow-soft hover:bg-raised flex items-center gap-3 p-3 transition-[background-color,transform] duration-150 md:p-4"
>
  <div class="bg-accent-soft text-brand-ink rounded-control flex h-11 w-11 shrink-0 items-center justify-center">
    <Icon name={iconName} class="h-5 w-5" aria-hidden="true" />
  </div>

  <span class="text-text-main text-base font-semibold">
    {title}
  </span>
</a>
