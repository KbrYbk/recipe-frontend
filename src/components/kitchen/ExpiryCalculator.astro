---
/**
 * Калькулятор «съесть до»: дата приготовления или вскрытия + условие хранения → последняя безопасная дата.
 * Считает по нижней границе срока. Условия со сроком в часах (на столе) в калькулятор не попадают.
 */
import { Icon } from "astro-icon/components";
import Surface from "../ui/Surface.astro";
import { formatTerm, orderedConditions, placeOption } from "../../lib/kitchen/storage";
import type { StorageEntry } from "../../types/kitchen";

interface Props {
  entry: StorageEntry;
}

const { entry } = Astro.props;
const conditions = orderedConditions(entry).filter((c) => c.unit !== "h");
const payload = JSON.stringify(conditions.map((c) => ({ where: c.where, min: c.min, max: c.max, unit: c.unit })));
const fieldClass = "bg-page-bg text-text-main border-line focus:ring-brand/30 h-12 w-full rounded-card border px-4 text-base focus:ring-4 focus:outline-none";
---

{
  conditions.length > 0 && (
    <Surface as="section" padding="sm" aria-labelledby="expiry-heading" data-expiry-calculator data-conditions={payload}>
      <h2 id="expiry-heading" class="section-title text-text-main mb-5 flex items-center gap-2">
        <Icon name="lucide:calculator" class="text-brand-ink h-6 w-6 shrink-0" aria-hidden="true" />
        До какого числа съесть
      </h2>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="expiry-date" class="text-text-muted mb-1.5 block text-sm font-semibold">
            Дата приготовления или вскрытия
          </label>
          <input id="expiry-date" type="date" class={`${fieldClass} tabular-nums`} data-expiry-date />
        </div>
        <div>
          <label for="expiry-where" class="text-text-muted mb-1.5 block text-sm font-semibold">
            Где хранится
          </label>
          <select id="expiry-where" class={`${fieldClass} cursor-pointer`} data-expiry-where>
            {conditions.map((c) => (
              <option value={c.where}>
                {placeOption(c.where)} — {formatTerm(c)}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="mt-5" aria-live="polite">
        <p class="text-text-main text-2xl font-semibold tabular-nums md:text-3xl" data-expiry-title>
          Выберите дату
        </p>
        <p class="text-text-muted mt-1 leading-relaxed" data-expiry-detail>
          Калькулятор берёт нижнюю границу срока — так надёжнее.
        </p>
      </div>
    </Surface>
  )
}

<script>
  import "../../scripts/kitchen-expiry";
</script>
