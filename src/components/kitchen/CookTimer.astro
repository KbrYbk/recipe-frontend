---
/**
 * Таймер варки: выбирается строка таблицы (способ) и граница времени, дальше — обратный отсчёт.
 * Пока таймер идёт, экран не гаснет (Screen Wake Lock API, как в «Режиме готовки»).
 */
import { Icon } from "astro-icon/components";
import Surface from "../ui/Surface.astro";
import Button from "../ui/Button.astro";
import { formatClock, formatMinutes, methodLabel, timerSeconds } from "../../lib/kitchen/cooking";
import type { CookingEntry } from "../../types/kitchen";

interface Props {
  entry: CookingEntry;
}

const { entry } = Astro.props;
const methods = entry.methods.filter((m) => timerSeconds(m.minMin) !== null && timerSeconds(m.maxMin) !== null);
const first = methods[0];
const payload = JSON.stringify(methods.map((m) => ({ min: m.minMin, max: m.maxMin })));
const fieldClass = "bg-page-bg text-text-main border-line focus:ring-brand/30 h-12 w-full cursor-pointer rounded-2xl border px-4 text-base focus:ring-4 focus:outline-none";
const boundClass =
  "border-line text-text-main has-checked:border-brand has-checked:bg-accent-soft has-checked:text-brand has-focus-visible:ring-brand/30 flex h-12 flex-1 cursor-pointer items-center justify-center rounded-2xl border px-3 text-base font-semibold tabular-nums transition-colors has-focus-visible:ring-4";
---

{
  first && (
    <Surface as="section" padding="sm" aria-labelledby="cook-timer-heading" data-cook-timer data-methods={payload}>
      <h2 id="cook-timer-heading" class="text-text-main mb-5 flex items-center gap-2 text-xl font-bold md:text-2xl">
        <Icon name="lucide:timer" class="text-brand h-6 w-6 shrink-0" aria-hidden="true" />
        Таймер варки
      </h2>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="cook-timer-method" class="text-text-muted mb-1.5 block text-sm font-semibold">
            Способ
          </label>
          <select id="cook-timer-method" class={fieldClass} data-timer-method>
            {methods.map((m, i) => (
              <option value={i}>
                {methodLabel(m)} — {formatMinutes(m.minMin, m.maxMin)}
              </option>
            ))}
          </select>
        </div>
        <fieldset>
          <legend class="text-text-muted mb-1.5 block text-sm font-semibold">Время</legend>
          <div class="flex gap-2">
            <label class={boundClass}>
              <input type="radio" name="cook-timer-bound" value="min" class="sr-only" checked data-timer-bound />
              <span data-timer-bound-label="min">{formatMinutes(first.minMin, first.minMin)}</span>
            </label>
            <label class={boundClass} data-timer-max-option hidden={first.minMin === first.maxMin}>
              <input type="radio" name="cook-timer-bound" value="max" class="sr-only" data-timer-bound />
              <span data-timer-bound-label="max">{formatMinutes(first.maxMin, first.maxMin)}</span>
            </label>
          </div>
        </fieldset>
      </div>

      <p class="text-text-main mt-6 text-center text-6xl font-bold tabular-nums md:text-7xl" role="timer" aria-live="off" data-timer-clock>
        {formatClock(timerSeconds(first.minMin) ?? 0)}
      </p>
      <p class="text-text-muted mt-2 min-h-6 text-center leading-relaxed" aria-live="polite" data-timer-status>
        Запустите таймер, когда вода закипит.
      </p>

      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <Button class="h-12 min-w-40" data-timer-toggle>
          <Icon name="lucide:play" slot="icon-left" class="h-5 w-5" aria-hidden="true" data-timer-icon-play />
          <Icon name="lucide:pause" slot="icon-left" class="hidden h-5 w-5" aria-hidden="true" data-timer-icon-pause />
          <span data-timer-toggle-label>Старт</span>
        </Button>
        <Button variant="outline" class="h-12" data-timer-reset>
          <Icon name="lucide:rotate-ccw" slot="icon-left" class="h-5 w-5" aria-hidden="true" />
          Сброс
        </Button>
      </div>
      <p class="text-text-muted mt-3 hidden text-center text-sm" data-timer-wakelock>
        Экран не погаснет, пока идёт таймер.
      </p>
    </Surface>
  )
}

<script>
  import "../../scripts/kitchen-timer";
</script>
