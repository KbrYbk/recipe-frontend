---
/**
 * Таблица справочника. Стили — только классами на своих элементах (глобальных правил для table/td в проекте нет).
 * На узких экранах таблица прокручивается по горизонтали внутри карточки и не растягивает страницу;
 * «широкая» таблица (длинный текст в ячейках) на телефоне складывается в карточки: строка — блок, ячейки друг под другом.
 */
import Surface from "../ui/Surface.astro";

export interface KitchenTableCell {
  text: string;
  /** Мелкая поясняющая строка под значением. */
  note?: string;
}

interface Props {
  /** Подпись таблицы (видна, читается скринридером). */
  caption: string;
  head: string[];
  /** Первая ячейка строки — заголовок строки. */
  rows: (string | KitchenTableCell)[][];
  /** Таблица с длинным текстом в ячейках: шире минимальная ширина, значения не «табличными» цифрами. */
  wide?: boolean;
  class?: string;
}

const { caption, head, rows, wide = false, class: className } = Astro.props;
const cell = (c: string | KitchenTableCell): KitchenTableCell => (typeof c === "string" ? { text: c } : c);
---

<Surface padding="none" class:list={["overflow-hidden", className]}>
  <div class="overflow-x-auto overscroll-x-contain" tabindex="0" role="region" aria-label={caption}>
    <table class:list={["w-full border-collapse text-left text-base", wide ? "sm:min-w-160" : "min-w-72"]}>
      <caption class="text-text-muted border-line border-b px-4 py-3 text-left text-sm font-semibold md:px-6">{caption}</caption>
      <thead class:list={[wide && "max-sm:sr-only"]}>
        <tr class="bg-accent-soft">
          {
            head.map((h) => (
              <th scope="col" class="text-text-main px-4 py-3 text-sm font-bold whitespace-nowrap md:px-6">
                {h}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class:list={["border-line border-t", wide && "max-sm:block max-sm:px-4 max-sm:py-3"]}>
              {row.map((raw, i) => {
                const c = cell(raw);
                const note = c.note && <span class="text-text-muted mt-0.5 block text-sm font-normal">{c.note}</span>;
                return i === 0 ? (
                  <th scope="row" class:list={["text-text-main px-4 py-3 align-top font-semibold md:px-6", wide && "max-sm:block max-sm:px-0 max-sm:py-1 max-sm:text-lg"]}>
                    {c.text}
                    {note}
                  </th>
                ) : (
                  <td class:list={["text-text-main px-4 py-3 align-top md:px-6", wide ? "leading-relaxed max-sm:block max-sm:px-0 max-sm:py-1" : "tabular-nums"]}>
                    {wide && <span class="text-text-muted block text-sm font-semibold sm:hidden">{head[i]}</span>}
                    {c.text}
                    {note}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Surface>
