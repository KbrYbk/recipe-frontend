---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { formatTime } from "../lib/formatTime";
import type { RecipeCard } from "../types/recipe";
import { isDescriptionRedundant } from "../lib/seo";

interface Props {
  recipe: RecipeCard;
  /** Первая карточка на экране: грузить картинку сразу и без анимации появления (LCP). */
  priority?: boolean;
  /** Уровень заголовка карточки. */
  headingLevel?: "h2" | "h3" | "h4";
  /** Кнопка «Убрать из избранного» поверх фото (страница избранного). */
  removable?: boolean;
}

const { recipe, priority = false, headingLevel = "h2", removable = false } = Astro.props;
const { id, title, description, main_image, url: recipeUrl } = recipe;
const cooking_time = recipe.cooking_time;
const Heading = headingLevel;

const hasImage = !!main_image;
const imageAlt = `Фото блюда: ${title}`;
---

<article
  data-recipe-card={id}
  class="group bg-card-bg/60 glass-border-3d focus-within:ring-brand rounded-panel shadow-float hover:shadow-float relative flex h-full flex-col overflow-hidden backdrop-blur-md transition-shadow focus-within:ring-2 focus-within:ring-offset-2"
>
  <div class="bg-page-bg relative flex h-48 w-full items-center justify-center overflow-hidden">
    {
      main_image ? (
        <Image
          src={main_image}
          alt={imageAlt}
          width={600}
          height={400}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
          decoding="async"
          class:list={["h-full w-full object-cover transition-transform duration-500 group-hover:scale-110", !priority && "animate-fade-in opacity-0"]}
        />
      ) : null
    }

    <div class={`fallback ${hasImage ? "hidden" : "flex"} items-center justify-center`} aria-hidden="true">
      <Icon name="lucide:utensils-crossed" class="text-text-muted h-16 w-16 opacity-20" />
    </div>

    {
      removable && (
        <button
          type="button"
          class="bg-card-bg/90 text-text-main rounded-control shadow-soft hover:bg-negative absolute top-3 right-3 z-10 flex h-10 cursor-pointer items-center gap-1.5 px-3 text-sm font-semibold backdrop-blur-sm transition-colors hover:text-white"
          data-favorite-remove={id}
          aria-label={`Убрать из избранного: ${title}`}
        >
          <Icon name="lucide:heart-off" class="h-4 w-4" aria-hidden="true" />
          <span>Убрать</span>
        </button>
      )
    }
  </div>

  <div class="flex grow flex-col p-6">
    <Heading class="text-text-main group-hover:text-brand-ink mb-3 line-clamp-3 text-xl leading-snug font-semibold transition-colors md:text-2xl">
      <a href={recipeUrl} class="after:absolute after:inset-0 focus:outline-none">
        {title}
      </a>
    </Heading>

    {!isDescriptionRedundant({ title, description }) && <p class="text-text-muted mb-5 line-clamp-3 text-sm leading-relaxed text-pretty break-words">{description}</p>}

    <div class="text-text-muted mt-auto mb-4 flex flex-wrap items-center justify-between gap-3 text-sm">
      {
        recipe.author ? (
          <div class="flex shrink-0 items-center gap-1.5 font-medium">
            <div class="bg-brand/10 text-brand-ink flex h-6 w-6 items-center justify-center rounded-full">
              <Icon name="lucide:user" class="h-3.5 w-3.5" aria-hidden="true" />
            </div>
            <span class="line-clamp-1">{recipe.author}</span>
          </div>
        ) : (
          <div class="shrink-0" />
        )
      }

      <div class="flex items-center gap-2">
        {
          recipe.difficulty && (
            <div
              class={`glass-border-3d rounded-card shadow-soft flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-semibold sm:text-xs ${
                recipe.difficulty === "hard" ? "text-negative bg-red-500/10" : recipe.difficulty === "medium" ? "text-rating bg-amber-500/10" : "text-positive bg-emerald-500/10"
              }`}
            >
              <Icon name="lucide:flame" class="h-3 w-3 sm:h-3.5 sm:w-3.5" aria-hidden="true" />
              {recipe.difficulty === "hard" ? "Сложно" : recipe.difficulty === "medium" ? "Средне" : "Легко"}
            </div>
          )
        }

        <div
          class="glass-border-3d bg-page-bg/60 text-text-main rounded-card shadow-soft flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-semibold sm:text-xs"
          aria-label={`Время приготовления: ${formatTime(cooking_time)}`}
        >
          <Icon name="lucide:clock" class="text-brand-ink h-3 w-3 sm:h-3.5 sm:w-3.5" aria-hidden="true" />
          <span class="tabular-nums">{formatTime(cooking_time)}</span>
        </div>
      </div>
    </div>

    {
      (recipe.average_rating > 0 || recipe.likes_count > 0) && (
        <div class="border-line flex items-center border-t pt-4 text-sm">
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {recipe.average_rating > 0 && (
              <div class="text-rating flex items-center gap-1.5 font-semibold" aria-label={`Рейтинг: ${recipe.average_rating}`}>
                <Icon name="lucide:star" class="h-5 w-5 fill-current" aria-hidden="true" />
                <span class="text-base tabular-nums">{recipe.average_rating.toFixed(1)}</span>
              </div>
            )}

            {recipe.likes_count > 0 && (
              <div class="text-negative flex items-center gap-1.5 font-semibold" aria-label={`Лайков: ${recipe.likes_count}`}>
                <Icon name="lucide:heart" class="h-5 w-5 fill-current" aria-hidden="true" />
                <span class="text-base tabular-nums">{recipe.likes_count}</span>
              </div>
            )}
          </div>
        </div>
      )
    }
  </div>
</article>
