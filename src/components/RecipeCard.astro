---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getRecipeUrl } from "../lib/slugify";
import { formatTime } from "../lib/formatTime";

interface Props {
  recipe: {
    id: number | string;
    title: string;
    description: string;
    main_image?: string;
    cooking_time: number;
    user?: { name: string };
    difficulty?: string;
    average_rating?: number;
    likes_count?: number;
    category?: any;
  };
  view?: "grid" | "list";
}

const { recipe } = Astro.props;
const { id, title, description, main_image, cooking_time: rawTime } = recipe;
const cooking_time = Number(rawTime) || 0;

const recipeUrl = getRecipeUrl(recipe);

const hasImage = !!main_image && main_image !== "";
const imageAlt = `Фото блюда: ${title}`;
---

<article
  class="group bg-card-bg/60 glass-border-3d focus-within:ring-brand relative flex h-full flex-col overflow-hidden rounded-4xl shadow-lg shadow-black/15 backdrop-blur-md transition-all focus-within:ring-2 focus-within:ring-offset-2 hover:shadow-xl hover:shadow-black/20"
>
  <div class="bg-page-bg relative flex h-48 w-full items-center justify-center overflow-hidden">
    {
      hasImage ? (
        <Image
          src={main_image}
          alt={imageAlt}
          width={600}
          height={400}
          loading="lazy"
          decoding="async"
          class="animate-fade-in h-full w-full object-cover opacity-0 transition-transform duration-500 group-hover:scale-110"
          style={`view-transition-name: recipe-image-${id}`}
        />
      ) : null
    }

    <div class={`fallback ${hasImage ? "hidden" : "flex"} items-center justify-center`} aria-hidden="true">
      <Icon name="lucide:utensils-crossed" class="text-text-muted h-16 w-16 opacity-20" />
    </div>
  </div>

  <div class="flex grow flex-col p-6">
    <h2 class="text-text-main group-hover:text-brand mb-3 line-clamp-2 text-xl font-bold transition-colors md:text-2xl">
      <a href={recipeUrl} class="after:absolute after:inset-0 focus:outline-none">
        {title}
      </a>
    </h2>

    <p class="text-text-muted mb-6 line-clamp-3 grow text-sm leading-relaxed">
      {description}
    </p>

    <div class="text-text-muted mb-4 flex flex-wrap items-center justify-between gap-3 text-sm">
      {
        recipe.user?.name ? (
          <div class="flex shrink-0 items-center gap-1.5 font-medium">
            <div class="bg-brand/10 text-brand flex h-6 w-6 items-center justify-center rounded-full">
              <Icon name="lucide:user" class="h-3.5 w-3.5" aria-hidden="true" />
            </div>
            <span class="line-clamp-1">{recipe.user.name}</span>
          </div>
        ) : (
          <div class="shrink-0" />
        )
      }

      <div class="flex items-center gap-2">
        {
          recipe.difficulty && (
            <div
              class={`glass-border-3d flex items-center gap-1.5 rounded-2xl px-2.5 py-1 text-[10px] font-bold tracking-wide uppercase shadow-sm shadow-black/15 sm:text-xs ${
                recipe.difficulty === "hard" ? "bg-red-500/10 text-red-500" : recipe.difficulty === "medium" ? "bg-amber-500/10 text-amber-500" : "bg-emerald-500/10 text-emerald-500"
              }`}
            >
              <Icon name="lucide:flame" class="h-3 w-3 sm:h-3.5 sm:w-3.5" aria-hidden="true" />
              {recipe.difficulty === "hard" ? "Сложно" : recipe.difficulty === "medium" ? "Средне" : "Легко"}
            </div>
          )
        }

        <div
          class="glass-border-3d bg-page-bg/60 text-text-main flex items-center gap-1.5 rounded-2xl px-2.5 py-1 text-[10px] font-bold shadow-sm shadow-black/15 sm:text-xs"
          aria-label={`Время приготовления: ${formatTime(cooking_time)}`}
        >
          <Icon name="lucide:clock" class="text-brand h-3 w-3 sm:h-3.5 sm:w-3.5" aria-hidden="true" />
          <span class="tabular-nums">{formatTime(cooking_time)}</span>
        </div>
      </div>
    </div>

    <div class="border-line mt-auto flex items-center justify-between border-t pt-4 text-sm">
      <div class="flex items-center gap-3">
        {
          (recipe.average_rating ?? 0) > 0 && (
            <div class="flex items-center gap-1.5 font-bold text-amber-500" aria-label={`Рейтинг: ${recipe.average_rating}`}>
              <Icon name="lucide:star" class="h-5 w-5 fill-current" aria-hidden="true" />
              <span class="text-base tabular-nums">{recipe.average_rating}</span>
            </div>
          )
        }

        {
          (recipe.likes_count ?? 0) > 0 && (
            <div class="flex items-center gap-1.5 font-bold text-rose-500" aria-label={`Лайков: ${recipe.likes_count}`}>
              <Icon name="lucide:heart" class="h-5 w-5 fill-current" aria-hidden="true" />
              <span class="text-base tabular-nums">{recipe.likes_count}</span>
            </div>
          )
        }
      </div>

      <div class="text-brand bg-brand/10 group-hover:bg-brand flex shrink-0 items-center gap-1 rounded-xl px-3 py-1.5 font-bold transition-colors group-hover:text-white">
        <span class="leading-none">Рецепт</span>
        <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
      </div>
    </div>
  </div>
</article>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.5s ease-in forwards;
  }
</style>
