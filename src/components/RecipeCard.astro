---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Badge from "./ui/Badge.astro";
interface Props {
  recipe: {
    id: number | string;
    title: string;
    description: string;
    main_image?: string;
    cooking_time: number;
  };
}

const { recipe } = Astro.props;
const { id, title, description, main_image, cooking_time: rawTime } = recipe;
const cooking_time = Number(rawTime) || 0;

const hasImage = !!main_image && main_image !== "";
const imageAlt = `Фото блюда: ${title}`;
---

<article class="group bg-card-bg/60 glass-border-3d relative flex h-full flex-col overflow-hidden rounded-[2rem] shadow-lg shadow-black/15 backdrop-blur-md transition-all hover:shadow-xl hover:shadow-black/20 focus-within:ring-2 focus-within:ring-brand focus-within:ring-offset-2">
  <div class="relative flex h-48 w-full items-center justify-center overflow-hidden bg-page-bg">
    {
      hasImage ? (
        <Image
          src={main_image}
          alt={imageAlt}
          width={600}
          height={400}
          loading="lazy"
          decoding="async"
          class="animate-fade-in h-full w-full object-cover opacity-0 transition-transform duration-500 group-hover:scale-110"
          style={`view-transition-name: recipe-image-${id}`}
        />
      ) : null
    }

    <div class={`fallback ${hasImage ? "hidden" : "flex"} items-center justify-center`} aria-hidden="true">
      <Icon name="lucide:utensils-crossed" class="h-16 w-16 text-text-muted opacity-20" />
    </div>

  </div>

  <div class="flex grow flex-col p-6">
    <h2 class="text-text-main mb-3 line-clamp-2 text-xl font-bold transition-colors group-hover:text-brand md:text-2xl">
      <a href={`/recipe/${id}`} class="after:absolute after:inset-0 focus:outline-none">
        {title}
      </a>
    </h2>

    <p class="text-text-muted mb-6 line-clamp-3 grow text-sm leading-relaxed">
      {description}
    </p>

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-text-muted">
      {
        recipe.user?.name ? (
          <div class="flex items-center gap-1.5 font-medium shrink-0">
            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand/10 text-brand">
              <Icon name="lucide:user" class="h-3.5 w-3.5" aria-hidden="true" />
            </div>
            <span class="line-clamp-1">{recipe.user.name}</span>
          </div>
        ) : <div class="shrink-0"></div>
      }
      
      <div class="flex items-center gap-2">
        {
          recipe.difficulty && (
            <div class={`glass-border-3d flex items-center gap-1.5 rounded-2xl px-2.5 py-1 text-[10px] sm:text-xs font-bold tracking-wide uppercase shadow-sm shadow-black/15 ${
              recipe.difficulty === "hard" ? "bg-red-500/10 text-red-500" : 
              recipe.difficulty === "medium" ? "bg-amber-500/10 text-amber-500" : 
              "bg-emerald-500/10 text-emerald-500"
            }`}>
              <Icon name="lucide:flame" class="h-3 w-3 sm:h-3.5 sm:w-3.5" aria-hidden="true" />
              {recipe.difficulty === "hard" ? "Сложно" : recipe.difficulty === "medium" ? "Средне" : "Легко"}
            </div>
          )
        }
        
        <div class="glass-border-3d flex items-center gap-1.5 rounded-2xl bg-page-bg/60 px-2.5 py-1 text-[10px] sm:text-xs font-bold text-text-main shadow-sm shadow-black/15" aria-label={`Время приготовления: ${cooking_time} минут`}>
          <Icon name="lucide:clock" class="h-3 w-3 sm:h-3.5 sm:w-3.5 text-brand" aria-hidden="true" />
          <span class="tabular-nums">{cooking_time} мин</span>
        </div>
      </div>
    </div>

    <div class="mt-auto flex items-center justify-between border-t border-line pt-4 text-sm">
      <div class="flex items-center gap-3">
        {
          recipe.average_rating > 0 && (
            <div class="flex items-center gap-1.5 font-bold text-amber-500" aria-label={`Рейтинг: ${recipe.average_rating}`}>
              <Icon name="lucide:star" class="h-5 w-5 fill-current" aria-hidden="true" />
              <span class="text-base tabular-nums">{recipe.average_rating}</span>
            </div>
          )
        }

        {
          recipe.likes_count > 0 && (
            <div class="flex items-center gap-1.5 font-bold text-rose-500" aria-label={`Лайков: ${recipe.likes_count}`}>
              <Icon name="lucide:heart" class="h-5 w-5 fill-current" aria-hidden="true" />
              <span class="text-base tabular-nums">{recipe.likes_count}</span>
            </div>
          )
        }
      </div>

      <div class="text-brand flex shrink-0 items-center gap-1 font-bold rounded-xl bg-brand/10 px-3 py-1.5 transition-colors group-hover:bg-brand group-hover:text-white">
        <span class="leading-none">Рецепт</span>
        <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
      </div>
    </div>
  </div>
</article>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.5s ease-in forwards;
  }
</style>
