---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
interface Props {
  recipe: {
    id: number | string;
    title: string;
    description: string;
    main_image?: string;
    cooking_time: number;
  };
}

const { recipe } = Astro.props;
const { id, title, description, main_image, cooking_time: rawTime } = recipe;
const cooking_time = Number(rawTime) || 0;

const hasImage = !!main_image && main_image !== "";
const imageAlt = `Фото блюда: ${title}`;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-card-bg shadow-sm transition-all duration-300 hover:shadow-xl focus-within:ring-2 focus-within:ring-brand focus-within:ring-offset-2">
  <div class="relative flex h-48 w-full items-center justify-center overflow-hidden bg-page-bg">
    {
      hasImage ? (
        <Image
          src={main_image}
          alt={imageAlt}
          width={600}
          height={400}
          loading="lazy"
          decoding="async"
          class="animate-fade-in h-full w-full object-cover opacity-0 transition-transform duration-500 group-hover:scale-110"
          style={`view-transition-name: recipe-image-${id}`}
        />
      ) : null
    }

    <div class={`fallback ${hasImage ? "hidden" : "flex"} items-center justify-center`} aria-hidden="true">
      <Icon name="lucide:utensils-crossed" class="h-16 w-16 text-text-muted opacity-20" />
    </div>
  </div>

  <div class="flex grow flex-col p-6">
    <h2 class="text-text-main mb-3 line-clamp-2 text-xl font-bold transition-colors group-hover:text-brand md:text-2xl">
      <a href={`/recipe/${id}`} class="after:absolute after:inset-0 focus:outline-none">
        {title}
      </a>
    </h2>

    <p class="text-text-muted mb-6 line-clamp-3 grow text-sm leading-relaxed">
      {description}
    </p>

    <div class="mb-4 flex flex-wrap gap-x-4 gap-y-2 text-xs font-medium text-text-muted">
      {
        recipe.user?.name && (
          <div class="flex items-center gap-1">
            <Icon name="lucide:user" class="h-3.5 w-3.5" aria-hidden="true" />
            <span>{recipe.user.name}</span>
          </div>
        )
      }
      {
        recipe.difficulty && (
          <div class="flex items-center gap-1 uppercase tracking-wider">
            <Icon name="lucide:flame" class="h-3.5 w-3.5" aria-hidden="true" />
            <span>
              {recipe.difficulty === "hard" ? "Сложно" : recipe.difficulty === "medium" ? "Средне" : "Легко"}
            </span>
          </div>
        )
      }
    </div>

    <div class="mt-auto flex items-center justify-between border-t border-line pt-4 text-sm">
      <div class="flex items-center gap-4">
        <div class="text-text-muted flex items-center gap-1.5 font-medium">
          <Icon name="lucide:clock" class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span class="leading-none tabular-nums">{cooking_time} мин</span>
        </div>

        {
          recipe.average_rating > 0 && (
            <div class="flex items-center gap-1 text-amber-500 font-bold" aria-label={`Рейтинг: ${recipe.average_rating}`}>
              <Icon name="lucide:star" class="h-4 w-4 fill-current" aria-hidden="true" />
              <span class="leading-none tabular-nums">{recipe.average_rating}</span>
            </div>
          )
        }

        {
          recipe.likes_count > 0 && (
            <div class="text-rose-500 flex items-center gap-1 font-bold" aria-label={`Лайков: ${recipe.likes_count}`}>
              <Icon name="lucide:heart" class="h-4 w-4 fill-current" aria-hidden="true" />
              <span class="leading-none tabular-nums">{recipe.likes_count}</span>
            </div>
          )
        }
      </div>

      <div class="text-brand flex items-center gap-1 font-bold">
        <span class="leading-none">Смотреть</span>
        <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
      </div>
    </div>
  </div>
</article>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.5s ease-in forwards;
  }
</style>
