---
import { Icon } from "astro-icon/components";
---

<recipe-lightbox>
  <dialog class="fullscreen-modal m-auto h-full max-h-screen w-full max-w-[100vw] border-none bg-transparent p-0 backdrop:bg-black/90">
    <button type="button" class="close-modal absolute top-4 right-4 z-50 p-2 text-white opacity-70 transition-opacity hover:opacity-100" aria-label="Закрыть">
      <Icon name="lucide:x" class="h-8 w-8" />
    </button>
    <div class="flex h-full w-full items-center justify-center p-4">
      <img src="" alt="Увеличенное фото" class="modal-img max-h-full max-w-full object-contain" />
    </div>
    <span class="absolute bottom-6 left-1/2 -translate-x-1/2 text-sm text-white/50">Esc или клик вне фото для закрытия</span>
  </dialog>
</recipe-lightbox>

<script>
  class RecipeLightbox extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector("dialog");
      const img = this.querySelector(".modal-img") as HTMLImageElement;
      const closeBtn = this.querySelector(".close-modal");

      if (!dialog || !img) return;

      const triggers = document.querySelectorAll<HTMLImageElement>("img[data-zoomable]");

      const openModal = (e: Event) => {
        const target = e.currentTarget as HTMLImageElement;
        img.src = target.currentSrc || target.src;
        dialog.showModal();
        document.body.style.overflow = "hidden"; // Блокируем скролл страницы
      };

      const closeModal = () => {
        dialog.close();
      };

      // Слушаем нативное событие закрытия, чтобы надежно разблокировать скролл
      dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
      });

      triggers.forEach((t) => {
        t.style.cursor = "zoom-in";
        t.addEventListener("click", openModal);
      });

      closeBtn?.addEventListener("click", closeModal);

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) closeModal();
      });

      // Очистка при View Transitions
      (this as any)._cleanup = () => {
        triggers.forEach((t) => t.removeEventListener("click", openModal));
        document.body.style.overflow = "";
      };
    }

    disconnectedCallback() {
      if ((this as any)._cleanup) (this as any)._cleanup();
    }
  }

  customElements.define("recipe-lightbox", RecipeLightbox);
</script>

<style>
  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.9);
  }
</style>
