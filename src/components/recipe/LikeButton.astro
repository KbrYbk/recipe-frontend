---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import { ACTION_BUTTON_CLASS, ACTION_LABEL_CLASS } from "./actionStyles";

import { formatCount } from "../../lib/catalog";

interface Props {
  recipeId: number;
  /** Сколько лайков у рецепта сейчас. */
  likes?: number;
}
const { recipeId, likes = 0 } = Astro.props;
---

<like-button data-id={recipeId} class="block shrink-0">
  <Button variant="outline" aria-label="Лайкнуть рецепт" aria-pressed="false" size="sm" class={`like-btn ${ACTION_BUTTON_CLASS}`}>
    <Icon name="lucide:heart" slot="icon-left" class="heart-icon h-4 w-4 shrink-0" aria-hidden="true" />
    <span class={ACTION_LABEL_CLASS}>Лайк<span class="like-count text-text-muted ml-1 font-medium tabular-nums" data-count={likes}>{likes > 0 ? formatCount(likes) : ""}</span></span>
  </Button>
</like-button>

<script>
  import { incrementLike } from "../../lib/client/api";
  import { formatCount } from "../../lib/catalog";
  import { hasId, LIKES_KEY, toggleId } from "../../lib/client/storage";
  import { showToast } from "../../lib/client/toast";

  const MESSAGES = [
    "Рады, что вам понравилось!",
    "Спасибо, что оценили рецепт!",
    "Ваш лайк греет нам душу!",
    "Отличный выбор! Приятного аппетита",
    "Вкусно и просто? Рады угодить!",
    "Готовьте с удовольствием!",
  ];

  class LikeButton extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>(".like-btn");
      const icon = this.querySelector(".heart-icon");
      const counter = this.querySelector<HTMLElement>(".like-count");
      const recipeId = Number(this.dataset.id);
      if (!btn || !recipeId) return;

      const apply = (active: boolean) => {
        btn.classList.toggle("text-rose-500", active);
        btn.classList.toggle("border-rose-500", active);
        btn.classList.toggle("bg-rose-500/10", active);
        btn.setAttribute("aria-pressed", String(active));
        icon?.classList.toggle("fill-rose-500", active);
        icon?.classList.toggle("text-rose-500", active);
      };

      const showCount = (n: number) => {
        if (!counter || !Number.isFinite(n) || n < 0) return;
        counter.dataset.count = String(n);
        counter.textContent = n > 0 ? formatCount(n) : "";
      };

      apply(hasId(LIKES_KEY, recipeId));
      let busy = false;

      btn.addEventListener("click", async () => {
        if (busy || hasId(LIKES_KEY, recipeId)) return;
        busy = true;
        btn.classList.add("opacity-70");
        try {
          const res = await incrementLike(recipeId);
          if (res.ok) {
            let body: { likes?: number; already_liked?: boolean } | null = null;
            try {
              body = await res.json();
            } catch {
              body = null;
            }
            toggleId(LIKES_KEY, recipeId, true);
            apply(true);
            // Бэкенд отдаёт актуальное число (с учётом нашего лайка); страница могла прийти из кэша со старым.
            if (typeof body?.likes === "number") showCount(body.likes);
            else showCount(Number(counter?.dataset.count ?? 0) + 1);
            if (body?.already_liked) showToast("Вы уже ставили лайк этому рецепту", "info");
            else showToast(MESSAGES[Math.floor(Math.random() * MESSAGES.length)], "success");
          } else if (res.status === 429) {
            showToast("Слишком часто. Подождите минуту и попробуйте снова.", "error");
          } else {
            showToast("Не удалось поставить лайк. Попробуйте позже.", "error");
          }
        } catch {
          showToast("Нет соединения. Проверьте интернет.", "error");
        } finally {
          busy = false;
          btn.classList.remove("opacity-70");
        }
      });
    }
  }

  if (!customElements.get("like-button")) customElements.define("like-button", LikeButton);
</script>
