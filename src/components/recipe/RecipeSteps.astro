---
import AdSlot from "../shared/AdSlot.astro";
import FormattedText from "./FormattedText.astro";
import Checkbox from "../ui/Checkbox.astro";

import type { Step } from "../../types/recipe";

interface Props {
  steps: Step[];
  recipeId: number;
  /** Название рецепта — для alt фото шагов. */
  recipeTitle?: string;
}

const { steps, recipeId, recipeTitle } = Astro.props;
---

<ol class="space-y-8 md:space-y-10">
  {
    steps.map((step, index) => {
      return (
        <>
          <li id={`step-${step.order ?? index + 1}`} class="group relative scroll-mt-24 transition-opacity duration-300 print:mb-3 print:break-inside-avoid print:border-b print:border-gray-200">
            {index !== steps.length - 1 && <div class="step-connector bg-line absolute top-12 -bottom-8 left-5 hidden w-px sm:block md:-bottom-10 print:hidden" aria-hidden="true" />}

            {/* Номер шага и компактная отметка «Готово» рядом с ним */}
            <div class="mb-3 flex items-center gap-3 print:mb-1">
              <div
                class="text-brand group-has-checked:text-positive bg-page-bg relative z-10 flex h-10 w-10 shrink-0 items-center justify-center text-[2rem] leading-none font-semibold tracking-[-0.03em] tabular-nums transition-colors duration-200 print:h-6 print:w-6 print:min-w-6 print:border print:border-black print:bg-transparent print:text-[9pt] print:text-black"
                aria-hidden="true"
              >
                {step.order ?? index + 1}
              </div>
              <span class="text-text-muted text-sm font-medium print:hidden">из {steps.length}</span>
              <label class="border-line text-text-muted hover:text-text-main has-checked:text-positive rounded-control has-checked:border-positive/60 has-checked:bg-positive/10 ml-auto flex min-h-10 cursor-pointer items-center gap-2 border px-3 text-sm font-medium transition-colors duration-150 select-none sm:ml-2 print:hidden">
                <Checkbox data-step-checkbox data-recipe-id={recipeId} data-step-index={index} class="h-5 w-5" aria-label={`Шаг ${step.order ?? index + 1} выполнен`} />
                <span aria-hidden="true">Готово</span>
              </label>
            </div>

            <div class="sm:pl-14 print:pl-0">
              <div class="transition-opacity group-has-checked:opacity-60">
                <FormattedText text={step.text} class="text-text-main w-full text-lg leading-relaxed print:text-[10pt] print:leading-snug" />
              </div>

              {step.image && (
                <div class="glass-border-3d rounded-card shadow-soft mt-5 max-w-3xl overflow-hidden group-has-checked:opacity-60 print:mt-2 print:max-w-75 print:rounded print:border-0 print:shadow-none">
                  <img
                    data-zoomable
                    tabindex="0"
                    role="button"
                    aria-label={`Увеличить изображение: Шаг ${step.order ?? index + 1}`}
                    src={step.image}
                    alt={recipeTitle ? `${recipeTitle} — шаг ${step.order ?? index + 1}` : `Шаг ${step.order ?? index + 1}`}
                    width={1200}
                    height={675}
                    loading="lazy"
                    decoding="async"
                    class="image-zoom h-auto w-full print:float-none"
                  />
                </div>
              )}
            </div>
          </li>

          {/* Рекламный слот */}
          {(index + 1) % 4 === 0 && index < steps.length - 1 && (
            <li class="mb-4 sm:ml-16">
              <AdSlot id="R-A-19056160-13" className="block" refreshInterval={60} />
            </li>
          )}
        </>
      );
    })
  }
</ol>
<script>
  import { stepKey } from "../../lib/cookState";
  import { readString, writeString } from "../../lib/client/storage";

  function syncFromStorage() {
    document.querySelectorAll<HTMLInputElement>("[data-step-checkbox]").forEach((input) => {
      const checked = readString(stepKey(Number(input.dataset.recipeId), Number(input.dataset.stepIndex))) === "1";
      input.checked = checked;
    });
  }

  function initSteps() {
    syncFromStorage();
    document.querySelectorAll<HTMLInputElement>("[data-step-checkbox]").forEach((input) => {
      input.addEventListener("change", () => {
        const recipeId = Number(input.dataset.recipeId);
        const index = input.dataset.stepIndex;
        writeString(stepKey(recipeId, Number(index)), input.checked ? "1" : null);
        document.dispatchEvent(new CustomEvent("recipe:steps-changed"));
      });
    });
    // Синхронизация с «Режимом готовки»
    document.addEventListener("recipe:cook-steps-changed", syncFromStorage);
  }

  initSteps();
</script>
