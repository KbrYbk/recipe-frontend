---
/**
 * «Режим готовки»: полноэкранный пошаговый просмотр крупным шрифтом.
 * Открывается на первом невыполненном шаге; после последнего шага — экран «Готово!».
 * Навигация: кнопки, ←/→ (и PageDown/PageUp), свайп; экран не гаснет (Screen Wake Lock API, если поддерживается);
 * отметки шагов и ингредиентов — общие с основной страницей (localStorage).
 */
import { Icon } from "astro-icon/components";
import type { Ingredient, Step } from "../../types/recipe";
import { formatIngredientAmount } from "../../lib/normalizeIngredients";
import ScaleControl from "./ScaleControl.astro";
import Checkbox from "../ui/Checkbox.astro";

interface Props {
  recipeId: number;
  title: string;
  steps: Step[];
  ingredients: Ingredient[];
  servings?: number;
}

const { recipeId, title, steps, ingredients, servings } = Astro.props;
const plain = (t: string) => t.replace(/<br\s*\/?>/gi, "\n").replace(/\\r\\n|\\n/g, "\n");
---

{
  steps.length > 0 && (
    <cook-mode data-recipe-id={recipeId} data-total={steps.length}>
      <dialog class="cook-dialog bg-page-bg text-text-main m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden p-0 backdrop:bg-black/80" aria-labelledby="cook-title" data-cook-dialog>
        <div class="flex h-full flex-col">
          <header class="border-line flex items-center gap-3 border-b px-4 py-3">
            <button type="button" class="hover:text-brand-ink rounded-control flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center" aria-label="Закрыть режим готовки" data-cook-close>
              <Icon name="lucide:x" class="h-6 w-6" aria-hidden="true" />
            </button>
            <div class="min-w-0 flex-1">
              <p id="cook-title" class="truncate text-sm font-semibold md:text-base">
                {title}
              </p>
              <p class="text-text-muted text-xs" aria-live="polite">
                Шаг <span data-cook-current>1</span> из {steps.length}
                <span class="hidden" data-cook-wakelock>
                  {" "}
                  · экран не погаснет
                </span>
              </p>
            </div>
            {ingredients.length > 0 && (
              <button
                type="button"
                class="glass-border-3d hover:text-brand-ink rounded-control flex h-11 shrink-0 cursor-pointer items-center gap-2 px-3 text-sm font-semibold"
                aria-expanded="false"
                aria-controls="cook-ingredients"
                data-cook-ingredients-toggle
              >
                <Icon name="lucide:shopping-basket" class="h-5 w-5" aria-hidden="true" />
                <span class="hidden sm:inline">Ингредиенты</span>
              </button>
            )}
          </header>

          <div class="bg-line h-1 w-full" aria-hidden="true">
            <div class="bg-brand ease-soft h-1 w-full origin-left transition-transform duration-300" style="transform:scaleX(0)" data-cook-progress />
          </div>

          <div class="relative min-h-0 flex-1">
            <div class="h-full touch-pan-y overflow-x-hidden overflow-y-auto overscroll-contain px-5 py-6 md:px-10 md:py-10" data-cook-stage>
              {steps.map((step, index) => (
                <section class="mx-auto hidden max-w-3xl" data-cook-step={index} aria-label={`Шаг ${index + 1}`}>
                  <p class="text-brand-ink mb-4 text-sm font-semibold">Шаг {index + 1}</p>
                  <p class="text-2xl leading-relaxed font-medium whitespace-pre-line md:text-4xl md:leading-snug">{plain(step.text)}</p>
                  {step.image && <img src={step.image} alt="" loading="lazy" decoding="async" class="rounded-card mt-6 max-h-[40vh] w-auto object-contain" width="800" height="450" />}
                  <label class="border-line hover:border-brand rounded-card has-checked:border-positive/60 has-checked:bg-positive/10 mt-8 inline-flex cursor-pointer items-center gap-3 border px-5 py-3 text-lg font-semibold transition-colors">
                    <Checkbox data-cook-step-done={index} />
                    Шаг выполнен
                  </label>
                </section>
              ))}
              <section class="mx-auto hidden max-w-3xl py-10 text-center" data-cook-finish aria-label="Готово" tabindex="-1">
                <div class="bg-accent-soft text-brand-ink mx-auto flex h-20 w-20 items-center justify-center rounded-full">
                  <Icon name="lucide:party-popper" class="h-10 w-10" aria-hidden="true" />
                </div>
                <p class="mt-6 text-3xl font-semibold md:text-5xl">Готово!</p>
                <p class="text-text-muted mt-3 text-xl md:text-2xl">Приятного аппетита</p>
                <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
                  <button type="button" class="btn-primary rounded-card h-14 px-8 text-lg" data-cook-finish-close>
                    <Icon name="lucide:check" class="h-5 w-5" aria-hidden="true" />
                    Закрыть
                  </button>
                  <button
                    type="button"
                    class="glass-border-3d hover:text-brand-ink rounded-card flex h-14 cursor-pointer items-center justify-center gap-2 px-8 text-lg font-semibold"
                    data-cook-restart
                  >
                    <Icon name="lucide:rotate-ccw" class="h-5 w-5" aria-hidden="true" />
                    Начать сначала
                  </button>
                </div>
              </section>
            </div>

            {ingredients.length > 0 && (
              <aside
                id="cook-ingredients"
                class="bg-card-bg border-line shadow-float absolute inset-y-0 right-0 hidden w-full max-w-sm overflow-y-auto border-l p-5"
                aria-label="Ингредиенты"
                data-cook-ingredients
              >
                <h2 class="mb-4 text-xl font-semibold">Ингредиенты</h2>
                {ingredients.some((i) => formatIngredientAmount(i)) && <ScaleControl recipeId={recipeId} servings={servings} class="mb-4" />}
                <ul class="space-y-2">
                  {ingredients.map((item, i) => {
                    const amount = formatIngredientAmount(item);
                    return (
                      <li>
                        <label class="hover:bg-page-bg/60 rounded-control flex cursor-pointer items-start gap-3 p-2 text-lg">
                          <Checkbox class="mt-0.5" data-cook-ingredient={i} />
                          <span>
                            {item.name}
                            {amount && (
                              <span class="text-text-muted block text-sm" data-amount-base={amount}>
                                {amount}
                              </span>
                            )}
                          </span>
                        </label>
                      </li>
                    );
                  })}
                </ul>
              </aside>
            )}
          </div>

          <footer data-cook-footer class="border-line flex items-center gap-3 border-t px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
            <button type="button" class="glass-border-3d rounded-card flex h-14 flex-1 cursor-pointer items-center justify-center gap-2 text-lg font-semibold disabled:opacity-40" data-cook-prev>
              <Icon name="lucide:arrow-left" class="h-5 w-5" aria-hidden="true" />
              Назад
            </button>
            <button type="button" class="btn-primary rounded-card h-14 flex-1 text-lg" data-cook-next>
              <span data-cook-next-label>Далее</span>
              <Icon name="lucide:arrow-right" class="h-5 w-5" aria-hidden="true" />
            </button>
          </footer>
        </div>
      </dialog>
    </cook-mode>
  )
}

<style>
  .cook-dialog[open] {
    display: block;
  }
</style>

<script>
  import { clampStep, firstUndoneStep, ingredientKey, stepKey, swipeDirection } from "../../lib/cookState";
  import { readString, writeString } from "../../lib/client/storage";
  import { animateSpring, prefersReducedMotion, project, releaseVelocity, rubberband, type MotionSample, type SpringAnimation } from "../../lib/client/spring";

  type WakeLockSentinelLike = { release: () => Promise<void>; addEventListener: (t: "release", cb: () => void) => void };
  type NavigatorWithWakeLock = Navigator & { wakeLock?: { request: (type: "screen") => Promise<WakeLockSentinelLike> } };

  class CookMode extends HTMLElement {
    private index = 0;
    private finished = false;
    private wakeLock: WakeLockSentinelLike | null = null;

    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>("[data-cook-dialog]");
      const recipeId = Number(this.dataset.recipeId);
      const total = Number(this.dataset.total);
      if (!dialog || !recipeId || !total) return;

      const sections = Array.from(this.querySelectorAll<HTMLElement>("[data-cook-step]"));
      const current = this.querySelector("[data-cook-current]");
      const progress = this.querySelector<HTMLElement>("[data-cook-progress]");
      const prevBtn = this.querySelector<HTMLButtonElement>("[data-cook-prev]");
      const nextBtn = this.querySelector<HTMLButtonElement>("[data-cook-next]");
      const nextLabel = this.querySelector("[data-cook-next-label]");
      const stage = this.querySelector<HTMLElement>("[data-cook-stage]");
      const ingPanel = this.querySelector<HTMLElement>("[data-cook-ingredients]");
      const ingToggle = this.querySelector<HTMLElement>("[data-cook-ingredients-toggle]");
      const wakeHint = this.querySelector<HTMLElement>("[data-cook-wakelock]");
      const finishScreen = this.querySelector<HTMLElement>("[data-cook-finish]");
      const footer = this.querySelector<HTMLElement>("[data-cook-footer]");

      const stepBoxes = Array.from(this.querySelectorAll<HTMLInputElement>("[data-cook-step-done]"));
      const ingBoxes = Array.from(this.querySelectorAll<HTMLInputElement>("[data-cook-ingredient]"));

      const loadChecks = () => {
        stepBoxes.forEach((cb) => (cb.checked = readString(stepKey(recipeId, Number(cb.dataset.cookStepDone))) === "1"));
        ingBoxes.forEach((cb) => (cb.checked = readString(ingredientKey(recipeId, Number(cb.dataset.cookIngredient))) === "1"));
      };

      stepBoxes.forEach((cb) =>
        cb.addEventListener("change", () => {
          writeString(stepKey(recipeId, Number(cb.dataset.cookStepDone)), cb.checked ? "1" : null);
          document.dispatchEvent(new CustomEvent("recipe:cook-steps-changed"));
        }),
      );
      ingBoxes.forEach((cb) =>
        cb.addEventListener("change", () => {
          writeString(ingredientKey(recipeId, Number(cb.dataset.cookIngredient)), cb.checked ? "1" : null);
          document.dispatchEvent(new CustomEvent("recipe:cook-ingredients-changed"));
        }),
      );

      const show = (i: number) => {
        this.finished = false;
        this.index = clampStep(i, total);
        sections.forEach((s, n) => s.classList.toggle("hidden", n !== this.index));
        finishScreen?.classList.add("hidden");
        footer?.classList.remove("hidden");
        if (current) current.textContent = String(this.index + 1);
        if (progress) progress.style.transform = `scaleX(${(this.index + 1) / total})`;
        if (prevBtn) prevBtn.disabled = this.index === 0;
        if (nextLabel) nextLabel.textContent = this.index === total - 1 ? "Готово" : "Далее";
        stage?.scrollTo({ top: 0 });
      };

      const showFinish = () => {
        this.finished = true;
        sections.forEach((s) => s.classList.add("hidden"));
        finishScreen?.classList.remove("hidden");
        footer?.classList.add("hidden");
        if (progress) progress.style.transform = "scaleX(1)";
        stage?.scrollTo({ top: 0 });
        finishScreen?.querySelector<HTMLElement>("[data-cook-finish-close]")?.focus();
      };

      const next = () => {
        if (this.finished) return;
        if (this.index >= total - 1) {
          // последний шаг: отметить выполненным и показать экран «Готово!»
          const last = stepBoxes[this.index];
          if (last && !last.checked) {
            last.checked = true;
            last.dispatchEvent(new Event("change"));
          }
          showFinish();
          return;
        }
        show(this.index + 1);
      };
      const prev = () => show(this.finished ? total - 1 : this.index - 1);

      const restart = () => {
        stepBoxes.forEach((cb) => {
          cb.checked = false;
          writeString(stepKey(recipeId, Number(cb.dataset.cookStepDone)), null);
        });
        document.dispatchEvent(new CustomEvent("recipe:cook-steps-changed"));
        show(0);
      };

      const requestWakeLock = async () => {
        const nav = navigator as NavigatorWithWakeLock;
        if (!nav.wakeLock || document.visibilityState !== "visible") return;
        try {
          this.wakeLock = await nav.wakeLock.request("screen");
          wakeHint?.classList.remove("hidden");
          this.wakeLock.addEventListener("release", () => wakeHint?.classList.add("hidden"));
        } catch {
          this.wakeLock = null;
        }
      };
      const releaseWakeLock = () => {
        this.wakeLock?.release().catch(() => {});
        this.wakeLock = null;
      };
      const onVisibility = () => {
        if (dialog.open && document.visibilityState === "visible") requestWakeLock();
      };

      const open = () => {
        loadChecks();
        show(firstUndoneStep(stepBoxes.map((cb) => cb.checked)));
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
        requestWakeLock();
        document.addEventListener("visibilitychange", onVisibility);
      };

      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = "";
        releaseWakeLock();
        document.removeEventListener("visibilitychange", onVisibility);
      });

      document.querySelectorAll("[data-cook-open]").forEach((btn) => btn.addEventListener("click", () => open()));
      this.querySelector("[data-cook-close]")?.addEventListener("click", () => dialog.close());
      this.querySelector("[data-cook-finish-close]")?.addEventListener("click", () => dialog.close());
      this.querySelector("[data-cook-restart]")?.addEventListener("click", restart);
      prevBtn?.addEventListener("click", () => turn("prev"));
      nextBtn?.addEventListener("click", () => turn("next"));

      ingToggle?.addEventListener("click", () => {
        const opened = ingPanel?.classList.toggle("hidden") === false;
        ingToggle.setAttribute("aria-expanded", String(opened));
      });

      dialog.addEventListener("keydown", (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.tagName === "INPUT" && e.key === " ") return;
        if (e.key === "ArrowRight" || e.key === "PageDown") {
          e.preventDefault();
          turn("next");
        } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
          e.preventDefault();
          turn("prev");
        }
      });

      // --- Перелистывание шагов. Шаг идёт за пальцем 1:1; при отпускании цель выбирается по тому,
      // куда «долетит» бросок, а анимация продолжает движение со скоростью пальца. Анимацию можно
      // перехватить в любой момент — она остановится на текущем месте и пойдёт за пальцем дальше.
      let x = 0;
      let anim: SpringAnimation | null = null;
      const visible = () => (this.finished ? finishScreen : sections[this.index]) ?? null;
      const canPrev = () => this.finished || this.index > 0;
      const stageWidth = () => stage?.clientWidth || 320;
      const fadeDistance = () => Math.min(stageWidth() * 0.45, 260);
      const paint = (el: HTMLElement | null, value: number) => {
        if (!el) return;
        el.style.transform = value ? `translate3d(${value}px, 0, 0)` : "";
        el.style.opacity = value ? String(Math.max(0, 1 - Math.abs(value) / fadeDistance())) : "";
      };
      const settle = (velocity = 0) => {
        const el = visible();
        // Лёгкий отскок — только если был бросок; иначе спокойный возврат без перелёта.
        anim = animateSpring({
          from: x,
          to: 0,
          velocity,
          response: 0.3,
          damping: Math.abs(velocity) > 300 ? 0.8 : 1,
          onUpdate: (v) => {
            x = v;
            paint(el, v);
          },
          onRest: () => (anim = null),
        });
      };
      const turn = (dir: "next" | "prev", velocity = 0) => {
        if (dir === "prev" && !canPrev()) return;
        if (dir === "next" && this.finished) return;
        const go = dir === "next" ? next : prev;
        anim?.stop();
        anim = null;
        const leaving = visible();
        if (prefersReducedMotion()) {
          x = 0;
          paint(leaving, 0);
          go();
          return;
        }
        // Уходит и приходит по одному пути: старый шаг — в сторону жеста, новый — с противоположной.
        const sign = dir === "next" ? -1 : 1;
        anim = animateSpring({
          from: x,
          to: sign * fadeDistance(),
          velocity,
          response: 0.22,
          onUpdate: (v) => {
            x = v;
            paint(leaving, v);
          },
          onRest: () => {
            paint(leaving, 0);
            go();
            x = -sign * fadeDistance() * 0.5;
            paint(visible(), x);
            settle();
          },
        });
      };

      dialog.addEventListener("close", () => {
        anim?.stop();
        anim = null;
        x = 0;
        sections.forEach((el) => paint(el, 0));
        paint(finishScreen, 0);
      });

      let pointerId: number | null = null;
      let tracking = false;
      let startX = 0;
      let startY = 0;
      let grabX = 0;
      let baseX = 0;
      let samples: MotionSample[] = [];

      stage?.addEventListener("pointerdown", (e) => {
        if (e.pointerType === "mouse" || !e.isPrimary) return;
        pointerId = e.pointerId;
        tracking = false;
        startX = e.clientX;
        startY = e.clientY;
        samples = [];
        if (anim) {
          // Перехват на лету: продолжаем с того места, где элемент сейчас на экране.
          x = anim.stop().value;
          anim = null;
        }
        baseX = x;
      });

      stage?.addEventListener("pointermove", (e) => {
        if (e.pointerId !== pointerId || prefersReducedMotion()) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (!tracking) {
          // Порог 10 px: сначала понимаем направление, вертикаль оставляем прокрутке.
          if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return;
          if (Math.abs(dy) > Math.abs(dx)) {
            pointerId = null;
            if (x !== 0) settle();
            return;
          }
          tracking = true;
          grabX = dx;
          stage.setPointerCapture(e.pointerId);
        }
        const raw = baseX + dx - grabX;
        // Назад с первого шага листать некуда — упругая граница вместо жёсткой остановки.
        x = raw > 0 && !canPrev() ? rubberband(raw, stageWidth()) : raw;
        paint(visible(), x);
        samples.push({ t: e.timeStamp, p: e.clientX });
        if (samples.length > 8) samples.shift();
      });

      const release = (e: PointerEvent, cancelled: boolean) => {
        if (e.pointerId !== pointerId) return;
        pointerId = null;
        if (prefersReducedMotion()) {
          const dir = cancelled ? null : swipeDirection(e.clientX - startX, e.clientY - startY);
          if (dir) turn(dir);
          return;
        }
        if (!tracking) {
          if (x !== 0) settle();
          return;
        }
        tracking = false;
        const velocity = cancelled ? 0 : releaseVelocity(samples, e.timeStamp);
        const projected = x + project(velocity);
        const threshold = stageWidth() * 0.3;
        if (!cancelled && projected < -threshold && !this.finished) turn("next", velocity);
        else if (!cancelled && projected > threshold && canPrev()) turn("prev", velocity);
        else settle(velocity);
      };
      stage?.addEventListener("pointerup", (e) => release(e, false));
      stage?.addEventListener("pointercancel", (e) => release(e, true));
    }
  }

  if (!customElements.get("cook-mode")) customElements.define("cook-mode", CookMode);
</script>
