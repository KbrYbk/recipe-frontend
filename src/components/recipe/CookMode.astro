---
/**
 * «Режим готовки»: полноэкранный пошаговый просмотр крупным шрифтом.
 * Навигация: кнопки, ←/→ (и Space/PageDown), свайп; экран не гаснет (Screen Wake Lock API, если поддерживается);
 * отметки шагов и ингредиентов — общие с основной страницей (localStorage).
 */
import { Icon } from "astro-icon/components";
import type { Ingredient, Step } from "../../types/recipe";
import { formatIngredientAmount } from "../../lib/normalizeIngredients";

interface Props {
  recipeId: number;
  title: string;
  steps: Step[];
  ingredients: Ingredient[];
}

const { recipeId, title, steps, ingredients } = Astro.props;
const plain = (t: string) => t.replace(/<br\s*\/?>/gi, "\n").replace(/\\r\\n|\\n/g, "\n");
---

{
  steps.length > 0 && (
    <cook-mode data-recipe-id={recipeId} data-total={steps.length}>
      <dialog class="cook-dialog bg-page-bg text-text-main m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden p-0 backdrop:bg-black/80" aria-labelledby="cook-title" data-cook-dialog>
        <div class="flex h-full flex-col">
          <header class="border-line flex items-center gap-3 border-b px-4 py-3">
            <button type="button" class="hover:text-brand flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-xl" aria-label="Закрыть режим готовки" data-cook-close>
              <Icon name="lucide:x" class="h-6 w-6" aria-hidden="true" />
            </button>
            <div class="min-w-0 flex-1">
              <p id="cook-title" class="truncate text-sm font-semibold md:text-base">
                {title}
              </p>
              <p class="text-text-muted text-xs" aria-live="polite">
                Шаг <span data-cook-current>1</span> из {steps.length}
                <span class="hidden" data-cook-wakelock>
                  {" "}
                  · экран не погаснет
                </span>
              </p>
            </div>
            {ingredients.length > 0 && (
              <button
                type="button"
                class="glass-border-3d hover:text-brand flex h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3 text-sm font-semibold"
                aria-expanded="false"
                aria-controls="cook-ingredients"
                data-cook-ingredients-toggle
              >
                <Icon name="lucide:shopping-basket" class="h-5 w-5" aria-hidden="true" />
                <span class="hidden sm:inline">Ингредиенты</span>
              </button>
            )}
          </header>

          <div class="bg-line h-1 w-full" aria-hidden="true">
            <div class="bg-brand h-1 transition-[width] duration-300" style="width:0%" data-cook-progress />
          </div>

          <div class="relative min-h-0 flex-1">
            <div class="h-full overflow-y-auto overscroll-contain px-5 py-6 md:px-10 md:py-10" data-cook-stage>
              {steps.map((step, index) => (
                <section class="mx-auto hidden max-w-3xl" data-cook-step={index} aria-label={`Шаг ${index + 1}`}>
                  <p class="text-brand mb-4 text-sm font-bold tracking-wider uppercase">Шаг {index + 1}</p>
                  <p class="text-2xl leading-relaxed font-medium whitespace-pre-line md:text-4xl md:leading-snug">{plain(step.text)}</p>
                  {step.image && <img src={step.image} alt="" loading="lazy" decoding="async" class="mt-6 max-h-[40vh] w-auto rounded-2xl object-contain" width="800" height="450" />}
                  <label class="glass-border-3d mt-8 inline-flex cursor-pointer items-center gap-3 rounded-2xl px-5 py-3 text-lg font-semibold">
                    <input type="checkbox" class="accent-brand h-6 w-6" data-cook-step-done={index} />
                    Шаг выполнен
                  </label>
                </section>
              ))}
            </div>

            {ingredients.length > 0 && (
              <aside
                id="cook-ingredients"
                class="bg-card-bg border-line absolute inset-y-0 right-0 hidden w-full max-w-sm overflow-y-auto border-l p-5 shadow-2xl"
                aria-label="Ингредиенты"
                data-cook-ingredients
              >
                <h2 class="mb-4 text-xl font-bold">Ингредиенты</h2>
                <ul class="space-y-2">
                  {ingredients.map((item, i) => {
                    const amount = formatIngredientAmount(item);
                    return (
                      <li>
                        <label class="hover:bg-page-bg/60 flex cursor-pointer items-start gap-3 rounded-xl p-2 text-lg">
                          <input type="checkbox" class="accent-brand mt-1 h-5 w-5 shrink-0" data-cook-ingredient={i} />
                          <span>
                            {item.name}
                            {amount && <span class="text-text-muted block text-sm">{amount}</span>}
                          </span>
                        </label>
                      </li>
                    );
                  })}
                </ul>
              </aside>
            )}
          </div>

          <footer class="border-line flex items-center gap-3 border-t px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
            <button type="button" class="glass-border-3d flex h-14 flex-1 cursor-pointer items-center justify-center gap-2 rounded-2xl text-lg font-bold disabled:opacity-40" data-cook-prev>
              <Icon name="lucide:arrow-left" class="h-5 w-5" aria-hidden="true" />
              Назад
            </button>
            <button type="button" class="bg-brand hover:bg-brand-hover flex h-14 flex-1 cursor-pointer items-center justify-center gap-2 rounded-2xl text-lg font-bold text-white" data-cook-next>
              <span data-cook-next-label>Далее</span>
              <Icon name="lucide:arrow-right" class="h-5 w-5" aria-hidden="true" />
            </button>
          </footer>
        </div>
      </dialog>
    </cook-mode>
  )
}

<style>
  .cook-dialog[open] {
    display: block;
  }
  .accent-brand {
    accent-color: var(--brand-primary);
  }
</style>

<script>
  import { clampStep, cookPositionKey, ingredientKey, stepKey, swipeDirection } from "../../lib/cookState";
  import { readString, writeString } from "../../lib/client/storage";

  type WakeLockSentinelLike = { release: () => Promise<void>; addEventListener: (t: "release", cb: () => void) => void };
  type NavigatorWithWakeLock = Navigator & { wakeLock?: { request: (type: "screen") => Promise<WakeLockSentinelLike> } };

  class CookMode extends HTMLElement {
    private index = 0;
    private wakeLock: WakeLockSentinelLike | null = null;

    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>("[data-cook-dialog]");
      const recipeId = Number(this.dataset.recipeId);
      const total = Number(this.dataset.total);
      if (!dialog || !recipeId || !total) return;

      const sections = Array.from(this.querySelectorAll<HTMLElement>("[data-cook-step]"));
      const current = this.querySelector("[data-cook-current]");
      const progress = this.querySelector<HTMLElement>("[data-cook-progress]");
      const prevBtn = this.querySelector<HTMLButtonElement>("[data-cook-prev]");
      const nextBtn = this.querySelector<HTMLButtonElement>("[data-cook-next]");
      const nextLabel = this.querySelector("[data-cook-next-label]");
      const stage = this.querySelector<HTMLElement>("[data-cook-stage]");
      const ingPanel = this.querySelector<HTMLElement>("[data-cook-ingredients]");
      const ingToggle = this.querySelector<HTMLElement>("[data-cook-ingredients-toggle]");
      const wakeHint = this.querySelector<HTMLElement>("[data-cook-wakelock]");

      const stepBoxes = Array.from(this.querySelectorAll<HTMLInputElement>("[data-cook-step-done]"));
      const ingBoxes = Array.from(this.querySelectorAll<HTMLInputElement>("[data-cook-ingredient]"));

      const loadChecks = () => {
        stepBoxes.forEach((cb) => (cb.checked = readString(stepKey(recipeId, Number(cb.dataset.cookStepDone))) === "1"));
        ingBoxes.forEach((cb) => (cb.checked = readString(ingredientKey(recipeId, Number(cb.dataset.cookIngredient))) === "1"));
      };

      stepBoxes.forEach((cb) =>
        cb.addEventListener("change", () => {
          writeString(stepKey(recipeId, Number(cb.dataset.cookStepDone)), cb.checked ? "1" : null);
          document.dispatchEvent(new CustomEvent("recipe:cook-steps-changed"));
        }),
      );
      ingBoxes.forEach((cb) =>
        cb.addEventListener("change", () => {
          writeString(ingredientKey(recipeId, Number(cb.dataset.cookIngredient)), cb.checked ? "1" : null);
          document.dispatchEvent(new CustomEvent("recipe:cook-ingredients-changed"));
        }),
      );

      const show = (i: number) => {
        this.index = clampStep(i, total);
        sections.forEach((s, n) => s.classList.toggle("hidden", n !== this.index));
        if (current) current.textContent = String(this.index + 1);
        if (progress) progress.style.width = `${((this.index + 1) / total) * 100}%`;
        if (prevBtn) prevBtn.disabled = this.index === 0;
        if (nextLabel) nextLabel.textContent = this.index === total - 1 ? "Готово" : "Далее";
        stage?.scrollTo({ top: 0 });
        writeString(cookPositionKey(recipeId), String(this.index));
      };

      const next = () => {
        if (this.index >= total - 1) {
          // последний шаг: отметить выполненным и закрыть
          const last = stepBoxes[this.index];
          if (last && !last.checked) {
            last.checked = true;
            last.dispatchEvent(new Event("change"));
          }
          dialog.close();
          return;
        }
        show(this.index + 1);
      };
      const prev = () => show(this.index - 1);

      const requestWakeLock = async () => {
        const nav = navigator as NavigatorWithWakeLock;
        if (!nav.wakeLock || document.visibilityState !== "visible") return;
        try {
          this.wakeLock = await nav.wakeLock.request("screen");
          wakeHint?.classList.remove("hidden");
          this.wakeLock.addEventListener("release", () => wakeHint?.classList.add("hidden"));
        } catch {
          this.wakeLock = null;
        }
      };
      const releaseWakeLock = () => {
        this.wakeLock?.release().catch(() => {});
        this.wakeLock = null;
      };
      const onVisibility = () => {
        if (dialog.open && document.visibilityState === "visible") requestWakeLock();
      };

      const open = (startAt?: number) => {
        loadChecks();
        const saved = Number(readString(cookPositionKey(recipeId)) ?? 0);
        show(startAt ?? saved);
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
        requestWakeLock();
        document.addEventListener("visibilitychange", onVisibility);
      };

      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = "";
        releaseWakeLock();
        document.removeEventListener("visibilitychange", onVisibility);
      });

      document.querySelectorAll("[data-cook-open]").forEach((btn) => btn.addEventListener("click", () => open()));
      this.querySelector("[data-cook-close]")?.addEventListener("click", () => dialog.close());
      prevBtn?.addEventListener("click", prev);
      nextBtn?.addEventListener("click", next);

      ingToggle?.addEventListener("click", () => {
        const opened = ingPanel?.classList.toggle("hidden") === false;
        ingToggle.setAttribute("aria-expanded", String(opened));
      });

      dialog.addEventListener("keydown", (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.tagName === "INPUT" && e.key === " ") return;
        if (e.key === "ArrowRight" || e.key === "PageDown") {
          e.preventDefault();
          next();
        } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
          e.preventDefault();
          prev();
        }
      });

      let startX = 0;
      let startY = 0;
      stage?.addEventListener(
        "touchstart",
        (e) => {
          startX = e.changedTouches[0].clientX;
          startY = e.changedTouches[0].clientY;
        },
        { passive: true },
      );
      stage?.addEventListener(
        "touchend",
        (e) => {
          const dir = swipeDirection(e.changedTouches[0].clientX - startX, e.changedTouches[0].clientY - startY);
          if (dir === "next" && this.index < total - 1) show(this.index + 1);
          else if (dir === "prev") prev();
        },
        { passive: true },
      );
    }
  }

  if (!customElements.get("cook-mode")) customElements.define("cook-mode", CookMode);
</script>
