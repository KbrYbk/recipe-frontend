---
/**
 * Шапка рецепта: заголовок, чипы (время, сложность, рейтинг) и действия.
 * Десктоп: одна строка — чипы | вторичные действия (Избранное, Лайк, Поделиться, Печать) | «Режим готовки».
 * Мобильный: чипы в одну строку, действия — ряд иконок, «Режим готовки» во всю ширину, «Печать» скрыта.
 */
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import RatingStars from "./RatingStars.astro";
import FavoriteButton from "./FavoriteButton.astro";
import LikeButton from "./LikeButton.astro";
import ShareButton from "./ShareButton.astro";
import { formatTime } from "../../lib/formatTime";
import { ACTION_BUTTON_CLASS, ACTION_LABEL_CLASS } from "./actionStyles";
import type { Recipe } from "../../types/recipe";
import { isoDate, servingsText } from "../../lib/recipeSchema";

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const { id, title, cooking_time, difficulty, servings } = recipe;
const calories = recipe.nutrition?.calories;

const difficultyLabel = difficulty === "hard" ? "Сложно" : difficulty === "medium" ? "Средне" : "Легко";
const difficultyClass = difficulty === "hard" ? "text-negative" : difficulty === "medium" ? "text-rating" : "text-positive";
// Автор и даты видимы на странице (E-E-A-T): то же, что в разметке Recipe.
const dateFormat = new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Moscow" });
const published = isoDate(recipe.created_at);
const updated = isoDate(recipe.updated_at);
const showUpdated = !!published && !!updated && updated.slice(0, 10) !== published.slice(0, 10);
// Мета рецепта — тихая строка без рамок: значение читается, хром не спорит с фото.
const chip = "inline-flex h-10 shrink-0 items-center gap-1.5 text-sm";
---

<header class="mb-6 lg:mb-0">
  <h1 class="page-title text-text-main mb-3 md:mb-4 lg:text-[2.75rem] xl:text-[3.25rem] print:mb-2 print:border-b print:border-black print:pb-1 print:text-[18pt] print:font-semibold">
    {title}
  </h1>

  <p class="text-text-muted mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm print:mb-2" data-recipe-byline>
    <span>Пошаговый рецепт с фото</span>
    <span aria-hidden="true">·</span>
    <span>Автор: <span class="text-text-main font-medium">{recipe.author || "Редакция SwagEda"}</span></span>
    {
      published && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            Опубликовано: <time datetime={published}>{dateFormat.format(new Date(published))}</time>
          </span>
        </>
      )
    }
    {
      showUpdated && updated && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            Обновлено: <time datetime={updated}>{dateFormat.format(new Date(updated))}</time>
          </span>
        </>
      )
    }
  </p>

  <nav class="mb-3 flex flex-wrap gap-2 text-sm font-medium md:mb-4 print:hidden" aria-label="Разделы рецепта">
    <a href="#ingredients" class="text-brand-ink hover:underline">Ингредиенты</a>
    <span class="text-text-muted" aria-hidden="true">·</span>
    <a href="#steps-heading" class="text-brand-ink hover:underline">К рецепту</a>
  </nav>

  <div class="flex flex-col gap-3 print:mb-4">
    <!-- Чипы: на мобильном одна строка (при нехватке места — горизонтальная прокрутка без полосы) -->
    <div class="-mx-1 flex items-center gap-5 overflow-x-auto px-1 py-1 [scrollbar-width:none] lg:mx-0 lg:flex-wrap lg:gap-y-0 lg:overflow-visible lg:px-0 [&::-webkit-scrollbar]:hidden">
      {
        cooking_time > 0 && (
          <span class={`${chip} text-text-main font-medium`} aria-label={`Время приготовления: ${formatTime(cooking_time)}`}>
            <Icon name="lucide:clock" class="text-text-muted h-4 w-4 shrink-0" aria-hidden="true" />
            <span class="whitespace-nowrap tabular-nums">{formatTime(cooking_time)}</span>
          </span>
        )
      }
      {
        difficulty && (
          <span class={`${chip} ${difficultyClass} font-medium print:text-black`} aria-label={`Сложность: ${difficultyLabel}`}>
            <Icon name="lucide:flame" class="h-4 w-4 shrink-0" aria-hidden="true" />
            <span>{difficultyLabel}</span>
          </span>
        )
      }
      {
        calories && (
          <span class={`${chip} text-text-main font-medium`} aria-label={`Калорийность: ${calories} ккал на 100 граммов`} data-recipe-calories>
            <Icon name="lucide:zap" class="text-text-muted h-4 w-4 shrink-0" aria-hidden="true" />
            <span class="whitespace-nowrap tabular-nums">
              {calories} ккал <span class="text-text-muted font-normal">/ 100 г</span>
            </span>
          </span>
        )
      }
      {
        servings && (
          <span class={`${chip} text-text-main font-medium`} aria-label={`Количество порций: ${servings}`} data-recipe-servings>
            <Icon name="lucide:users" class="text-text-muted h-4 w-4 shrink-0" aria-hidden="true" />
            <span class="whitespace-nowrap tabular-nums">{servingsText(servings)}</span>
          </span>
        )
      }
      <RatingStars recipeId={id} averageRating={recipe.average_rating} />
    </div>

    <div class="hidden" aria-hidden="true"></div>

    <!-- Вторичные действия: на мобильном — иконки (подписи в aria-label), с sm — с подписями -->
    <div class="flex items-center gap-2 print:hidden" role="group" aria-label="Действия с рецептом">
      <FavoriteButton recipeId={id} />
      <LikeButton recipeId={id} />
      <ShareButton />
      <div class="hidden sm:block">
        <Button variant="outline" size="sm" id="printRecipeBtn" class={ACTION_BUTTON_CLASS} aria-label="Печать рецепта">
          <Icon name="lucide:printer" slot="icon-left" class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span class={ACTION_LABEL_CLASS}>Печать</span>
        </Button>
      </div>
    </div>

    {
      recipe.steps.length > 0 && (
        <Button variant="primary" class="mt-1 h-12 w-full text-base sm:max-w-xs print:hidden" data-cook-open>
          <Icon name="lucide:chef-hat" slot="icon-left" class="h-5 w-5 shrink-0" aria-hidden="true" />
          Режим готовки
        </Button>
      )
    }
  </div>
</header>

<script>
  import "../../scripts/recipe-page";
</script>
