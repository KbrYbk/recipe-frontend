---
/**
 * Шапка рецепта: заголовок, чипы (время, сложность, рейтинг) и действия.
 * Десктоп: одна строка — чипы | вторичные действия (Избранное, Лайк, Поделиться, Печать) | «Режим готовки».
 * Мобильный: чипы в одну строку, действия — ряд иконок, «Режим готовки» во всю ширину, «Печать» скрыта.
 */
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import RatingStars from "./RatingStars.astro";
import FavoriteButton from "./FavoriteButton.astro";
import LikeButton from "./LikeButton.astro";
import ShareButton from "./ShareButton.astro";
import { formatTime } from "../../lib/formatTime";
import { ACTION_BUTTON_CLASS, ACTION_LABEL_CLASS } from "./actionStyles";
import type { Recipe } from "../../types/recipe";

interface Props {
  recipe: Recipe;
}
const { recipe } = Astro.props;
const { id, title, cooking_time, difficulty } = recipe;

const difficultyLabel = difficulty === "hard" ? "Сложно" : difficulty === "medium" ? "Средне" : "Легко";
const difficultyClass =
  difficulty === "hard" ? "bg-red-500/15 text-red-500" : difficulty === "medium" ? "bg-amber-500/15 text-amber-600 dark:text-amber-500" : "bg-emerald-500/15 text-emerald-600 dark:text-emerald-500";
const chip = "glass-border-3d inline-flex h-10 shrink-0 items-center gap-1.5 rounded-2xl px-3 text-sm shadow-sm shadow-black/15 print:border-none print:px-0";
---

<header class="mb-6 md:mb-10">
  <h1
    class="text-text-main mb-4 text-3xl leading-tight font-bold text-balance md:mb-6 md:text-5xl lg:text-6xl print:mb-2 print:border-b print:border-black print:pb-1 print:text-[18pt] print:font-extrabold"
  >
    {title}
  </h1>

  <div class="flex flex-col gap-3 lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-3 print:mb-4">
    <!-- Чипы: на мобильном одна строка (при нехватке места — горизонтальная прокрутка без полосы) -->
    <div class="-mx-1 flex items-center gap-2 overflow-x-auto px-1 py-1 [scrollbar-width:none] lg:mx-0 lg:overflow-visible lg:px-0 [&::-webkit-scrollbar]:hidden">
      {
        cooking_time > 0 && (
          <span class={`${chip} bg-card-bg/20 text-text-main font-medium backdrop-blur-md`} aria-label={`Время приготовления: ${formatTime(cooking_time)}`}>
            <Icon name="lucide:clock" class="text-brand h-4 w-4 shrink-0" aria-hidden="true" />
            <span class="whitespace-nowrap tabular-nums">{formatTime(cooking_time)}</span>
          </span>
        )
      }
      {
        difficulty && (
          <span class={`${chip} ${difficultyClass} text-xs font-bold tracking-wide uppercase print:bg-transparent print:text-black`} aria-label={`Сложность: ${difficultyLabel}`}>
            <Icon name="lucide:flame" class="h-4 w-4 shrink-0" aria-hidden="true" />
            <span>{difficultyLabel}</span>
          </span>
        )
      }
      <RatingStars recipeId={id} averageRating={recipe.average_rating} />
    </div>

    <div class="bg-line mx-1 hidden h-6 w-px lg:block print:hidden" aria-hidden="true"></div>

    <!-- Вторичные действия: на мобильном — иконки (подписи в aria-label), с sm — с подписями -->
    <div class="flex items-center gap-2 print:hidden" role="group" aria-label="Действия с рецептом">
      <FavoriteButton recipeId={id} />
      <LikeButton recipeId={id} />
      <ShareButton />
      <div class="hidden sm:block">
        <Button variant="outline" size="sm" id="printRecipeBtn" class={ACTION_BUTTON_CLASS} aria-label="Печать рецепта">
          <Icon name="lucide:printer" slot="icon-left" class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span class={ACTION_LABEL_CLASS}>Печать</span>
        </Button>
      </div>
    </div>

    {
      recipe.steps.length > 0 && (
        <Button variant="primary" class="h-12 w-full text-base lg:ml-auto lg:h-11 lg:w-auto lg:px-5 print:hidden" data-cook-open>
          <Icon name="lucide:chef-hat" slot="icon-left" class="h-5 w-5 shrink-0" aria-hidden="true" />
          Режим готовки
        </Button>
      )
    }
  </div>
</header>

<script>
  import "../../scripts/recipe-page";
</script>
