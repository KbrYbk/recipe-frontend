---
import RecipeCard from "../RecipeCard.astro";
import type { RecipeCard as Card } from "../../types/recipe";

interface Props {
  recipes: Card[];
  categoryHref?: string;
  categoryTitle?: string;
}
const { recipes, categoryHref, categoryTitle } = Astro.props;
---

{
  recipes.length > 0 && (
    <section aria-labelledby="similar-heading" class="mt-12 print:hidden">
      <div class="mb-5 flex items-baseline justify-between gap-4 md:mb-6">
        <h2 id="similar-heading" class="section-title text-text-main">
          Похожие рецепты
        </h2>
        {categoryHref && (
          <a href={categoryHref} class="text-brand-ink shrink-0 text-sm font-medium hover:underline">
            {categoryTitle ? `Все рецепты: ${categoryTitle}` : "Все в категории"} &rarr;
          </a>
        )}
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
        {recipes.map((r) => (
          <RecipeCard recipe={r} headingLevel="h3" />
        ))}
      </div>
    </section>
  )
}
