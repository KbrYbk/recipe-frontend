---
import RecipeCard from "../RecipeCard.astro";
import type { RecipeCard as Card } from "../../types/recipe";

interface Props {
  recipes: Card[];
  categoryHref?: string;
}
const { recipes, categoryHref } = Astro.props;
---

{
  recipes.length > 0 && (
    <section aria-labelledby="similar-heading" class="mt-16 print:hidden">
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 id="similar-heading" class="text-text-main text-2xl font-bold md:text-3xl">
          Похожие рецепты
        </h2>
        {categoryHref && (
          <a href={categoryHref} class="text-brand shrink-0 text-sm font-semibold hover:underline">
            Все в категории &rarr;
          </a>
        )}
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recipes.map((r) => (
          <RecipeCard recipe={r} headingLevel="h3" />
        ))}
      </div>
    </section>
  )
}
