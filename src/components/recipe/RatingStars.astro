---
interface Props {
  recipeId: number;
  averageRating: number;
}
const { recipeId, averageRating } = Astro.props;
---

<rating-stars data-id={recipeId} data-avg={averageRating} class="block w-full sm:w-auto">
  <div
    class="rating-container glass-border-3d bg-card-bg/20 hover:bg-card-bg/40 flex h-11 w-full items-center justify-center gap-2 rounded-2xl px-3 text-sm font-bold text-amber-500 shadow-sm shadow-black/15 backdrop-blur-md transition-all hover:shadow-md hover:shadow-black/20 sm:w-auto"
    role="group"
    aria-label={`Рейтинг: ${averageRating ? Number(averageRating).toFixed(1) : "0"} из 5`}
  >
    <div class="stars-container flex gap-0.5" role="radiogroup" aria-label="Ваша оценка">
      {
        [1, 2, 3, 4, 5].map((star) => (
          <button
            type="button"
            data-star={star}
            class="star-btn focus: focus-visible:ring-brand rounded-md p-1 transition-transform outline-none hover:scale-110 focus-visible:ring-2 disabled:hover:scale-100"
            aria-label={`Оценить на ${star}`}
            aria-pressed="false"
          >
            <svg class="star-svg h-5 w-5 shrink-0 fill-none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
            </svg>
          </button>
        ))
      }
    </div>
    <div class="text-text-main ml-1">
      <span class="avg-val font-bold">{averageRating ? Number(averageRating).toFixed(1) : "0"}</span>
      <span class="sr-only"> из 5</span>
      <span class="user-val text-text-muted hidden text-xs">Ваша оценка: <span class="val text-text-main font-semibold"></span></span>
    </div>
  </div>
</rating-stars>
<style>
  /* Залитая звезда: fill берёт currentColor (янтарный), stroke остаётся */
  .star-btn.filled .star-svg {
    fill: currentColor;
  }
</style>

<script>
  import { setRating } from "../../lib/client/api";
  import { getMyRating, setMyRating } from "../../lib/client/storage";
  import { showToast } from "../../lib/client/toast";

  const MESSAGES = ["Ваш голос учтён. Спасибо!", "Оценка в базе! Теперь вы официально ресторанный критик.", "Спасибо за отзыв! Приятного аппетита.", "Оценка сохранена. Готовьте с удовольствием!"];

  class RatingStars extends HTMLElement {
    connectedCallback() {
      const container = this.querySelector(".rating-container");
      const stars = this.querySelectorAll<HTMLButtonElement>(".star-btn");
      const avgValSpan = this.querySelector(".avg-val");
      const userValContainer = this.querySelector(".user-val");
      const userValSpan = this.querySelector(".val");

      const recipeId = Number(this.dataset.id);
      // Звёзды по средней оценке без округления вверх
      const baseVal = Math.floor(parseFloat(this.dataset.avg || "0"));
      if (!recipeId || !container) return;

      let isProcessing = false;
      let locked = false;

      const renderStars = (val: number) => {
        stars.forEach((s) => {
          const filled = parseInt(s.dataset.star || "0") <= val;
          s.querySelector("svg")
            ?.querySelectorAll("path")
            .forEach((p) => p.setAttribute("fill", filled ? "currentColor" : "none"));
          s.setAttribute("aria-pressed", String(filled));
          s.classList.toggle("scale-110", filled && !locked);
        });
      };

      const showUserValue = (val: number) => {
        userValContainer?.classList.remove("hidden");
        if (userValSpan) userValSpan.textContent = String(val);
      };

      const reset = () => {
        isProcessing = false;
        userValContainer?.classList.add("hidden");
        renderStars(baseVal);
      };

      const lockRating = (val: number) => {
        locked = true;
        renderStars(val);
        showUserValue(val);
        stars.forEach((s) => {
          s.disabled = true;
          s.classList.add("cursor-default");
          s.classList.remove("hover:scale-110");
        });
        container.classList.add("opacity-90");
      };

      const saved = getMyRating(recipeId);
      if (saved) {
        lockRating(saved);
        return;
      }

      renderStars(baseVal);

      stars.forEach((btn) => {
        btn.addEventListener("mouseenter", () => {
          if (isProcessing || locked) return;
          const val = parseInt(btn.dataset.star || "0");
          renderStars(val);
          showUserValue(val);
        });

        btn.addEventListener("click", async () => {
          if (isProcessing || locked) return;
          isProcessing = true;
          const rating = parseInt(btn.dataset.star || "0");
          try {
            const res = await setRating(recipeId, rating);
            let body: { data?: { average_rating?: number }; average_rating?: number } | null = null;
            try {
              body = await res.json();
            } catch {
              body = null;
            }

            if (res.ok) {
              const newAvg = body?.data?.average_rating ?? body?.average_rating;
              if (avgValSpan && newAvg) avgValSpan.textContent = Number(newAvg).toFixed(1);
              setMyRating(recipeId, rating);
              lockRating(rating);
              showToast(MESSAGES[Math.floor(Math.random() * MESSAGES.length)], "success");
            } else if (res.status === 409 || res.status === 403) {
              // Голос с этого адреса уже есть (409 — новый API, 403 — старый).
              setMyRating(recipeId, rating);
              lockRating(rating);
              showToast("Вы уже оценивали этот рецепт", "info");
            } else {
              reset();
              showToast("Не получилось сохранить оценку. Попробуйте позже", "error");
            }
          } catch {
            reset();
            showToast("Нет соединения. Попробуйте позже", "error");
          }
        });
      });

      container.addEventListener("mouseleave", () => {
        if (isProcessing || locked) return;
        userValContainer?.classList.add("hidden");
        renderStars(baseVal);
      });
    }
  }

  if (!customElements.get("rating-stars")) customElements.define("rating-stars", RatingStars);
</script>
