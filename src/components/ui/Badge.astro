---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  variant?: "brand" | "easy" | "medium" | "hard" | "neutral";
  size?: "sm" | "md";
  class?: string;
}

const { variant = "neutral", size = "md", class: className = "", ...rest } = Astro.props;

const baseStyles = "inline-flex items-center font-medium rounded-xl gap-1.5 transition-colors select-none backdrop-blur-md shadow-sm shadow-black/15";

const variants = {
  brand: "bg-brand/10 text-brand glass-border-3d",
  easy: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 glass-border-3d",
  medium: "bg-amber-500/10 text-amber-600 dark:text-amber-400 glass-border-3d",
  hard: "bg-rose-500/10 text-rose-600 dark:text-rose-400 glass-border-3d",
  neutral: "bg-accent-soft text-text-muted glass-border-3d",
  success: "bg-green-100 text-green-800 glass-border-3d dark:bg-green-900/30 dark:text-green-400",
};

const sizes = {
  sm: "px-2.5 py-0.5 text-xs",
  md: "px-3.5 py-1 text-sm",
};

const classes = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(" ");
---

<span class={classes} {...rest}>
  <slot name="icon" />
  <slot />
</span>
