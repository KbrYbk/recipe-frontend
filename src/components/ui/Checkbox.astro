---
import type { HTMLAttributes } from "astro/types";
import { CHECKBOX_CLASS } from "../../lib/ui";

interface Props extends HTMLAttributes<"input"> {
  class?: string;
}

const { class: className = "", ...rest } = Astro.props;
const size = /(^|\s)h-\d/.test(className) ? "" : "h-6 w-6";
// Классы и стили галочки (.app-checkbox в global.css) общие с чекбоксами, которые создаёт JS (список покупок).
---

<!--
  Контрастный чекбокс: рамка 2px (≥3:1 к фону карточки в обеих темах), отмеченный — оранжевый с белой галочкой.
-->
<input type="checkbox" class:list={[size, CHECKBOX_CLASS, "print:h-4 print:w-4 print:appearance-auto print:rounded-none print:border print:border-black print:bg-transparent", className]} {...rest} />
