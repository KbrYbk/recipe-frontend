---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  padding?: "none" | "sm" | "md" | "lg";
  hoverable?: boolean;
};

const { as: Tag = "div", padding = "md", hoverable = false, class: className, ...rest } = Astro.props;

const paddingClasses: Record<"none" | "sm" | "md" | "lg", string> = {
  none: "",
  sm: "p-4 sm:p-5",
  md: "p-5 md:p-6",
  lg: "p-6 md:p-8",
};

const baseClasses = [
  "glass-border-3d bg-card-bg shadow-soft rounded-panel",
  paddingClasses[padding as keyof typeof paddingClasses],
  hoverable ? "transition-colors duration-150 hover:bg-raised" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<Tag class={baseClasses} {...rest}>
  <slot />
</Tag>
