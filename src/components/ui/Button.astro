---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "danger";
  size?: "xs" | "sm" | "md" | "lg" | "icon";
  href?: string;
  rel?: string;
  isExternal?: boolean;
  fullWidth?: boolean;
  as?: "a" | "button" | "label" | "span" | "div";
  class?: string;
}

const { variant = "primary", size = "md", href, isExternal = false, fullWidth = false, as: Tag, class: className = "", type = "button", ...rest } = Astro.props;

const Component = Tag || (href ? "a" : "button");

// Отклик на нажатие — сразу (pressable), фокус с клавиатуры — общее кольцо (focus-ring). Свечений и размытия нет.
const baseStyles =
  "pressable focus-ring inline-flex items-center justify-center font-semibold rounded-control transition-[background-color,color,box-shadow,transform] duration-150 ease-soft disabled:opacity-50 disabled:pointer-events-none select-none cursor-pointer whitespace-nowrap";

const variants = {
  primary: "btn-primary",
  secondary: "glass-border-3d bg-card-bg text-text-main shadow-soft hover:bg-raised",
  outline: "glass-border-3d bg-transparent text-text-main hover:bg-raised",
  ghost: "text-text-main hover:bg-raised",
  danger: "bg-negative text-page-bg hover:opacity-90",
};

const sizes = {
  xs: "px-3 py-1.5 text-xs gap-1",
  sm: "px-4 py-2 text-sm gap-1.5",
  md: "px-5 py-2.5 text-base gap-2",
  lg: "px-6 py-3 text-base md:text-lg gap-2.5",
  // Видимый размер 40px, область нажатия — 44px (псевдоэлемент), чтобы не менять высоту шапки.
  icon: "relative h-10 w-10 p-0 justify-center before:absolute before:-inset-0.5 before:content-['']",
};

const widthStyle = fullWidth ? "w-full" : "";

const classes = [baseStyles, variants[variant], sizes[size], widthStyle, className].filter(Boolean).join(" ");
---

<Component href={href} class={classes} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined} type={Component === "button" ? type : undefined} {...rest}>
  <slot name="icon-left" />
  <slot />
  <slot name="icon-right" />
</Component>
