---
import { Icon } from "astro-icon/components";
import { paginationItems } from "../../lib/pagination";

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrlFunc: (page: number) => string;
}

const { currentPage, totalPages, baseUrlFunc } = Astro.props;

// Например, 83 из 137: 1 … 33 … 73 … 81 82 [83] 84 85 … 93 … 133 … 137 — соседние страницы и «скачки» ±10/±50/±100.
const pages = paginationItems(currentPage, totalPages);
---

<nav class="flex items-center justify-center gap-2" aria-label="Пагинация">
  <a
    href={currentPage > 1 ? baseUrlFunc(currentPage - 1) : "#"}
    class:list={[
      "glass-border-3d flex h-12 w-12 items-center justify-center rounded-xl shadow-sm shadow-black/15 transition-all",
      currentPage <= 1 ? "pointer-events-none opacity-30" : "hover:border-brand hover:text-brand bg-card-bg shadow-sm",
    ]}
    aria-disabled={currentPage <= 1}
  >
    <Icon name="lucide:chevron-left" class="h-5 w-5" />
  </a>

  <div class="flex flex-wrap items-center justify-center gap-2">
    {
      pages.map((p) =>
        p === "..." ? (
          <span class="text-text-muted px-2">...</span>
        ) : (
          <a
            href={baseUrlFunc(p as number)}
            class:list={[
              "glass-border-3d flex h-12 min-w-12 items-center justify-center rounded-xl px-4 font-bold transition-all",
              currentPage === p ? "bg-brand shadow-brand/30 text-white shadow-md" : "bg-card-bg text-text-muted hover:text-brand shadow-sm shadow-black/15 hover:shadow-md hover:shadow-black/20",
            ]}
            aria-current={currentPage === p ? "page" : undefined}
          >
            {p}
          </a>
        ),
      )
    }
  </div>

  <a
    href={currentPage < totalPages ? baseUrlFunc(currentPage + 1) : "#"}
    class:list={[
      "glass-border-3d flex h-12 w-12 items-center justify-center rounded-xl shadow-sm shadow-black/15 transition-all",
      currentPage >= totalPages ? "pointer-events-none opacity-30" : "hover:border-brand hover:text-brand bg-card-bg shadow-sm",
    ]}
    aria-disabled={currentPage >= totalPages}
  >
    <Icon name="lucide:chevron-right" class="h-5 w-5" />
  </a>
</nav>
