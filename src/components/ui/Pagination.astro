---
import { Icon } from "astro-icon/components";
import { responsivePaginationItems, visibilityClass } from "../../lib/pagination";

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrlFunc: (page: number) => string;
}

const { currentPage, totalPages, baseUrlFunc } = Astro.props;

// Набор страниц зависит от ширины, чтобы пагинация всегда была в одну строку (одни и те же ссылки, лишние скрыты CSS):
// телефон — 1 … 49 [50] 51 … 137 (при 1000+ страниц: 1 … [11] … 1962); md — ±2 и скачок ±10; lg — ещё ±100 (при 1000+ страниц соседей ±1).
const items = responsivePaginationItems(currentPage, totalPages);
---

<nav class="flex items-center justify-center gap-1 md:gap-2" aria-label="Пагинация">
  <a
    href={currentPage > 1 ? baseUrlFunc(currentPage - 1) : "#"}
    class:list={[
      "pressable focus-ring rounded-control flex h-10 w-9 shrink-0 items-center justify-center transition-colors duration-150 md:h-11 md:w-11",
      currentPage <= 1 ? "pointer-events-none opacity-30" : "text-text-secondary hover:bg-raised hover:text-text-main",
    ]}
    aria-disabled={currentPage <= 1}
  >
    <Icon name="lucide:chevron-left" class="h-5 w-5" />
  </a>

  <div class="flex min-w-0 flex-wrap items-center justify-center gap-1 md:gap-1.5">
    {
      items.map((it) =>
        it.page === null ? (
          <span class:list={["text-text-muted w-4 justify-center select-none", visibilityClass(it.levels)]} aria-hidden="true">
            …
          </span>
        ) : (
          <a
            href={baseUrlFunc(it.page)}
            class:list={[
              "pressable focus-ring rounded-control h-10 min-w-9 items-center justify-center px-1.5 text-sm font-medium tabular-nums transition-colors duration-150 md:h-11 md:min-w-11 md:px-3 md:text-base",
              visibilityClass(it.levels),
              currentPage === it.page ? "bg-brand text-on-brand font-semibold" : "text-text-secondary hover:bg-raised hover:text-text-main",
            ]}
            aria-current={currentPage === it.page ? "page" : undefined}
          >
            {it.page}
          </a>
        ),
      )
    }
  </div>

  <a
    href={currentPage < totalPages ? baseUrlFunc(currentPage + 1) : "#"}
    class:list={[
      "pressable focus-ring rounded-control flex h-10 w-9 shrink-0 items-center justify-center transition-colors duration-150 md:h-11 md:w-11",
      currentPage >= totalPages ? "pointer-events-none opacity-30" : "text-text-secondary hover:bg-raised hover:text-text-main",
    ]}
    aria-disabled={currentPage >= totalPages}
  >
    <Icon name="lucide:chevron-right" class="h-5 w-5" />
  </a>
</nav>
