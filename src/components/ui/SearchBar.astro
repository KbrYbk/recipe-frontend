---
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";

interface Props {
  /** Скрытые параметры, сохраняемые при поиске (фильтры каталога). */
  preserveParams?: Record<string, string>;
  initialQuery?: string;
  /** Куда отправлять форму (на странице категории — поиск внутри категории). */
  action?: string;
  /** Компактный вид: одна строка, кнопка-иконка (каталог). */
  compact?: boolean;
  placeholder?: string;
}

const { preserveParams = {}, initialQuery = "", action = "/recipes", compact = false, placeholder = "Курица, картошка, суп..." } = Astro.props;
const autofocus = Astro.url.searchParams.get("action") === "search";
---

<div class:list={["mx-auto", compact ? "w-full" : "max-w-3xl"]}>
  <form action={action} method="GET" role="search" class="flex flex-row gap-2">
    {Object.entries(preserveParams).map(([name, value]) => (value ? <input type="hidden" name={name} value={value} /> : null))}
    <div class="relative flex-1">
      <Icon
        name="lucide:search"
        class:list={["text-text-muted pointer-events-none absolute top-1/2 z-10 -translate-y-1/2 opacity-70", compact ? "left-4 h-5 w-5" : "left-4 h-5 w-5 md:left-5 md:h-6 md:w-6"]}
        aria-hidden="true"
      />
      <input
        type="search"
        name="q"
        value={initialQuery}
        placeholder={placeholder}
        maxlength="100"
        class:list={[
          "glass-border-3d bg-card-bg text-text-main placeholder:text-text-muted focus:ring-brand/45 rounded-control shadow-soft w-full transition-shadow duration-150 focus:ring-2 focus:outline-none",
          compact ? "py-3 pr-4 pl-11 text-base" : "py-3 pr-4 pl-11 text-base md:py-3.5 md:pl-14 md:text-lg",
        ]}
        aria-label="Поиск рецепта"
        autocomplete="off"
        autofocus={autofocus}
        data-search-suggest
        data-search-input
      />
    </div>

    {
      compact ? (
        <Button type="submit" class="h-12 shrink-0 px-4" aria-label="Найти">
          <Icon name="lucide:search" class="h-5 w-5 sm:hidden" aria-hidden="true" />
          <span class="hidden sm:inline">Найти</span>
        </Button>
      ) : (
        <Button type="submit" size="lg" class="shrink-0">
          Найти
        </Button>
      )
    }
  </form>
</div>
