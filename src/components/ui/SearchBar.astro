---
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";

interface Props {
  /** Скрытые параметры, сохраняемые при поиске (фильтры каталога). */
  preserveParams?: Record<string, string>;
  initialQuery?: string;
  /** Куда отправлять форму (на странице категории — поиск внутри категории). */
  action?: string;
  /** Компактный вид: одна строка, кнопка-иконка (каталог). */
  compact?: boolean;
  placeholder?: string;
}

const { preserveParams = {}, initialQuery = "", action = "/recipes", compact = false, placeholder = "Курица, картошка, суп..." } = Astro.props;
const autofocus = Astro.url.searchParams.get("action") === "search";
---

<div class:list={["mx-auto", compact ? "w-full" : "max-w-3xl"]}>
  <form action={action} method="GET" role="search" class:list={["flex gap-2", compact ? "flex-row" : "flex-col gap-4 sm:flex-row"]}>
    {Object.entries(preserveParams).map(([name, value]) => (value ? <input type="hidden" name={name} value={value} /> : null))}
    <div class="relative flex-1">
      <Icon
        name="lucide:search"
        class:list={["text-text-muted pointer-events-none absolute top-1/2 z-10 -translate-y-1/2 opacity-70", compact ? "left-4 h-5 w-5" : "left-5 h-6 w-6 md:left-6 md:h-7 md:w-7"]}
        aria-hidden="true"
      />
      <input
        type="search"
        name="q"
        value={initialQuery}
        placeholder={placeholder}
        maxlength="100"
        class:list={[
          "glass-border-3d bg-card-bg/60 text-text-main placeholder:text-text-muted focus:ring-brand/20 w-full rounded-2xl shadow-md shadow-black/15 backdrop-blur-md transition-all focus:ring-4 focus:outline-none",
          compact ? "py-3 pr-4 pl-11 text-base" : "py-4 pr-6 pl-14 text-lg md:py-5 md:pl-16 md:text-xl",
        ]}
        aria-label="Поиск рецепта"
        autocomplete="off"
        autofocus={autofocus}
      />
    </div>

    {
      compact ? (
        <Button type="submit" class="h-12 shrink-0 px-4" aria-label="Найти">
          <Icon name="lucide:search" class="h-5 w-5 sm:hidden" aria-hidden="true" />
          <span class="hidden sm:inline">Найти</span>
        </Button>
      ) : (
        <Button type="submit" size="lg" class="min-w-40">
          Найти
        </Button>
      )
    }
  </form>
</div>
