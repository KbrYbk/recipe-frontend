---
import { Icon } from "astro-icon/components";

interface Props {
  ingredients: string[];
}
const { ingredients } = Astro.props;
---

<aside class="lg:sticky lg:top-28 lg:col-span-1">
  <div class="rounded-[2rem] border border-slate-100 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h2 class="mb-6 flex items-center gap-2 text-2xl font-bold text-slate-900 dark:text-white">
      <Icon name="lucide:shopping-basket" class="h-6 w-6" />Ингредиенты
    </h2>
    <ul class="space-y-4">
      {
        (ingredients || []).map((item) => (
          <li class="flex items-center gap-3 border-b border-slate-50 pb-2 text-slate-700 last:border-0 dark:border-slate-800/50 dark:text-slate-300">
            <input type="checkbox" class="text-primary h-5 w-5 rounded border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
