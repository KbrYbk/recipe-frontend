---
import { Icon } from "astro-icon/components";

interface Props {
  ingredients: string[];
}
const { ingredients } = Astro.props;
---

<aside class="lg:sticky lg:top-28 lg:col-span-1">
  <div class="border-line bg-card-bg rounded-4xl border p-8 shadow-sm transition-shadow hover:shadow-md">
    <h2 class="text-text-main mb-6 flex items-center gap-2 text-2xl font-bold">
      <Icon name="lucide:shopping-basket" class="h-6 w-6" /> Ингредиенты
    </h2>
    <ul class="space-y-4">
      {
        (ingredients || []).map((item) => (
          <li class="border-line text-text-main flex items-start gap-3 border-b pb-3 last:border-0">
            <div class="flex h-6 items-center">
              <input type="checkbox" class="border-line bg-page-bg text-brand focus:ring-brand/20 h-5 w-5 cursor-pointer rounded transition-colors" />
            </div>
            <span class="text-base leading-tight md:text-lg">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
