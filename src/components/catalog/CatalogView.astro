---
/**
 * Общий каталог для `/recipes` и `/{категория}`: SEO, фильтры, сортировка, сетка, пагинация.
 * Данные загружает src/lib/api/catalog.ts (loadCatalog); статус ответа выставляет страница.
 */
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../layout/Breadcrumbs.astro";
import RecipeCard from "../RecipeCard.astro";
import SearchBar from "../ui/SearchBar.astro";
import Pagination from "../ui/Pagination.astro";
import Button from "../ui/Button.astro";
import Divider from "../ui/Divider.astro";
import AdSlot from "../shared/AdSlot.astro";
import MarketPromoCard from "../shared/MarketPromoCard.astro";
import {
  activeFilterCount,
  buildCatalogHref,
  catalogCanonical,
  DEFAULT_SORT,
  DIFFICULTY_OPTIONS,
  formatCount,
  hasActiveFilters,
  isPristineFirstPage,
  pluralRecipes,
  RATING_OPTIONS,
  SORT_OPTIONS,
  TIME_OPTIONS,
  type CatalogQuery,
} from "../../lib/catalog";
import type { Category } from "../../lib/categories";
import { CATEGORY_PROMOS } from "../../lib/promos";
import { listingNoindex, recipesSeo, sectionSeo } from "../../lib/seo";
import { buildItemListJsonLd, serializeJsonLd } from "../../lib/recipeSchema";
import { PER_PAGE } from "../../lib/api/map";
import type { RecipeList } from "../../types/recipe";
import type { Landing } from "../../lib/landings";

interface Props {
  basePath: string;
  query: CatalogQuery;
  result: RecipeList;
  categories: Category[];
  category: Category | null;
  /** Лендинг `/{slug}` (страница-подборка под запрос); category при этом null. */
  landing?: Landing | null;
}

const { basePath, query, result, categories, category, landing = null } = Astro.props;
// Раздел со своим SEO-контентом: категория или лендинг.
const section = category ?? landing;
const { list, total, totalPages } = result;
const page = query.page;
const href = (o: Parameters<typeof buildCatalogHref>[2]) => buildCatalogHref(basePath, query, o);

// --- SEO ---
const pageSuffix = page > 1 ? ` — страница ${page}` : "";
const countText = `${formatCount(total)} ${pluralRecipes(total)}`;
let h1: string;
let title: string;
let description: string;
if (query.q) {
  h1 = category ? `Поиск «${query.q}» в разделе «${category.title}»` : `Поиск: «${query.q}»`;
  title = `${h1}${pageSuffix} — SwagEda`;
  description = `Результаты поиска рецептов по запросу «${query.q}» на SwagEda.`;
  if (page > 1) description = `${description} Страница ${page}.`;
} else {
  // Категория: seo_title/seo_description/h1 из API, при их отсутствии — шаблоны (src/lib/seo.ts).
  ({ h1, title, description } = section ? sectionSeo(section, total, page) : recipesSeo(total, page));
}

const canonical = catalogCanonical(basePath, page);
// Фильтры/сортировка/поиск и страницы 2+ общего каталога — noindex,follow; пагинация категорий индексируется.
const noindex = listingNoindex(category ? "category" : landing ? "landing" : "recipes", Astro.url.searchParams, page);
const prevHref = page > 1 ? catalogCanonical(basePath, page - 1) : null;
const nextHref = page < totalPages ? catalogCanonical(basePath, page + 1) : null;

const breadcrumbs = category
  ? [
      { name: "Категории", href: "/categories" },
      { name: category.title, href: canonical },
    ]
  : landing
    ? [{ name: landing.title, href: canonical }]
    : [{ name: "Все рецепты", href: "/recipes" }];

const VISIBLE_CATEGORIES = 6;
const activeIndex = category ? categories.findIndex((c) => c.id === category.id) : -1;
// Активная категория всегда видна без раскрытия списка.
const visibleCategories = categories.slice(0, VISIBLE_CATEGORIES).concat(activeIndex >= VISIBLE_CATEGORIES ? [categories[activeIndex]] : []);
const hiddenCategories = categories.slice(VISIBLE_CATEGORIES).filter((c) => c.id !== category?.id);
const pluralCategories = (n: number) => {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return "категория";
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return "категории";
  return "категорий";
};
const categoryHref = (c: Category | null) => buildCatalogHref(c ? `/${c.path}` : "/recipes", query, {});

const promo = category ? CATEGORY_PROMOS[category.path] : undefined;

// Текст раздела (интро, FAQ) из API — только на чистой первой странице, чтобы не дублировать его на пагинации.
const showSectionText = !!section && isPristineFirstPage(query);
const intro = showSectionText ? (section?.intro ?? []) : [];
const faq = showSectionText ? (section?.faq ?? []) : [];
const sectionName = section?.title ?? "";
// ItemList карточек текущей страницы (у поиска не выводим — он noindex).
const origin = Astro.site?.origin ?? Astro.url.origin;
const itemListJsonLd = !query.q && list.length > 0 ? serializeJsonLd(buildItemListJsonLd(list, origin, (page - 1) * PER_PAGE, h1)) : "";
const faqJsonLd =
  faq.length > 0
    ? serializeJsonLd({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
      })
    : "";
const filtersCount = activeFilterCount(query);

const chip = (active: boolean) => (active ? "bg-brand/10! text-brand! ring-brand/30 ring-1" : "text-text-main font-medium");
const searchParams: Record<string, string> = {
  ...(query.sort !== DEFAULT_SORT ? { sort: query.sort } : {}),
  ...(query.difficulty ? { difficulty: query.difficulty } : {}),
  ...(query.maxTime !== null ? { maxTime: String(query.maxTime) } : {}),
  ...(query.minRating !== null ? { minRating: String(query.minRating) } : {}),
};
---

<Layout title={title} description={description} canonical={canonical} noindex={noindex}>
  <Fragment slot="head">
    {prevHref && !query.q && <link rel="prev" href={prevHref} />}
    {nextHref && !query.q && <link rel="next" href={nextHref} />}
    {itemListJsonLd && <script type="application/ld+json" is:inline set:html={itemListJsonLd} />}
    {faqJsonLd && <script type="application/ld+json" is:inline set:html={faqJsonLd} />}
  </Fragment>

  <div class="mx-auto max-w-6xl md:px-4">
    <header class="border-line mb-4 border-b pb-4 md:mb-10 md:pt-6 md:pb-10">
      <!-- Крошки видны и на мобильном: BreadcrumbList в JSON-LD должен совпадать с видимой навигацией -->
      <Breadcrumbs items={breadcrumbs} />
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between md:gap-6">
        <div class="min-w-0">
          <h1 class="text-text-main text-2xl leading-tight font-bold md:text-5xl">{h1}</h1>
          <p class="text-text-muted mt-1 text-sm md:mt-4 md:text-lg">
            {total > 0 ? (query.q ? `Найдено ${countText}` : countText) : "Рецептов не найдено"}
            {
              totalPages > 1 && (
                <span>
                  {" "}
                  · страница {page} из {totalPages}
                </span>
              )
            }
          </p>
        </div>
        <div class="w-full md:w-120 lg:w-xl">
          <SearchBar
            compact
            action={landing ? "/recipes" : basePath}
            initialQuery={query.q}
            preserveParams={landing ? {} : searchParams}
            placeholder={category ? `Искать в «${category.title}»` : undefined}
          />
        </div>
      </div>
    </header>

    {
      intro.length > 0 && (
        <div class="text-text-muted mb-6 max-w-4xl text-base leading-relaxed md:mb-8 md:text-lg" data-section-intro>
          <p>{intro[0]}</p>
        </div>
      )
    }

    <!-- Сортировка (горизонтальная прокрутка на мобильных) + кнопка фильтров на мобильных -->
    <div class="mb-4 flex items-center gap-2 md:mb-6">
      <button
        type="button"
        class="glass-border-3d bg-card-bg/40 text-text-main flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-xl px-3 text-sm font-semibold lg:hidden"
        aria-expanded="false"
        aria-controls="catalog-filters"
        data-filters-toggle
      >
        <Icon name="lucide:sliders-horizontal" class="h-4 w-4" aria-hidden="true" />
        Фильтры{filtersCount > 0 && <span class="bg-brand rounded-full px-1.5 text-xs text-white">{filtersCount}</span>}
      </button>
      <span class="text-text-muted hidden text-sm font-semibold lg:inline">Сортировка:</span>
      <nav class="-my-1 flex min-w-0 gap-2 overflow-x-auto py-1 [scrollbar-width:none]" aria-label="Сортировка">
        {
          SORT_OPTIONS.map((s) => (
            <Button
              href={href({ sort: s.value })}
              variant="outline"
              size="sm"
              class={`h-9 shrink-0 py-0! ${chip(query.sort === s.value)}`}
              aria-current={query.sort === s.value ? "true" : undefined}
              rel="nofollow"
            >
              {s.label}
            </Button>
          ))
        }
      </nav>
    </div>

    <div class="flex flex-col gap-6 lg:flex-row lg:gap-8">
      <aside id="catalog-filters" class="hidden w-full shrink-0 lg:block lg:w-72" data-filters-panel>
        <div class="glass-border-3d bg-card-bg/60 rounded-3xl p-5 shadow-xl shadow-black/15 backdrop-blur-md lg:p-6">
          <h2 class="text-text-main mb-4 flex items-center gap-2 text-xl font-bold lg:mb-6">
            <Icon name="lucide:filter" class="text-brand h-5 w-5" aria-hidden="true" />
            Фильтры
          </h2>

          <div class="space-y-6" role="region" aria-label="Фильтры рецептов">
            <div>
              <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Сложность</h3>
              <div class="flex flex-wrap gap-2">
                {
                  DIFFICULTY_OPTIONS.map((d) => (
                    <Button href={href({ difficulty: d.value })} variant="outline" size="sm" class={chip(query.difficulty === d.value)} rel="nofollow">
                      {d.label}
                    </Button>
                  ))
                }
              </div>
            </div>

            <div>
              <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Время</h3>
              <div class="flex flex-wrap gap-2">
                {
                  TIME_OPTIONS.map((t) => {
                    const active = String(query.maxTime) === t.value;
                    return (
                      <Button href={href({ maxTime: active ? null : Number(t.value), minTime: null })} variant="outline" size="sm" class={chip(active)} rel="nofollow">
                        {t.label}
                      </Button>
                    );
                  })
                }
              </div>
            </div>

            <div>
              <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Рейтинг</h3>
              <div class="flex flex-wrap gap-2">
                {
                  RATING_OPTIONS.map((r) => (
                    <Button
                      href={href({ minRating: r.value ? Number(r.value) : null })}
                      variant="outline"
                      size="sm"
                      class={chip(r.value ? String(query.minRating) === r.value : query.minRating === null)}
                      rel="nofollow"
                    >
                      {r.label}
                    </Button>
                  ))
                }
              </div>
            </div>

            {
              hasActiveFilters(query) && (
                <Button
                  variant="ghost"
                  size="sm"
                  fullWidth
                  href={href({ difficulty: null, maxTime: null, minTime: null, minRating: null })}
                  class="bg-rose-500/10! text-rose-500! transition-colors hover:bg-rose-500/20!"
                >
                  <Icon name="lucide:x" class="h-4 w-4" slot="icon-left" />
                  Сбросить фильтры
                </Button>
              )
            }
            <div class="border-line border-t pt-5">
              <h3 class="text-text-muted mb-3 text-sm font-semibold tracking-wider uppercase">Категории</h3>
              <ul class="space-y-1" role="list">
                <li>
                  <Button href={categoryHref(null)} variant="ghost" class={`w-full justify-start text-left ${!section ? "bg-brand/10! text-brand! font-bold" : "text-text-muted"}`}>Все</Button>
                </li>
                {
                  visibleCategories.map((c) => (
                    <li>
                      <Button
                        href={categoryHref(c)}
                        variant="ghost"
                        class={`w-full justify-start text-left whitespace-normal ${category?.id === c.id ? "bg-brand/10! text-brand! font-bold" : "text-text-muted"}`}
                        aria-current={category?.id === c.id ? "page" : undefined}
                      >
                        {c.title}
                      </Button>
                    </li>
                  ))
                }
              </ul>
              {
                hiddenCategories.length > 0 && (
                  <div class="mt-2">
                    <button
                      type="button"
                      class="text-text-muted hover:text-brand flex cursor-pointer items-center gap-1.5 px-3 py-2 text-sm font-medium transition-colors"
                      data-category-toggle
                      aria-expanded="false"
                    >
                      <Icon name="lucide:chevron-down" class="h-4 w-4 transition-transform" data-category-chevron aria-hidden="true" />
                      Ещё {hiddenCategories.length} {pluralCategories(hiddenCategories.length)}
                    </button>
                    <ul class="mt-2 hidden space-y-1" data-category-hidden>
                      {hiddenCategories.map((c) => (
                        <li>
                          <Button href={categoryHref(c)} variant="ghost" class="text-text-muted w-full justify-start text-left whitespace-normal">
                            {c.title}
                          </Button>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </aside>

      <div class="min-w-0 grow">
        {
          list.length > 0 ? (
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
              {list.map((recipe, index) => (
                <>
                  {index === 2 && (
                    <div class="min-w-0 md:col-span-2 print:hidden" data-ad-wrapper>
                      {promo ? <MarketPromoCard {...promo} /> : <AdSlot id="R-A-19056160-24" />}
                    </div>
                  )}
                  <RecipeCard recipe={recipe} priority={index === 0} />
                </>
              ))}
            </div>
          ) : (
            <div class="py-20 text-center">
              <Icon name="lucide:search-x" class="text-text-muted mx-auto mb-4 h-16 w-16 opacity-20" />
              <h2 class="text-text-main text-xl font-bold">Ничего не нашли</h2>
              <p class="text-text-muted mt-2">Попробуйте изменить запрос или фильтры</p>
              {(query.q || hasActiveFilters(query)) && (
                <a href={basePath} class="text-brand mt-6 inline-block font-semibold hover:underline">
                  Сбросить фильтры и поиск
                </a>
              )}
            </div>
          )
        }

        {
          totalPages > 1 && list.length > 0 && (
            <div class="mt-12">
              <Pagination currentPage={page} totalPages={totalPages} baseUrlFunc={(p) => href({ page: p })} />
            </div>
          )
        }

        {
          (intro.length > 1 || faq.length > 0) && (
            <section class="mt-12 max-w-4xl" aria-label={`О разделе «${sectionName}»`}>
              {intro.length > 1 && (
                <div class="text-text-muted space-y-4 text-base leading-relaxed md:text-lg">
                  <h2 class="text-text-main text-2xl font-bold">О разделе «{sectionName}»</h2>
                  {intro.slice(1).map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              )}
              {faq.length > 0 && (
                <div class="mt-10">
                  <h2 class="text-text-main mb-4 text-2xl font-bold">Частые вопросы</h2>
                  <div class="space-y-3">
                    {faq.map((f) => (
                      <details class="glass-border-3d bg-card-bg/60 group rounded-2xl px-5 py-4 shadow-sm shadow-black/15">
                        <summary class="text-text-main cursor-pointer list-none font-semibold">
                          <span class="flex items-center justify-between gap-4">
                            {f.q}
                            <Icon name="lucide:chevron-down" class="text-text-muted h-5 w-5 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
                          </span>
                        </summary>
                        <p class="text-text-muted mt-3 leading-relaxed">{f.a}</p>
                      </details>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )
        }
      </div>
    </div>

    <Divider>
      <h2 class="text-text-main mb-6 text-2xl font-bold">Популярные рецепты:</h2>
      <AdSlot id="R-A-19056160-14" isFeed={true} />
    </Divider>
  </div>
</Layout>

<script>
  function initCatalog() {
    const toggle = document.querySelector<HTMLElement>("[data-category-toggle]");
    const hidden = document.querySelector<HTMLElement>("[data-category-hidden]");
    const chevron = document.querySelector<HTMLElement>("[data-category-chevron]");
    toggle?.addEventListener("click", () => {
      const open = hidden?.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      if (chevron) chevron.style.transform = open ? "rotate(180deg)" : "";
    });

    const filtersToggle = document.querySelector<HTMLElement>("[data-filters-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-filters-panel]");
    filtersToggle?.addEventListener("click", () => {
      const open = panel?.classList.toggle("hidden") === false;
      filtersToggle.setAttribute("aria-expanded", String(open));
    });
  }
  initCatalog();

  // Рекламой управляет только Яндекс (RULES.md п.7): сайт не скрывает и не удаляет рекламные блоки.
</script>
