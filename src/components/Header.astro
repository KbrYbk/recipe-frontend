---
import { Icon } from "astro-icon/components";
---

<header class="border-line bg-card-bg/80 sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="text-brand flex items-center gap-2 text-3xl font-bold md:text-4xl" aria-label="Главная страница Рецепты Дома">
      <Icon name="lucide:cooking-pot" class="h-8 w-8" aria-hidden="true" /> Рецепты Дома
    </a>
    <nav class="hidden items-center gap-8 md:flex">
      <a href="/recipes" class="hover:text-brand font-medium transition-colors">Рецепты</a>
      <a href="/recipes" class="hover:text-brand font-medium transition-colors">Каталог</a>
      <div class="bg-line h-6 w-px"></div>
      <button
        type="button"
        id="themeToggle"
        class="bg-page-bg border-line text-text-main hover:border-brand hover:text-brand flex h-10 w-10 items-center justify-center rounded-xl border transition-all active:scale-95"
        aria-label="Переключить тему"
        aria-pressed="false"
      >
        <Icon name="lucide:moon" class="theme-icon-moon h-5 w-5" aria-hidden="true" />
        <Icon name="lucide:sun" class="theme-icon-sun h-5 w-5" aria-hidden="true" />
      </button>
    </nav>
  </div>
</header>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById("themeToggle");
    if (!btn || btn.dataset.themeBound === "1") return;
    btn.dataset.themeBound = "1";

    const syncPressed = () => {
      const dark = document.documentElement.classList.contains("dark");
      btn.setAttribute("aria-pressed", dark ? "true" : "false");
    };
    syncPressed();

    btn.addEventListener("click", () => {
      document.documentElement.classList.toggle("dark");
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      btn.setAttribute("aria-pressed", isDark ? "true" : "false");
    });
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
