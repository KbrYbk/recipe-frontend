---
---
<header class="py-6 border-b border-slate-200 mb-8">
  <nav class="flex justify-between items-center">
    <a href="/" class="text-2xl font-bold text-orange-600 hover:text-orange-700 focus:outline-double outline-offset-4" aria-label="Главная страница Кулинария">
      🥗 РецептыДома
    </a>

    <div class="flex-1 max-w-md mx-8 hidden sm:block">
      <form action="/search" method="GET" class="relative">
        <label for="recipe-search" class="sr-only">Поиск рецептов</label>
        <input 
          type="search" 
          id="recipe-search" 
          name="q"
          placeholder="Что приготовим сегодня?" 
          class="w-full pl-4 pr-10 py-3 border-2 border-slate-300 rounded-lg focus:border-orange-500 text-lg transition-all"
        />
        <button type="submit" class="absolute right-3 top-3" aria-label="Найти">
          🔍
        </button>
      </form>
    </div>

    <button class="bg-orange-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-orange-700 transition-colors shadow-lg active:scale-95">
      Войти
    </button>
  </nav>
</header>