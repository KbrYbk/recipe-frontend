# Все значения читаются в РАНТАЙМЕ сервера (process.env), в сборку не попадают.
# На проде файл лежит в /var/www/swageda/frontend/shared/.env и подключается через `node --env-file` (см. ecosystem.config.cjs).

# Базовый URL Laravel API (без /api на конце; используется для SSR и /api-proxy)
API_BASE_URL=

# Origin, откуда отдаются картинки (/api-images/* → IMAGE_BASE_URL/*). Если пусто — берётся API_BASE_URL
IMAGE_BASE_URL=

# Секретный ключ проекта (заголовок X-Project-Key). Никогда не префиксовать PUBLIC_
PROJECT_KEY=

# Задаются в ecosystem.config.cjs (pm2):
# HOST=127.0.0.1
# PORT=4321
