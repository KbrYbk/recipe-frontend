# URL Laravel API без завершающего слэша
API_BASE_URL=http://127.0.0.1:8000

# URL Laravel API для клиентского кода (нужен PUBLIC_ префикс)
PUBLIC_API_CLIENT_URL=http://127.0.0.1:8000

# Секрет для заголовка X-Project-Key-ass (только SSR; не префикс VITE_)
PROJECT_KEY=

# База для относительных путей картинок с бэка (без слэша в конце)
IMAGE_BASE_URL=

# Внешний origin картинок для /api-images/* (скрывается от клиента)
# Пример: https://images.example.com
IMAGE_ORIGIN=

# Список URL бэкенда через запятую (для работы с несколькими)
PUBLIC_BACKEND_URLS=,
